; Top-level config — IDE search stops here.
root = true

#####################################
# Whitespace / line endings (all)
#####################################
[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,js,ts,yml,yaml}]
indent_size = 2

[*.{xml,axaml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false  ; markdown uses trailing 2-space for line breaks

#####################################
# C# style — kept advisory (severity=suggestion).
# Tighten to "warning" once `dotnet format` has been run on the codebase.
#####################################
[*.cs]
# var preferences — codebase mixes both, so don't auto-rewrite either way.
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent

# Modern C# features the codebase already leans on.
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_diagnostic.IDE0160.severity = suggestion
dotnet_diagnostic.IDE0161.severity = suggestion
dotnet_diagnostic.EnableGenerateDocumentationFile.severity = none
csharp_style_prefer_primary_constructors = false:silent
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_static_local_function = true:suggestion

# Expression-bodied members — codebase uses both forms; leave to author judgment.
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion

# Using directives.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion

# Nullable
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# Naming — minimal: private fields _camelCase, constants UPPER_CASE optional.
dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# New-line rules
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Spaces — match dotnet defaults
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_around_binary_operators = before_and_after

#####################################
# Analyzer overrides (advisory only)
#####################################
# IDE0058: Expression value is never used. Codebase has many fire-and-forget calls that
# legitimately ignore the returned Task; turn this off so the build doesn't get noisy.
dotnet_diagnostic.IDE0058.severity = none

# IDE0028 / IDE0090: collection expression / target-typed new — suggestions only.
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0090.severity = suggestion

# IDE0007: prefer var. Off because of the mixed style above.
dotnet_diagnostic.IDE0007.severity = none

# IDE0008: prefer explicit type — same.
dotnet_diagnostic.IDE0008.severity = none

# CA1416: platform compatibility (Windows-only build target).
# Project pins net10.0-windows, so all CA1416 noise is by design.
dotnet_diagnostic.CA1416.severity = none

# IDE0005: Remove unnecessary using directives.
dotnet_diagnostic.IDE0005.severity = warning

# Unused / dead code diagnostics
# IDE0051: Remove unused private members
dotnet_diagnostic.IDE0051.severity = warning

# IDE0052: Remove unread private members
dotnet_diagnostic.IDE0052.severity = warning

# IDE0059: Unnecessary assignment of a value
dotnet_diagnostic.IDE0059.severity = warning

# CA1812: Avoid uninstantiated internal classes
dotnet_diagnostic.CA1812.severity = warning

# CA1823: Avoid unused private fields
dotnet_diagnostic.CA1823.severity = warning

#####################################
# Static Analysis Noise Filters (SonarAnalyzer & Meziantou)
#####################################
# Category 1: Desktop / Modern C# False Positives
# S1075: Hardcoded URIs (avares:// and http://127.0.0.1 loopback for TorrServer are standard in Avalonia)
dotnet_diagnostic.S1075.severity = none
# S3881: Dispose(bool disposing) boilerplate is obsolete for classes without unmanaged handles/finalizers
dotnet_diagnostic.S3881.severity = none
# MA0002: Requiring StringComparer on every HashSet/OrderBy is redundant in Ordinal-default code
dotnet_diagnostic.MA0002.severity = none
# S3358: Nested ternary operators are preferred in concise property mappers over bloated if/else
dotnet_diagnostic.S3358.severity = none
# MA0046: Obsolete WinForms-era 2-parameter event delegate requirement
dotnet_diagnostic.MA0046.severity = none
# S4200: Native P/Invoke methods in LibMpvNative interop module
dotnet_diagnostic.S4200.severity = none
# MA0004: ConfigureAwait(false) is counter-productive in Avalonia UI desktop apps
dotnet_diagnostic.MA0004.severity = none
# MA0048: Interop/PInvoke native structs co-located in native wrapper files
dotnet_diagnostic.MA0048.severity = none
# MA0051: Method length limit (60 lines) — project follows Goldilocks Zone (150-400 lines per file)
dotnet_diagnostic.MA0051.severity = none

# Category 2: Advisory Style Noise (Suppressed to keep build logs high-signal)
# S2325: Make method static if not reading instance fields (interferes with service contracts and lifecycle)
dotnet_diagnostic.S2325.severity = none
# S1066: Merge nested if statements
dotnet_diagnostic.S1066.severity = none
# S3267: Loops should be simplified to LINQ (often slower / adds iterator allocations in hot paths)
dotnet_diagnostic.S3267.severity = none
# S108 / S2486: Empty catch/finally blocks (frequent in cleanup, tests, and mock handlers)
dotnet_diagnostic.S108.severity = none
dotnet_diagnostic.S2486.severity = none
# S1450: Field can be local variable
dotnet_diagnostic.S1450.severity = none
# MA0023: RegexOptions.ExplicitCapture requirement
dotnet_diagnostic.MA0023.severity = none
# MA0016: Prefer collection abstraction over implementation
dotnet_diagnostic.MA0016.severity = none
# MA0011: ToString(IFormatProvider)
dotnet_diagnostic.MA0011.severity = none
# MA0006: string.Equals instead of == / !=
dotnet_diagnostic.MA0006.severity = none
# S6640: Unsafe code block (required for native libmpv OpenGL buffer blitting)
dotnet_diagnostic.S6640.severity = none
# S5332: Using http protocol is insecure (used strictly for loopback TorrServer communication)
dotnet_diagnostic.S5332.severity = none
# S3220: Partial overload match in tests / Moq
dotnet_diagnostic.S3220.severity = none
# MA0008: Add StructLayoutAttribute on structs/records is unnecessary boilerplate
dotnet_diagnostic.MA0008.severity = none
# S101: EF Core migration classes start with underscore by convention
dotnet_diagnostic.S101.severity = none
# S6418: Public tracker OAuth client secrets are public by design
dotnet_diagnostic.S6418.severity = none
# S4144: Methods with identical implementation (common in MVVM change notification callbacks)
dotnet_diagnostic.S4144.severity = none
# S6618: string.Create instead of FormattableString is extreme micro-optimization
dotnet_diagnostic.S6618.severity = none
# S3604: Redundant field initializers are defensive and preferred in ViewModels
dotnet_diagnostic.S3604.severity = none
# S3218: Inner class member shadows outer class member
dotnet_diagnostic.S3218.severity = none
# MA0147: Async void is required for UI event handler delegates
dotnet_diagnostic.MA0147.severity = none
# MA0134: Observe result of async calls (intentional fire-and-forget discards)
dotnet_diagnostic.MA0134.severity = none
# MA0091: Sender parameter should be 'this' for instance events
dotnet_diagnostic.MA0091.severity = none
# MA0055: Finalizers in native interop wrappers (libmpv fallback)
dotnet_diagnostic.MA0055.severity = none
# S2094: Empty classes (used for marker types / records)
dotnet_diagnostic.S2094.severity = none
# S3963: Static field initialization order in static constructors
dotnet_diagnostic.S3963.severity = none


