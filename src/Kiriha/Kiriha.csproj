<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- Nullable warnings (CS8600..CS8625) become errors. The build is currently clean,
         and we want it to stay clean: silent regressions in null-safety are a top
         source of NREs that bubble up as user-visible crashes. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Kiriha</AssemblyName>
    <RootNamespace>Kiriha</RootNamespace>
    <Title>Kiriha</Title>
    <ApplicationIcon>Assets\kiriha.ico</ApplicationIcon>
    <Version>1.3.19</Version>


    <!-- Optimization: Ahead-of-time compilation for faster startup -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove="Kiriha.Core\**" />
    <EmbeddedResource Remove="Kiriha.Core\**" />
    <None Remove="Kiriha.Core\**" />
    <Compile Remove="Kiriha.Core.*\**" />
    <EmbeddedResource Remove="Kiriha.Core.*\**" />
    <None Remove="Kiriha.Core.*\**" />
    <Compile Remove="Kiriha.Data\**" />
    <EmbeddedResource Remove="Kiriha.Data\**" />
    <None Remove="Kiriha.Data\**" />
  </ItemGroup>

  <!-- Package versions live in Directory.Packages.props (CPM). -->
  <ItemGroup>
    <PackageReference Include="AsyncImageLoader.Avalonia" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="DiscordRichPresence" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Material.Icons.Avalonia" />

    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="apikeys.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="..\..\subprojects\mpv\**\*" Link="mpv\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kiriha.Infrastructure\Kiriha.Infrastructure.csproj" />
    <ProjectReference Include="..\Kiriha.Data\Kiriha.Data.csproj" />
    <ProjectReference Include="..\Kiriha.Core.Abstractions\Kiriha.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Kiriha.Core.Tracking\Kiriha.Core.Tracking.csproj" />
    <ProjectReference Include="..\Kiriha.Core.Domain\Kiriha.Core.Domain.csproj" />
    
    <ProjectReference Include="..\Kiriha.Mpv\Kiriha.Mpv.csproj" />
    <ProjectReference Include="..\Kiriha.Mpv.UI\Kiriha.Mpv.UI.csproj" />
  </ItemGroup>

  <Target Name="DownloadMpv" BeforeTargets="BeforeBuild;AssignTargetPaths" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\..\scripts\download-mpv.ps1&quot;" Condition="!Exists('$(ProjectDir)..\..\subprojects\mpv\libmpv-2.dll')" />
    <ItemGroup>
      <_MpvFiles Include="..\..\subprojects\mpv\**\*" />
      <Content Include="@(_MpvFiles)" Link="mpv\%(RecursiveDir)%(Filename)%(Extension)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
