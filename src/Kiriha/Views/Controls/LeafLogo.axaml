<UserControl
    x:Class="Kiriha.Views.Controls.LeafLogo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kiriha.Views.Controls"
    x:Name="Root"
    x:DataType="controls:LeafLogo"
    Focusable="False"
    IsHitTestVisible="False">

    <!--
        Растровый талисман Kiriha, с тема-зависимым хало и мягкой тенью.
        Padding оставляет место для BlurEffect/DropShadow, чтобы их не клипало
        внешним контейнером.
    -->
    <Grid Margin="0" ClipToBounds="False">
        <!--  Акцентный halo сзади (реагирует на тему через SystemAccentColor)  -->
        <Ellipse
            Margin="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="{Binding #Root.ShowHalo}"
            Opacity="0.35">
            <Ellipse.Fill>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.55" RadiusY="0.55">
                    <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight2}" />
                    <GradientStop Offset="0.6" Color="{DynamicResource SystemAccentColor}" />
                    <GradientStop Offset="1" Color="#00000000" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="18" />
            </Ellipse.Effect>
        </Ellipse>

        <!--  Талисман с мягкой тенью. Margin резервирует место под размытие.  -->
        <Image
            Margin="8"
            RenderOptions.BitmapInterpolationMode="HighQuality"
            Source="avares://Kiriha/Assets/kiriha.png"
            Stretch="Uniform">
            <Image.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    OffsetX="0"
                    OffsetY="2"
                    Opacity="0.22"
                    Color="Black" />
            </Image.Effect>
        </Image>
    </Grid>
</UserControl>
