<UserControl
    x:Class="Kiriha.Views.Controls.Variants.NowPlayingCompact"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kiriha.Views.Controls"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:sections="using:Kiriha.Views.Controls.Variants.NowPlayingCompactSections"
    xmlns:u="using:Kiriha.Utils.UI"
    xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
    x:Name="Root"
    x:DataType="vmNowPlaying:NowPlayingViewModel">



    <UserControl.Styles>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.Value">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.Section">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="TextBlock.SectionHead">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!--  Underline-style tabs integrated into the card header  -->
        <Style Selector="RadioButton.Tab">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        Cursor="Hand">
                        <Grid
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            RowDefinitions="*,2">
                            <ContentPresenter
                                Name="PART_Content"
                                Grid.Row="0"
                                Margin="0,12,0,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                            <Rectangle
                                Name="PART_Indicator"
                                Grid.Row="1"
                                Height="2"
                                HorizontalAlignment="Stretch"
                                Fill="Transparent"
                                RadiusX="1"
                                RadiusY="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.Tab:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="RadioButton.Tab:checked">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="RadioButton.Tab:checked /template/ Rectangle#PART_Indicator">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}" />
        </Style>

    </UserControl.Styles>

    <Panel>
        <!--  Empty  -->
        <controls:DetectionStatusView Margin="32,24,32,32" IsVisible="{Binding !IsMediaDetected}" />

        <!--  Detected  -->
        <Grid
            Margin="0,12,0,0"
            IsVisible="{Binding IsMediaDetected}"
            RowDefinitions="Auto,*">

            <!--  PLAYER BAR (sticky, styled like AnimeDetails hero)  -->
            <sections:NowPlayingCompactHeader Grid.Row="0" />
            <!--  SCROLLABLE CONTENT  -->
            <ScrollViewer
                Grid.Row="1"
                Margin="0,18,0,0"
                u:SmoothScroll.IsEnabled="True"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,24,40" Spacing="18">

                    <!--  Add to list  -->
                    <Border
                        Padding="14,10"
                        Background="#20f1c40f"
                        BorderBrush="#60f1c40f"
                        BorderThickness="1"
                        CornerRadius="10"
                        IsVisible="{Binding IsNotInList}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <material:MaterialIcon
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="#f1c40f"
                                Kind="AlertCircleOutline" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{DynamicResource l.anime.list_actions.not_in_my_list}" />
                            <Button
                                Grid.Column="2"
                                Padding="14,6"
                                Background="{DynamicResource SystemAccentColor}"
                                BorderThickness="0"
                                Command="{Binding AddToWatchingCommand}"
                                CornerRadius="6"
                                Foreground="White">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <material:MaterialIcon
                                        Width="14"
                                        Height="14"
                                        Kind="Play" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{DynamicResource l.anime.status.watching}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!--  Manual match: collapsed CTA  -->
                    <sections:NowPlayingCompactManualMatch />
                    <!--  Info card with tab switcher: Details / Synopsis / Alt titles  -->
                    <sections:NowPlayingCompactInfo />
                    <!--  Detection raw info  -->
                    <Border Classes="Section">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="SectionHead" Text="{DynamicResource l.scrobbler.status.detection_info}" />
                            <TextBlock
                                FontSize="11"
                                FontStyle="Italic"
                                Opacity="0.6"
                                Text="{Binding CurrentMedia.OriginalTitle}"
                                TextWrapping="Wrap" />
                            <!--  Player + mapping info  -->
                            <StackPanel
                                Margin="0,6,0,0"
                                Orientation="Horizontal"
                                Spacing="14">
                                <StackPanel
                                    IsVisible="{Binding CurrentMedia.ProcessName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <material:MaterialIcon
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Kind="Monitor"
                                        Opacity="0.4" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Opacity="0.4"
                                        Text="{DynamicResource l.scrobbler.status.player}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Opacity="0.6"
                                        Text="{Binding CurrentMedia.ProcessName}" />
                                </StackPanel>
                                <StackPanel
                                    IsVisible="{Binding MatchedAnime, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Opacity="0.4"
                                        Text="{DynamicResource l.scrobbler.status.mapped_by}" />
                                    <StackPanel
                                        IsVisible="{Binding !IsManuallyMapped}"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Opacity="0.5"
                                            Text="{DynamicResource l.scrobbler.status.mapped_auto}" />
                                        <Button
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding UnlinkMatchCommand}"
                                            Foreground="{DynamicResource SystemAccentColor}">
                                            <TextBlock
                                                FontSize="10"
                                                Text="{DynamicResource l.scrobbler.status.delete_mapping}"
                                                TextDecorations="Underline" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel
                                        IsVisible="{Binding IsManuallyMapped}"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Opacity="0.6"
                                            Text="{DynamicResource l.scrobbler.status.mapped_manual}" />
                                        <Button
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding UnlinkMatchCommand}"
                                            Foreground="{DynamicResource SystemAccentColor}">
                                            <TextBlock
                                                FontSize="10"
                                                Text="{DynamicResource l.scrobbler.status.delete_mapping}"
                                                TextDecorations="Underline" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>

