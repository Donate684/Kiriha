<UserControl
    x:Class="Kiriha.Views.Controls.Variants.NowPlayingCompactSections.NowPlayingCompactManualMatch"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:entities="using:Kiriha.Core.Domain.Models.Entities"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
    x:Name="Root"
    x:DataType="vmNowPlaying:NowPlayingViewModel">

    <UserControl.Resources>
        <conv:LocConverter x:Key="LocConverter" />
        <conv:IntToBooleanConverter x:Key="IntToBoolConverter" />
    </UserControl.Resources>

    <StackPanel>
        <Border Padding="20,18" Classes="Section">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Converter="{x:Static ObjectConverters.IsNull}" Path="MatchedAnime" />
                    <Binding Path="!IsSearchPanelOpen" />
                </MultiBinding>
            </Border.IsVisible>
            <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                <!--  Icon badge  -->
                <Border
                    Grid.Column="0"
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillColorSecondary}"
                    CornerRadius="22">
                    <material:MaterialIcon
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Kind="HelpCircleOutline" />
                </Border>

                <!--  Text  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="14,0,14,0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource l.scrobbler.matching.not_matched_title}" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.65"
                        Text="{DynamicResource l.scrobbler.matching.not_matched_desc}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Action button  -->
                <Button
                    Grid.Column="2"
                    Padding="16,9"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemAccentColor}"
                    BorderThickness="0"
                    Command="{Binding OpenSearchPanelCommand}"
                    CornerRadius="8"
                    Cursor="Hand"
                    Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            Kind="Magnify" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{DynamicResource l.scrobbler.matching.find_manually}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  ═══════ Manual match: expanded search panel ═══════  -->
        <Border Classes="Section">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Converter="{x:Static ObjectConverters.IsNull}" Path="MatchedAnime" />
                    <Binding Path="IsSearchPanelOpen" />
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel Spacing="14">
                <!--  Header with close button  -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        Classes="SectionHead"
                        Text="{DynamicResource l.scrobbler.matching.maybe_watching}" />
                    <Button
                        Grid.Column="1"
                        Padding="6"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CloseSearchPanelCommand}"
                        CornerRadius="6"
                        Cursor="Hand"
                        ToolTip.Tip="{DynamicResource l.scrobbler.matching.close}">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            Kind="Close"
                            Opacity="0.65" />
                    </Button>
                </Grid>

                <!--  Search box  -->
                <Border
                    Padding="4,2"
                    Background="{DynamicResource SubtleFillColorSecondary}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <TextBox
                        Height="40"
                        Padding="12,0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        PlaceholderText="{DynamicResource l.scrobbler.matching.search_placeholder}"
                        Text="{Binding SearchQuery}">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding SearchSuggestionsCommand}" Gesture="Enter" />
                        </TextBox.KeyBindings>
                        <TextBox.InnerRightContent>
                            <Button
                                Padding="8,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding SearchSuggestionsCommand}">
                                <material:MaterialIcon
                                    Width="20"
                                    Height="20"
                                    Foreground="{DynamicResource SystemAccentColor}"
                                    Kind="Magnify" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </Border>

                <ProgressBar
                    Height="2"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsSearching}" />

                <!--  Empty state  -->
                <StackPanel
                    Margin="0,18,0,18"
                    HorizontalAlignment="Center"
                    Spacing="6">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!HasSuggestions" />
                            <Binding Path="!IsSearching" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <material:MaterialIcon
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        Kind="MagnifyScan"
                        Opacity="0.3" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Opacity="0.55"
                        Text="{DynamicResource l.scrobbler.matching.no_suggestions}" />
                </StackPanel>

                <!--  Suggestions grid  -->
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="Button.Card">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="RenderTransform" Value="scale(1.0)" />
                            <Setter Property="Transitions">
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Button.Card:pointerover">
                            <Setter Property="RenderTransform" Value="scale(1.04)" />
                        </Style>
                        <Style Selector="Button.Card /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="Button.Card:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="Button.Card:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="entities:AnimeEntity">
                            <Button
                                Width="380"
                                Margin="0,0,10,10"
                                Classes="Card"
                                Command="{Binding #Root.((vmNowPlaying:NowPlayingViewModel)DataContext).SelectSuggestionCommand}"
                                CommandParameter="{Binding}">
                                <Border
                                    Padding="10"
                                    Background="{DynamicResource CardBackgroundFillDefault}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Grid Height="110" ColumnDefinitions="80,*">
                                        <!--  Poster  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="75"
                                            Height="110"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#222222"
                                            ClipToBounds="True"
                                            CornerRadius="6">
                                            <asyncImageLoader:AdvancedImage Source="{Binding MainPictureUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <!--  Content  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Top"
                                            Spacing="4">
                                            <!--  Title + score  -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    LineHeight="17"
                                                    MaxLines="2"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="8,2,0,0"
                                                    VerticalAlignment="Top"
                                                    Orientation="Horizontal"
                                                    Spacing="3">
                                                    <material:MaterialIcon
                                                        Width="11"
                                                        Height="11"
                                                        VerticalAlignment="Center"
                                                        Foreground="Gold"
                                                        Kind="Star" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding MeanScore}" />
                                                </StackPanel>
                                            </Grid>

                                            <!--  English alt title  -->
                                            <TextBlock
                                                FontSize="11"
                                                FontStyle="Italic"
                                                IsVisible="{Binding EnglishTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                MaxLines="1"
                                                Opacity="0.55"
                                                Text="{Binding EnglishTitle}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!--  Meta row: year · type · episodes  -->
                                            <StackPanel
                                                Margin="0,2,0,0"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <StackPanel
                                                    IsVisible="{Binding StartYear, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <material:MaterialIcon
                                                        Width="11"
                                                        Height="11"
                                                        VerticalAlignment="Center"
                                                        Kind="CalendarBlankOutline"
                                                        Opacity="0.55" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.8"
                                                        Text="{Binding StartYear}" />
                                                </StackPanel>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    IsVisible="{Binding StartYear, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Opacity="0.35"
                                                    Text="·" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Opacity="0.8"
                                                    Text="{Binding Type, Converter={StaticResource LocConverter}}" />
                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding TotalEpisodes, Converter={StaticResource IntToBoolConverter}}"
                                                    Orientation="Horizontal"
                                                    Spacing="3">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.35"
                                                        Text="·" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.8"
                                                        Text="{Binding TotalEpisodes}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Opacity="0.55"
                                                        Text="{DynamicResource l.anime.labels.ep_abbr}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!--  Genre chips  -->
                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Presentation.TopGenres}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border
                                                            Margin="0,0,4,4"
                                                            Padding="6,1"
                                                            Background="{DynamicResource SubtleFillColorSecondary}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Opacity="0.85"
                                                                Text="{Binding Converter={StaticResource LocConverter}}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>

