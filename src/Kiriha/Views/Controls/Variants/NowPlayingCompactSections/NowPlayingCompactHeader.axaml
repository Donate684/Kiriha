<UserControl
    x:Class="Kiriha.Views.Controls.Variants.NowPlayingCompactSections.NowPlayingCompactHeader"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
    xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
    x:DataType="vmNowPlaying:NowPlayingViewModel">

    <UserControl.Resources>
        <conv:LocConverter x:Key="LocConverter" />
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter" />
    </UserControl.Resources>

    <Border
        Margin="32,0,24,0"
        Padding="18,14"
        ClipToBounds="True"
        CornerRadius="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="{DynamicResource SystemAccentColor}" />
                <GradientStop Offset="0.6" Color="{DynamicResource SystemAccentColorDark1}" />
                <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark2}" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
            <!--  Poster  -->
            <Border
                Grid.Column="0"
                Width="100"
                Height="140"
                BoxShadow="0 4 20 0 #60000000"
                ClipToBounds="True"
                CornerRadius="8">
                <Panel>
                    <asyncImageLoader:AdvancedImage
                        IsVisible="{Binding MatchedAnime, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Source="{Binding MatchedAnime.PosterSource}"
                        Stretch="UniformToFill" />
                    <Border Background="#22000000" IsVisible="{Binding MatchedAnime, Converter={x:Static ObjectConverters.IsNull}}">
                        <material:MaterialIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="ImageOutline"
                            Opacity="0.3" />
                    </Border>
                </Panel>
            </Border>

            <!--  Title / meta  -->
            <StackPanel
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                Spacing="3">
                <!--  Top line: live status  -->
                <StackPanel
                    Margin="0,0,0,2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="#20FFFFFF"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <material:MaterialIcon
                                Width="11"
                                Height="11"
                                Foreground="White"
                                IsVisible="{Binding !IsPaused}"
                                Kind="Play" />
                            <material:MaterialIcon
                                Width="11"
                                Height="11"
                                Foreground="White"
                                IsVisible="{Binding IsPaused}"
                                Kind="Pause" />
                            <TextBlock
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding DisplayStatus}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Main title (Japanese / Romaji like in cards and details)  -->
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    IsVisible="{Binding MatchedAnime, Converter={x:Static ObjectConverters.IsNotNull}}"
                    LineHeight="30"
                    Text="{Binding MatchedAnime.Presentation.RomajiTitle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    IsVisible="{Binding MatchedAnime, Converter={x:Static ObjectConverters.IsNull}}"
                    LineHeight="28"
                    Text="{Binding CurrentMedia.AnimeTitle}"
                    TextWrapping="Wrap" />

                <!--  Secondary title (Russian)  -->
                <TextBlock
                    FontSize="13"
                    Foreground="#90FFFFFF"
                    IsVisible="{Binding MatchedAnime.Presentation.HasSecondaryTitle}"
                    Text="{Binding MatchedAnime.Presentation.SecondaryTitle}"
                    TextWrapping="Wrap" />

                <!--  Metadata row with dividers (AnimeDetails hero style)  -->
                <StackPanel
                    Margin="0,5,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--  Episode  -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <material:MaterialIcon
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="#B0FFFFFF"
                            Kind="PlayCircleOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#D0FFFFFF">
                            <Run Text="{DynamicResource l.anime.labels.episode}" />
                            <Run Text=" " />
                            <Run
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding DisplayEpisodeNumber}" />
                            <Run Text="{DynamicResource l.anime.labels.of}" />
                            <Run Text="{Binding MatchedAnime.TotalEpisodes}" />
                        </TextBlock>
                    </StackPanel>

                    <!--  Type  -->
                    <Border
                        Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        Background="#40FFFFFF"
                        IsVisible="{Binding MatchedAnime, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel
                        IsVisible="{Binding MatchedAnime, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Orientation="Horizontal"
                        Spacing="4">
                        <material:MaterialIcon
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="#80FFFFFF"
                            Kind="Television" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#B0FFFFFF"
                            Text="{Binding MatchedAnime.Type, Converter={StaticResource LocConverter}}" />
                    </StackPanel>

                    <!--  Score  -->
                    <Border
                        Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        Background="#40FFFFFF"
                        IsVisible="{Binding MatchedAnime.MeanScore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel
                        IsVisible="{Binding MatchedAnime.MeanScore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Orientation="Horizontal"
                        Spacing="4">
                        <material:MaterialIcon
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="Gold"
                            Kind="Star" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding MatchedAnime.MeanScore}" />
                    </StackPanel>
                </StackPanel>

                <!--  Action chips (AnimeDetails style)  -->
                <StackPanel
                    Margin="0,6,0,0"
                    IsVisible="{Binding MatchedAnime, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Orientation="Horizontal"
                    Spacing="5">
                    <Border
                        Width="28"
                        Height="28"
                        Background="#20FFFFFF"
                        CornerRadius="6"
                        ToolTip.Tip="{DynamicResource l.anime.links.mal}">
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#35FFFFFF" />
                            </Style>
                        </Border.Styles>
                        <Button
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Command="{Binding OpenMalLinkCommand}"
                            CornerRadius="6">
                            <Image
                                Width="16"
                                Height="16"
                                Opacity="0.9"
                                Source="/Assets/myanimelist_white.png" />
                        </Button>
                    </Border>
                    <Border
                        Width="28"
                        Height="28"
                        Background="#20FFFFFF"
                        CornerRadius="6"
                        ToolTip.Tip="{DynamicResource l.anime.links.shiki}">
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#35FFFFFF" />
                            </Style>
                        </Border.Styles>
                        <Button
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Command="{Binding OpenShikiLinkCommand}"
                            CornerRadius="6">
                            <Image
                                Width="16"
                                Height="16"
                                Opacity="0.9"
                                Source="/Assets/shikimori_white.png" />
                        </Button>
                    </Border>
                    <!--  User-defined share buttons.  -->
                    <ItemsControl ItemsSource="{Binding CustomShareLinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmSettings:CustomShareLinkRuntime">
                                <Border
                                    Width="28"
                                    Height="28"
                                    Background="#20FFFFFF"
                                    CornerRadius="6"
                                    ToolTip.Tip="{Binding Name}">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="#35FFFFFF" />
                                        </Style>
                                    </Border.Styles>
                                    <Button
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Command="{Binding OpenCommand}"
                                        CornerRadius="6">
                                        <Panel>
                                            <material:MaterialIcon
                                                Width="16"
                                                Height="16"
                                                Foreground="#CCFFFFFF"
                                                IsVisible="{Binding UseIconKind}"
                                                Kind="{Binding IconKind}" />
                                            <Image
                                                Width="18"
                                                Height="18"
                                                IsVisible="{Binding HasIconImage}"
                                                Source="{Binding IconPath, Converter={StaticResource FilePathToBitmapConverter}}"
                                                Stretch="UniformToFill" />
                                        </Panel>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>

