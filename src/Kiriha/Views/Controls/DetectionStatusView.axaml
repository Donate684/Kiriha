<UserControl
    x:Class="Kiriha.Views.Controls.DetectionStatusView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
    x:DataType="vmNowPlaying:NowPlayingViewModel">



    <Panel>
        <!--  ═══ Disabled State ═══  -->
        <Border
            MinHeight="300"
            Padding="48"
            Background="{DynamicResource SubtleFillColorSecondary}"
            CornerRadius="12">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!IsScrobblerEnabled" />
                    <Binding Path="!IsMediaDetected" />
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="24">
                <material:MaterialIcon
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Kind="RadioTower"
                    Opacity="0.1" />
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Opacity="0.8"
                        Text="{DynamicResource l.scrobbler.status.tracking_disabled}" />
                    <TextBlock
                        FontSize="13"
                        Opacity="0.4"
                        Text="{DynamicResource l.scrobbler.status.enable_hint}"
                        TextAlignment="Center" />
                </StackPanel>
                <Button
                    Padding="20,10"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SystemAccentColor}"
                    Command="{Binding GoToSettingsCommand}"
                    CornerRadius="6"
                    Foreground="White">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{DynamicResource l.navigation.settings}" />
                </Button>
            </StackPanel>
        </Border>

        <!--  ═══ Waiting State (Enabled but no media) ═══  -->
        <Border
            MinHeight="300"
            Padding="48"
            CornerRadius="12">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsScrobblerEnabled" />
                    <Binding Path="!IsMediaDetected" />
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <material:MaterialIcon
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    Kind="Waveform"
                    Opacity="0.1">
                    <material:MaterialIcon.Styles>
                        <Style Selector="material|MaterialIcon">
                            <Style.Animations>
                                <Animation IterationCount="INFINITE" Duration="0:0:3">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="0.05" />
                                    </KeyFrame>
                                    <KeyFrame Cue="50%">
                                        <Setter Property="Opacity" Value="0.15" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="0.05" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </material:MaterialIcon.Styles>
                </material:MaterialIcon>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="Medium"
                    Opacity="0.4"
                    Text="{DynamicResource l.scrobbler.status.wait_player}" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
