<UserControl
    x:Class="Kiriha.Views.AnimeList.AnimeListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kiriha.Views.AnimeList"
    xmlns:models="using:Kiriha.Models"
    xmlns:u="using:Kiriha.Utils.UI"
    xmlns:vmAnimeList="using:Kiriha.ViewModels.AnimeList"
    x:Name="animeListRoot"
    x:CompileBindings="True"
    x:DataType="vmAnimeList:AnimeListViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Views/AnimeList/AnimeCardTemplate.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style x:DataType="models:RatingOption" Selector="MenuFlyoutPresenter.ScoreFlyout MenuItem">
            <Setter Property="Header" Value="{Binding}" />
            <Setter Property="HeaderTemplate">
                <DataTemplate x:DataType="models:RatingOption">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Display}" />
                </DataTemplate>
            </Setter>
            <Setter Property="Command" Value="{Binding #animeListRoot.((vmAnimeList:AnimeListViewModel)DataContext).ApplyScoreFromMenuCommand}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Setter Property="Foreground" Value="{DynamicResource ScoreFlyoutItemForeground}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <StyleInclude Source="avares://Kiriha/Views/Styles/AnimeCardStyles.axaml" />
        <StyleInclude Source="avares://Kiriha/Views/Styles/AnimeFilterStyles.axaml" />
        <StyleInclude Source="avares://Kiriha/Views/Styles/AnimeListLayoutStyles.axaml" />

    </UserControl.Styles>

    <Grid Margin="0" RowDefinitions="Auto, Auto, *, Auto">

        <!--  Header  -->
        <local:AnimeListHeader
            x:Name="AnimeListHeader"
            Grid.Row="0"
            ReleaseMapRequested="AnimeListHeader_ReleaseMapRequested" />

        <!--  CONTENT: Grid  -->
        <ScrollViewer
            x:Name="AnimeListScrollViewer"
            Grid.Row="2"
            u:SmoothScroll.IsEnabled="True"
            u:SmoothScroll.SmoothingTimeMs="125"
            u:SmoothScroll.WheelMultiplier="120"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                x:Name="AnimeGridRepeater"
                Margin="20,0,20,16"
                ItemTemplate="{StaticResource AnimeCardTemplate}"
                ItemsSource="{Binding FilteredItems}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        MinColumnSpacing="0"
                        MinItemHeight="326"
                        MinItemWidth="172"
                        MinRowSpacing="0" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <local:AnimeReleaseMapView
            x:Name="ReleaseMapView"
            Grid.Row="1"
            Grid.RowSpan="2" />

    </Grid>
</UserControl>
