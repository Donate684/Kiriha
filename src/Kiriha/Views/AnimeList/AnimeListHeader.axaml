<UserControl
    x:Class="Kiriha.Views.AnimeList.AnimeListHeader"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:formats="using:Kiriha.Core.Domain.Models.Formats"
    xmlns:genres="using:Kiriha.Core.Domain.Models.Genres"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmAnimeList="using:Kiriha.ViewModels.AnimeList"
    x:Name="AnimeListHeaderRoot"
    x:DataType="vmAnimeList:AnimeListViewModel">
    <UserControl.Resources>
        <conv:LocConverter x:Key="LocConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.SyncButton">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.SyncButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.SyncButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.SyncButton.Syncing /template/ ContentPresenter#PART_ContentPresenter, Button.SyncButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorSecondary}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
        </Style>

        <Style Selector="Button.SyncButton.Syncing, Button.SyncButton:disabled">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <Style Selector="Button.SyncButton material|MaterialIcon.Spinning">
            <Style.Animations>
                <Animation IterationCount="Infinite" Duration="0:0:1">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto, Auto">
        <Border
            Grid.Row="0"
            Margin="20,4,20,12"
            Padding="8,6"
            Background="{DynamicResource SubtleFillColorSecondary}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                <!--  Discord-Style Search Container  -->
                <Grid
                    x:Name="SearchBarContainer"
                    Grid.Column="0"
                    VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto, *">
                        <!--  Active Tag Chips (Formats & Genres)  -->
                        <StackPanel
                            Grid.Column="0"
                            Margin="4,0,2,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <!--  Format Chips  -->
                            <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding SelectedFormats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="formats:FormatDefinition">
                                        <Border
                                            Padding="7,2,3,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemAccentColorLight3}"
                                            BorderBrush="{DynamicResource SystemAccentColor}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    Kind="MovieOutline" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding RussianName}" />
                                                <Button
                                                    Width="16"
                                                    Height="16"
                                                    Padding="1"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding #AnimeListHeaderRoot.((vmAnimeList:AnimeListViewModel)DataContext).RemoveFormatTagCommand}"
                                                    CommandParameter="{Binding}"
                                                    CornerRadius="8"
                                                    Cursor="Hand">
                                                    <material:MaterialIcon
                                                        Width="10"
                                                        Height="10"
                                                        Kind="Close"
                                                        Opacity="0.7" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Genre Chips  -->
                            <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding SelectedGenres}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="genres:GenreDefinition">
                                        <Border
                                            Padding="7,2,3,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemAccentColorLight3}"
                                            BorderBrush="{DynamicResource SystemAccentColor}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    Kind="TagOutline" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding RussianName}" />
                                                <Button
                                                    Width="16"
                                                    Height="16"
                                                    Padding="1"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding #AnimeListHeaderRoot.((vmAnimeList:AnimeListViewModel)DataContext).RemoveGenreTagCommand}"
                                                    CommandParameter="{Binding}"
                                                    CornerRadius="8"
                                                    Cursor="Hand">
                                                    <material:MaterialIcon
                                                        Width="10"
                                                        Height="10"
                                                        Kind="Close"
                                                        Opacity="0.7" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  Search Input  -->
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            Height="34"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            KeyDown="SearchBox_KeyDown"
                            PlaceholderText="{DynamicResource l.common.actions.search}"
                            Text="{Binding SearchQuery, Mode=TwoWay}">
                            <TextBox.InnerRightContent>
                                <StackPanel
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Padding="3"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ClearSearchCommand}"
                                        CornerRadius="6"
                                        Cursor="Hand"
                                        IsVisible="{Binding HasSearchOrFilters}"
                                        ToolTip.Tip="{DynamicResource l.common.actions.clear}">
                                        <material:MaterialIcon
                                            Width="16"
                                            Height="16"
                                            Kind="CloseCircleOutline"
                                            Opacity="0.45" />
                                    </Button>
                                    <material:MaterialIcon
                                        Width="18"
                                        Height="18"
                                        Margin="2,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="Magnify"
                                        Opacity="0.3" />
                                </StackPanel>
                            </TextBox.InnerRightContent>
                        </TextBox>
                    </Grid>

                    <!--  Discord-Style Auto-Suggestion Popup  -->
                    <Popup
                        HorizontalOffset="0"
                        IsLightDismissEnabled="True"
                        IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding #SearchBarContainer}"
                        VerticalOffset="6"
                        WindowManagerAddShadowHint="False">
                        <Border
                            MinWidth="320"
                            MaxWidth="420"
                            Padding="8,8,8,8"
                            Background="{DynamicResource LuxuryFlyoutBackground}"
                            BorderBrush="{DynamicResource LuxuryFlyoutBorder}"
                            BorderThickness="1"
                            BoxShadow="{DynamicResource FlyoutBorderThemeBoxShadow}"
                            CornerRadius="14">
                            <StackPanel Spacing="4">
                                <Grid Margin="6,2,6,4" ColumnDefinitions="*, Auto">
                                    <StackPanel
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                        <material:MaterialIcon
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource SystemAccentColor}"
                                            Kind="TagMultipleOutline" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Opacity="0.6"
                                            Text="{DynamicResource l.anime.labels.type}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Opacity="0.4"
                                            Text="/" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Opacity="0.6"
                                            Text="{DynamicResource l.anime.labels.genres}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Opacity="0.35"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <material:MaterialIcon
                                            Width="13"
                                            Height="13"
                                            VerticalAlignment="Center"
                                            Kind="KeyboardReturn" />
                                    </StackPanel>
                                </Grid>

                                <ListBox
                                    MaxHeight="260"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Classes="SuggestionList"
                                    ItemsSource="{Binding TagSuggestions}"
                                    SelectedItem="{Binding SelectedSuggestion}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vmAnimeList:SearchTagSuggestionItem">
                                            <Button
                                                Padding="6,5"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding #AnimeListHeaderRoot.((vmAnimeList:AnimeListViewModel)DataContext).AddTagSuggestionCommand}"
                                                CommandParameter="{Binding}"
                                                CornerRadius="8"
                                                Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="26"
                                                        Height="26"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                                        CornerRadius="7">
                                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <material:MaterialIcon
                                                                Width="14"
                                                                Height="14"
                                                                Foreground="{DynamicResource SystemAccentColor}"
                                                                IsVisible="{Binding IsFormat}"
                                                                Kind="MovieOutline" />
                                                            <material:MaterialIcon
                                                                Width="14"
                                                                Height="14"
                                                                Foreground="{DynamicResource SystemAccentColor}"
                                                                IsVisible="{Binding IsGenre}"
                                                                Kind="TagOutline" />
                                                        </Panel>
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding Name}" />
                                                            <TextBlock
                                                                VerticalAlignment="Bottom"
                                                                FontSize="11"
                                                                Opacity="0.5"
                                                                Text="{Binding Subtitle}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="2"
                                                        Margin="4,0,4,0"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                                        CornerRadius="10"
                                                        IsVisible="{Binding HasCount}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Opacity="0.7"
                                                            Text="{Binding DisplayCount}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!--  MediaKind Unified Capsule Slider Toggle  -->
                <ToggleButton
                    x:Name="MediaKindToggle"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Classes="MediaKindTextToggle"
                    Command="{Binding ToggleMediaKindCommand}"
                    IsChecked="{Binding IsMangaSelected, Mode=OneWay}" />

                <StackPanel
                    Grid.Column="2"
                    Margin="8,0,12,0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Border
                        Width="1"
                        Height="20"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefault}" />

                    <Button
                        x:Name="ReleaseMapButton"
                        Classes="ScheduleToggle"
                        Click="ReleaseMapButton_Click">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="5">
                            <material:MaterialIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Kind="CalendarClock" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{DynamicResource l.schedule.title}" />
                        </StackPanel>
                    </Button>

                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefault}" />

                    <!--  Sort  -->
                    <Button
                        Padding="8,6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                Kind="SortVariant"
                                Opacity="0.6" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{Binding DisplaySortBy}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="FilterFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel
                                    MinWidth="280"
                                    Margin="6"
                                    Spacing="4">
                                    <ListBox
                                        Classes="SortList"
                                        ItemsSource="{Binding SortOptions}"
                                        SelectedItem="{Binding SortBy}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid VerticalAlignment="Center" ColumnDefinitions="14,*">
                                                    <material:MaterialIcon
                                                        Grid.Column="0"
                                                        Width="13"
                                                        Height="13"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource SystemAccentColor}"
                                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                                        Kind="Check" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="{Binding Converter={StaticResource LocConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border
                                        Height="1"
                                        Margin="4,2"
                                        Background="{DynamicResource DividerStrokeColorDefault}" />

                                    <ToggleButton Classes="FilterToggle" IsChecked="{Binding PrioritizeNewEpisodes}">
                                        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                                            <Border
                                                Grid.Column="0"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource OrangeredAccentTintBrush}"
                                                CornerRadius="6">
                                                <material:MaterialIcon
                                                    Width="13"
                                                    Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource OrangeredAccentBrush}"
                                                    Kind="BellRingOutline" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{DynamicResource l.filters.sort.new_episodes_first}" />
                                            <Border
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Classes="SwitchTrack">
                                                <Ellipse Classes="SwitchThumb" />
                                            </Border>
                                        </Grid>
                                    </ToggleButton>

                                    <ToggleButton Classes="FilterToggle" IsChecked="{Binding PrioritizeUnwatched}">
                                        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                                            <Border
                                                Grid.Column="0"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource FilterBlueTintBrush}"
                                                CornerRadius="6">
                                                <material:MaterialIcon
                                                    Width="13"
                                                    Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource FilterBlueBrush}"
                                                    Kind="PlayCircleOutline" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{DynamicResource l.filters.sort.unwatched_first}" />
                                            <Border
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Classes="SwitchTrack">
                                                <Ellipse Classes="SwitchThumb" />
                                            </Border>
                                        </Grid>
                                    </ToggleButton>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--  Filters  -->
                    <Button
                        Padding="8,6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Classes.active="{Binding IsFilterActive}"
                        CornerRadius="6">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Opacity" Value="0.6" />
                            </Style>
                            <Style Selector="Button.active">
                                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                            <Style Selector="Button.active TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                Foreground="{Binding $parent[Button].Foreground}"
                                Kind="FilterVariant" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{Binding $parent[Button].Foreground}"
                                Text="{DynamicResource l.filters.title}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="FilterFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel
                                    Width="310"
                                    Margin="10"
                                    Spacing="8">
                                    <!--  NSFW toggle row  -->
                                    <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterNsfw}">
                                        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                                            <Border
                                                Grid.Column="0"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource FilterRedTintBrush}"
                                                CornerRadius="6">
                                                <material:MaterialIcon
                                                    Width="13"
                                                    Height="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource FilterRedBrush}"
                                                    Kind="AlertOctagonOutline" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{DynamicResource l.filters.visibility.adult_only}" />
                                            <Border
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Classes="SwitchTrack">
                                                <Ellipse Classes="SwitchThumb" />
                                            </Border>
                                        </Grid>
                                    </ToggleButton>

                                    <!--  Types Header  -->
                                    <Grid Margin="2,0" ColumnDefinitions="*, Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <material:MaterialIcon
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Kind="MovieOutline"
                                                Opacity="0.6" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource l.anime.labels.type}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource SystemAccentColor}"
                                            IsVisible="{Binding HasSelectedFormats}"
                                            Text="{Binding SelectedFormats.Count, StringFormat='({0})'}" />
                                    </Grid>

                                    <!--  Types Quick-Pick Chips  -->
                                    <ItemsControl ItemsSource="{Binding FormatFilterItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmAnimeList:FormatFilterItemViewModel">
                                                <ToggleButton
                                                    Margin="0,0,4,4"
                                                    Classes="GenreChipToggle"
                                                    Content="{Binding DisplayName}"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  Divider  -->
                                    <Border
                                        Height="1"
                                        Margin="0,2"
                                        Background="{DynamicResource DividerStrokeColorDefault}" />

                                    <!--  Genres Header  -->
                                    <Grid Margin="2,0" ColumnDefinitions="*, Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <material:MaterialIcon
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Kind="TagOutline"
                                                Opacity="0.6" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource l.anime.labels.genres}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource SystemAccentColor}"
                                            IsVisible="{Binding HasSelectedGenres}"
                                            Text="{Binding SelectedGenres.Count, StringFormat='({0})'}" />
                                    </Grid>

                                    <!--  Genres Quick-Pick Scrollable Chips  -->
                                    <ScrollViewer
                                        MaxHeight="180"
                                        Margin="0,0,-8,0"
                                        Padding="0,0,12,0"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding GenreFilterItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vmAnimeList:GenreFilterItemViewModel">
                                                    <ToggleButton
                                                        Margin="0,0,4,4"
                                                        Classes="GenreChipToggle"
                                                        Content="{Binding DisplayName}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!--  Clear filters button  -->
                                    <Border
                                        Height="1"
                                        Margin="0,2"
                                        Background="{DynamicResource DividerStrokeColorDefault}"
                                        IsVisible="{Binding IsFilterActive}" />
                                    <Button
                                        Classes="FilterReset"
                                        Command="{Binding ClearFiltersCommand}"
                                        Content="{DynamicResource l.common.actions.clear}"
                                        IsVisible="{Binding IsFilterActive}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!--  Sync  -->
                <Button
                    Grid.Column="3"
                    Classes="SyncButton"
                    Classes.Syncing="{Binding IsSyncing}"
                    Command="{Binding SyncMalCommand}"
                    IsEnabled="{Binding !IsSyncing}">
                    <Panel VerticalAlignment="Center">
                        <!--  Idle state  -->
                        <StackPanel
                            IsVisible="{Binding !IsSyncing}"
                            Orientation="Horizontal"
                            Spacing="6">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                Kind="Sync" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource l.sync.actions.sync_now}" />
                        </StackPanel>

                        <!--  Syncing state: spinning icon + disabled text  -->
                        <StackPanel
                            IsVisible="{Binding IsSyncing}"
                            Orientation="Horizontal"
                            Spacing="6">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                Classes="Spinning"
                                Kind="Sync"
                                RenderTransformOrigin="50%,50%" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource l.sync.syncing.generic}" />
                        </StackPanel>
                    </Panel>
                </Button>
            </Grid>
        </Border>

        <!--  Status Tabs  -->
        <Border
            x:Name="StatusTabsPanel"
            Grid.Row="1"
            Margin="20,0,20,12"
            Padding="4"
            HorizontalAlignment="Center"
            Background="{DynamicResource SubtleFillColorSecondary}"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton
                    Classes="Pill"
                    Command="{Binding FilterCommand}"
                    CommandParameter="Watching"
                    Content="{Binding WatchingHeader}"
                    GroupName="StatusFilter"
                    IsChecked="{Binding IsWatchingSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding FilterCommand}"
                    CommandParameter="Completed"
                    Content="{Binding CompletedHeader}"
                    GroupName="StatusFilter"
                    IsChecked="{Binding IsCompletedSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding FilterCommand}"
                    CommandParameter="OnHold"
                    Content="{Binding OnHoldHeader}"
                    GroupName="StatusFilter"
                    IsChecked="{Binding IsOnHoldSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding FilterCommand}"
                    CommandParameter="Dropped"
                    Content="{Binding DroppedHeader}"
                    GroupName="StatusFilter"
                    IsChecked="{Binding IsDroppedSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding FilterCommand}"
                    CommandParameter="PlanToWatch"
                    Content="{Binding PlanToWatchHeader}"
                    GroupName="StatusFilter"
                    IsChecked="{Binding IsPlanToWatchSelected, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
