<UserControl
    x:Class="Kiriha.Views.Main.SmartTransitionsOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vmMain="using:Kiriha.ViewModels.Main"
    d:DesignHeight="720"
    d:DesignWidth="1100"
    x:DataType="vmMain:MainWindowViewModel"
    mc:Ignorable="d">

    <Grid>
        <!--  ══════════ Quick Rating Card ══════════  -->
        <Border
            Width="430"
            Margin="0,0,24,24"
            Padding="18,16,18,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource ModalBackgroundFill}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            BoxShadow="0 10 32 0 #55000000"
            CornerRadius="14"
            IsVisible="{Binding IsQuickRatingVisible}"
            ZIndex="500">
            <Border.Styles>
                <Style Selector="Button.RatingScoreBtn">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
                <Style Selector="Button.RatingScoreBtn:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </Border.Styles>

            <StackPanel Spacing="10">
                <!--  Header  -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <material:MaterialIcon
                        Width="22"
                        Height="22"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Kind="StarCircle" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{DynamicResource l.scrobbler.quick_rating.title}" />
                    <Button
                        Grid.Column="2"
                        Width="26"
                        Height="26"
                        Padding="4"
                        Classes="clear"
                        Command="{Binding CloseQuickRatingCommand}"
                        CornerRadius="4">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            Kind="Close" />
                    </Button>
                </Grid>

                <!--  Anime Title & Subtitle  -->
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Text="{Binding QuickRatingAnime.Presentation.DisplayTitle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.75"
                        Text="{DynamicResource l.scrobbler.quick_rating.subtitle}" />
                </StackPanel>

                <!--  Rating Buttons 1..10  -->
                <ItemsControl ItemsSource="{x:Static vmMain:MainWindowViewModel.RatingScores}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Button
                                Classes="RatingScoreBtn"
                                Command="{Binding $parent[UserControl].((vmMain:MainWindowViewModel)DataContext).SubmitQuickRatingIntCommand}"
                                CommandParameter="{Binding}"
                                Content="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Skip Action  -->
                <Button
                    Padding="12,5"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseQuickRatingCommand}"
                    Content="{DynamicResource l.scrobbler.quick_rating.dismiss}"
                    CornerRadius="6"
                    FontSize="12" />
            </StackPanel>
        </Border>

        <!--  ══════════ Rewatch Prompt Card ══════════  -->
        <Border
            Width="430"
            Margin="0,0,24,24"
            Padding="18,16,18,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource ModalBackgroundFill}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            BoxShadow="0 10 32 0 #55000000"
            CornerRadius="14"
            IsVisible="{Binding IsRewatchPromptVisible}"
            ZIndex="501">
            <StackPanel Spacing="10">
                <!--  Header  -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <material:MaterialIcon
                        Width="22"
                        Height="22"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Kind="History" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{DynamicResource l.scrobbler.rewatch_prompt.title}" />
                    <Button
                        Grid.Column="2"
                        Width="26"
                        Height="26"
                        Padding="4"
                        Classes="clear"
                        Command="{Binding DismissRewatchPromptCommand}"
                        CornerRadius="4">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            Kind="Close" />
                    </Button>
                </Grid>

                <!--  Prompt Body  -->
                <TextBlock
                    FontSize="13"
                    Opacity="0.9"
                    Text="{Binding RewatchPromptText}"
                    TextWrapping="Wrap" />

                <!--  Actions  -->
                <StackPanel
                    Margin="0,4,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Padding="12,6"
                        Command="{Binding DismissRewatchPromptCommand}"
                        Content="{DynamicResource l.scrobbler.rewatch_prompt.dismiss}"
                        CornerRadius="6"
                        FontSize="12" />
                    <Button
                        Padding="14,6"
                        Classes="accent"
                        Command="{Binding ConfirmRewatchCommand}"
                        Content="{DynamicResource l.scrobbler.rewatch_prompt.confirm}"
                        CornerRadius="6"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
