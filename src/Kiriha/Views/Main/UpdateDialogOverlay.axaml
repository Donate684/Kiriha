<UserControl
    x:Class="Kiriha.Views.Main.UpdateDialogOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vmMain="using:Kiriha.ViewModels.Main"
    d:DesignHeight="720"
    d:DesignWidth="1100"
    x:DataType="vmMain:MainWindowViewModel"
    mc:Ignorable="d">
    <Border
        Background="{DynamicResource ModalOverlayBackgroundBrush}"
        IsVisible="{Binding IsUpdateDialogOpen}"
        ZIndex="110">
        <Border.Styles>
            <Style Selector="Button.DimOverlay">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter>
            </Style>
        </Border.Styles>

        <Grid>
            <!--  Click dim to close (disabled when downloading/downloaded)  -->
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="DimOverlay"
                Command="{Binding CloseUpdateDialogCommand}"
                Focusable="False"
                IsEnabled="{Binding !UpdateDialog.IsDownloadingOrFinished, FallbackValue=True}" />

            <!--  Modal card  -->
            <Border
                Width="480"
                Height="280"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ModalBackgroundFill}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                BoxShadow="0 10 40 0 #60000000"
                ClipToBounds="True"
                CornerRadius="12">
                <ContentControl Content="{Binding UpdateDialog}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
