<UserControl
    x:Class="Kiriha.Views.Main.MainSidebar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kiriha.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vmMain="using:Kiriha.ViewModels.Main"
    d:DesignHeight="720"
    d:DesignWidth="230"
    x:DataType="vmMain:MainWindowViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">

        <!--
            Brand header — лейаут одинаковый в обоих режимах,
            текст просто "проявляется" справа при раскрытии панели.
        -->
        <Button
            Grid.Row="0"
            Margin="0,10,0,6"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding NavigateWelcomeCommand}">
            <StackPanel
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <controls:LeafLogo
                    Width="56"
                    Height="56"
                    VerticalAlignment="Center"
                    ShowHalo="False" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Light"
                    IsVisible="{Binding IsPaneOpen}"
                    LetterSpacing="3"
                    Opacity="0.9"
                    Text="{DynamicResource l.common.app_name}" />
            </StackPanel>
        </Button>

        <!--  Divider  -->
        <Border
            Grid.Row="1"
            Height="1"
            Margin="12,0,12,0"
            Background="{DynamicResource DividerStrokeColorDefault}"
            Opacity="0.6" />

        <!--  Section label  -->
        <Panel Grid.Row="2" Height="28">
            <TextBlock
                Margin="18,12,0,0"
                FontSize="10"
                FontWeight="Bold"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                IsVisible="{Binding IsPaneOpen}"
                LetterSpacing="1.2"
                Text="{DynamicResource l.navigation.header}" />
        </Panel>

        <!--  Navigation items  -->
        <ListBox
            Grid.Row="3"
            Background="Transparent"
            BorderThickness="0"
            Classes="NavList"
            IsEnabled="{Binding !IsNavigationBlocked}"
            SelectedIndex="{Binding SelectedNavigationIndex}">

            <!--  Profile  -->
            <ListBoxItem>
                <Panel Height="40">
                    <Border
                        Width="3"
                        Height="18"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SystemAccentColor}"
                        Classes="SelectionIndicator"
                        CornerRadius="0,3,3,0" />
                    <StackPanel
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <material:MaterialIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Kind="AccountCircleOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding IsPaneOpen}"
                            Text="{DynamicResource l.navigation.profile}" />
                    </StackPanel>
                </Panel>
            </ListBoxItem>

            <!--  Home / Now Playing  -->
            <ListBoxItem>
                <Panel Height="40">
                    <Border
                        Width="3"
                        Height="18"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SystemAccentColor}"
                        Classes="SelectionIndicator"
                        CornerRadius="0,3,3,0" />
                    <StackPanel
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <material:MaterialIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Kind="PlayCircleOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding IsPaneOpen}"
                            Text="{DynamicResource l.navigation.now_playing}" />
                    </StackPanel>
                </Panel>
            </ListBoxItem>

            <!--  Anime List  -->
            <ListBoxItem>
                <Panel Height="40">
                    <Border
                        Width="3"
                        Height="18"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SystemAccentColor}"
                        Classes="SelectionIndicator"
                        CornerRadius="0,3,3,0" />
                    <StackPanel
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <material:MaterialIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Kind="FormatListBulleted" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding IsPaneOpen}"
                            Text="{DynamicResource l.navigation.anime_list}" />
                    </StackPanel>
                </Panel>
            </ListBoxItem>

            <!--  Seasonal  -->
            <ListBoxItem>
                <Panel Height="40">
                    <Border
                        Width="3"
                        Height="18"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SystemAccentColor}"
                        Classes="SelectionIndicator"
                        CornerRadius="0,3,3,0" />
                    <StackPanel
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <material:MaterialIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Kind="CalendarMonthOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding IsPaneOpen}"
                            Text="{DynamicResource l.navigation.seasonal}" />
                    </StackPanel>
                </Panel>
            </ListBoxItem>

            <!--  History  -->
            <ListBoxItem>
                <Panel Height="40">
                    <Border
                        Width="3"
                        Height="18"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SystemAccentColor}"
                        Classes="SelectionIndicator"
                        CornerRadius="0,3,3,0" />
                    <StackPanel
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <material:MaterialIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Kind="History" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding IsPaneOpen}"
                            Text="{DynamicResource l.navigation.history}" />
                    </StackPanel>
                </Panel>
            </ListBoxItem>

            <!--  Torrents  -->
            <ListBoxItem>
                <Panel Height="40">
                    <Border
                        Width="3"
                        Height="18"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SystemAccentColor}"
                        Classes="SelectionIndicator"
                        CornerRadius="0,3,3,0" />
                    <StackPanel
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <material:MaterialIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Kind="CloudDownloadOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding IsPaneOpen}"
                            Text="{DynamicResource l.navigation.torrents}" />
                    </StackPanel>
                </Panel>
            </ListBoxItem>

            <!--  Search / Discover  -->
            <ListBoxItem>
                <Panel Height="40">
                    <Border
                        Width="3"
                        Height="18"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SystemAccentColor}"
                        Classes="SelectionIndicator"
                        CornerRadius="0,3,3,0" />
                    <StackPanel
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <material:MaterialIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Kind="Magnify" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            IsVisible="{Binding IsPaneOpen}"
                            Text="{DynamicResource l.navigation.search}" />
                    </StackPanel>
                </Panel>
            </ListBoxItem>
        </ListBox>

        <!--  ═══ Bottom controls ═══  -->
        <StackPanel
            Grid.Row="4"
            Margin="6,0,6,12"
            Spacing="2">
            <Border
                Height="1"
                Margin="6,0,6,6"
                Background="{DynamicResource DividerStrokeColorDefault}" />

            <!--  Settings  -->
            <Button
                Height="40"
                Padding="0"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding NavigateSettings}"
                CornerRadius="6"
                IsEnabled="{Binding !IsNavigationBlocked}">
                <Panel>
                    <Border
                        Width="3"
                        Height="18"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="0,3,3,0"
                        IsVisible="{Binding IsSettingsSelected}" />
                    <StackPanel
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Spacing="14">
                        <material:MaterialIcon
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Classes.active="{Binding IsSettingsSelected}"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Kind="CogOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes.active="{Binding IsSettingsSelected}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            IsVisible="{Binding IsPaneOpen}"
                            Text="{DynamicResource l.navigation.settings}" />
                    </StackPanel>
                </Panel>
            </Button>

            <!--  Collapse toggle  -->
            <Button
                Height="36"
                Padding="0"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding TriggerPaneCommand}"
                CornerRadius="6">
                <StackPanel
                    Margin="14,0,0,0"
                    Orientation="Horizontal"
                    Spacing="14">
                    <Panel
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center">
                        <material:MaterialIcon
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            IsVisible="{Binding IsPaneOpen}"
                            Kind="ChevronDoubleLeft" />
                        <material:MaterialIcon
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            IsVisible="{Binding !IsPaneOpen}"
                            Kind="ChevronDoubleRight" />
                    </Panel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        IsVisible="{Binding IsPaneOpen}"
                        Text="{DynamicResource l.common.actions.collapse}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
