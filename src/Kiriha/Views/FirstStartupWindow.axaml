<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmStartup="using:Kiriha.ViewModels.Startup"
        xmlns:views="using:Kiriha.Views"
        x:Class="Kiriha.Views.FirstStartupWindow"
        x:DataType="vmStartup:FirstStartupViewModel"
        Title="Kiriha Setup"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SizeToContent="WidthAndHeight"
        CanResize="False">
    
    <LayoutTransformControl Name="ScaleRoot">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </LayoutTransformControl.LayoutTransform>
        <views:FirstStartupView />
    </LayoutTransformControl>
</Window>
