<UserControl
    x:Class="Kiriha.Views.History.HistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:core="using:Kiriha.Core"
    xmlns:local="using:Kiriha.Views.History"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:u="using:Kiriha.Utils.UI"
    xmlns:vmHistory="using:Kiriha.ViewModels.History"
    x:DataType="vmHistory:HistoryViewModel">

    <UserControl.Resources>
        <conv:LocConverter x:Key="LocConverter" />
        <conv:HistoryActionConverter x:Key="HistoryActionConverter" />

        <!--  Date Header Template  -->
        <DataTemplate x:Key="HistoryDateHeaderTemplate" x:DataType="vmHistory:HistoryDateHeaderItem">
            <Grid
                Height="28"
                Margin="{Binding Margin}"
                ColumnDefinitions="33, *">
                <Border
                    Grid.Column="0"
                    Width="8"
                    Height="8"
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemAccentColor}"
                    CornerRadius="4" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{DynamicResource SystemAccentColor}"
                    LetterSpacing="1.2"
                    Opacity="0.85"
                    Text="{Binding Header}" />
            </Grid>
        </DataTemplate>

        <!--  Entry Card Template  -->
        <DataTemplate x:Key="HistoryEntryTemplate" x:DataType="vmHistory:HistoryEntryVm">
            <Grid Margin="0,0,0,8" ColumnDefinitions="33, *">
                <!--  Timeline column  -->
                <Panel Grid.Column="0">
                    <!--  Continuous vertical line when not last in group  -->
                    <Border
                        Width="1.5"
                        Margin="9.25,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource DividerStrokeColorDefault}"
                        IsVisible="{Binding !IsLastInGroup}" />

                    <!--  Top-half vertical line when last in group  -->
                    <Grid IsVisible="{Binding IsLastInGroup}" RowDefinitions="*,*">
                        <Border
                            Grid.Row="0"
                            Width="1.5"
                            Margin="9.25,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource DividerStrokeColorDefault}" />
                    </Grid>

                    <!--  Timeline dot  -->
                    <Border
                        Width="10"
                        Height="10"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SystemAccentColor}"
                        BoxShadow="0 0 0 3 #22000000"
                        CornerRadius="5"
                        Opacity="0.85" />
                </Panel>

                <!--  Card  -->
                <Border
                    Grid.Column="1"
                    Padding="12,10"
                    Background="{DynamicResource CardBackgroundFillDefault}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    Classes="HistoryRow revealItem"
                    CornerRadius="12"
                    DoubleTapped="HistoryItem_DoubleTapped">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto">
                        <!--  Poster  -->
                        <Border
                            Grid.Column="0"
                            Width="42"
                            Height="60"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondary}"
                            ClipToBounds="True"
                            CornerRadius="6">
                            <Panel>
                                <material:MaterialIcon
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Kind="ImageOutline"
                                    Opacity="0.35" />
                                <Image
                                    core:CachedImage.DecodeWidth="100"
                                    core:CachedImage.Source="{Binding PosterUrl}"
                                    Stretch="UniformToFill" />
                            </Panel>
                        </Border>

                        <!--  Action icon badge  -->
                        <Border
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondary}"
                            CornerRadius="14">
                            <material:MaterialIcon
                                Width="14"
                                Height="14"
                                Foreground="{DynamicResource SystemAccentColor}"
                                Kind="{Binding Converter={StaticResource HistoryActionConverter}, ConverterParameter='icon'}"
                                Opacity="0.85" />
                        </Border>

                        <!--  Info  -->
                        <StackPanel
                            Grid.Column="2"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemBaseHighColor}"
                                MaxLines="1"
                                Text="{Binding AnimeTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource SystemAccentColor}"
                                IsVisible="{Binding RussianTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                MaxLines="1"
                                Opacity="0.85"
                                Text="{Binding RussianTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Margin="0,2,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.85"
                                        Text="{Binding Converter={StaticResource HistoryActionConverter}}" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource SystemAccentColor}"
                                        IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Opacity="0.85"
                                        Text="{Binding Detail}" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    IsVisible="{Binding EpisodeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Opacity="0.5"
                                    Text="&#183;" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource SystemAccentColor}"
                                    Opacity="0.85"
                                    Text="{Binding EpisodeLabel}" />

                                <!--  Tracker sync status badges  -->
                                <ItemsControl
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasTrackerBadges}"
                                    ItemsSource="{Binding TrackerBadges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmHistory:TrackerStatusBadgeVm">
                                            <Button
                                                Classes="TrackerBadgeBtn"
                                                Command="{Binding SyncCommand}"
                                                Cursor="{Binding CursorKind}"
                                                ToolTip.Tip="{Binding Tooltip}">
                                                <Border
                                                    Padding="5,1"
                                                    Background="{Binding BackgroundBrush}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="3">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding IconForeground}"
                                                            Text="{Binding DisplayName}" />
                                                        <material:MaterialIcon
                                                            Width="11"
                                                            Height="11"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding IconForeground}"
                                                            Kind="{Binding IconKind}" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>


                        <!--  Range count badge  -->
                        <Border
                            Grid.Column="3"
                            Margin="0,0,10,0"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemAccentColor}"
                            CornerRadius="10"
                            IsVisible="{Binding IsRange}">
                            <TextBlock
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Count, Converter={StaticResource LocConverter}, ConverterParameter='format:l.history.count_format'}" />
                        </Border>

                        <!--  Time  -->
                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.4"
                            Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <local:HistoryItemTemplateSelector
            x:Key="HistoryTemplateSelector"
            EntryTemplate="{StaticResource HistoryEntryTemplate}"
            HeaderTemplate="{StaticResource HistoryDateHeaderTemplate}" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  Tracker badge button styling  -->
        <Style Selector="Button.TrackerBadgeBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.TrackerBadgeBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.TrackerBadgeBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.TrackerBadgeBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  History row hover feedback  -->
        <Style Selector="Border.HistoryRow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.HistoryRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--  ═══ Reveal-on-load: каскад при появлении строк ═══  -->
        <Style Selector="Border.revealItem">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translate(0,16px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.42" />
                    <TransformOperationsTransition
                        Easing="CubicEaseOut"
                        Property="RenderTransform"
                        Duration="0:0:0.42" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.revealItem.shown">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translate(0,0)" />
        </Style>

        <!--  Torrents-style Filter Toggle (period)  -->
        <Style Selector="ToggleButton.FilterToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.FilterToggle:checked">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="ToggleButton.FilterToggle:checked TextBlock">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="0" RowDefinitions="Auto, Auto, *">

        <!--  Search + Period bar (Torrents-style)  -->
        <Border
            Grid.Row="0"
            Margin="20,4,20,12"
            Padding="8,6"
            Background="{DynamicResource SubtleFillColorSecondary}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnDefinitions="*, Auto">
                <TextBox
                    Grid.Column="0"
                    Height="34"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="13"
                    PlaceholderText="{DynamicResource l.history.search_placeholder}"
                    Text="{Binding SearchQuery, Mode=TwoWay}">
                    <TextBox.InnerRightContent>
                        <material:MaterialIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            Kind="Magnify"
                            Opacity="0.3" />
                    </TextBox.InnerRightContent>
                </TextBox>
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,4,0"
                    Orientation="Horizontal"
                    Spacing="0">
                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefault}" />

                    <ToggleButton Classes="FilterToggle" IsChecked="{Binding IsPeriodAll, Mode=TwoWay}">
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            Text="{DynamicResource l.history.period.all}" />
                    </ToggleButton>
                    <ToggleButton Classes="FilterToggle" IsChecked="{Binding IsPeriodToday, Mode=TwoWay}">
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            Text="{DynamicResource l.history.period.today}" />
                    </ToggleButton>
                    <ToggleButton Classes="FilterToggle" IsChecked="{Binding IsPeriodWeek, Mode=TwoWay}">
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            Text="{DynamicResource l.history.period.week}" />
                    </ToggleButton>
                    <ToggleButton Classes="FilterToggle" IsChecked="{Binding IsPeriodMonth, Mode=TwoWay}">
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            Text="{DynamicResource l.history.period.month}" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Action-type tabs (AnimeList-style)  -->
        <Border
            Grid.Row="1"
            Margin="20,0,20,12"
            Padding="4"
            HorizontalAlignment="Center"
            Background="{DynamicResource SubtleFillColorSecondary}"
            CornerRadius="8"
            IsVisible="{Binding HasHistory}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton
                    Classes="Pill"
                    Content="{DynamicResource l.history.actions.all}"
                    GroupName="HistAction"
                    IsChecked="{Binding IsActionAll, Mode=TwoWay}" />
                <RadioButton
                    Classes="Pill"
                    Content="{DynamicResource l.history.actions.watched}"
                    GroupName="HistAction"
                    IsChecked="{Binding IsActionWatched, Mode=TwoWay}" />
                <RadioButton
                    Classes="Pill"
                    Content="{DynamicResource l.history.actions.completed}"
                    GroupName="HistAction"
                    IsChecked="{Binding IsActionCompleted, Mode=TwoWay}" />
                <RadioButton
                    Classes="Pill"
                    Content="{DynamicResource l.history.actions.dropped}"
                    GroupName="HistAction"
                    IsChecked="{Binding IsActionDropped, Mode=TwoWay}" />
                <RadioButton
                    Classes="Pill"
                    Content="{DynamicResource l.history.actions.score_set_filter}"
                    GroupName="HistAction"
                    IsChecked="{Binding IsActionScoreSet, Mode=TwoWay}" />
                <RadioButton
                    Classes="Pill"
                    Content="{DynamicResource l.history.actions.deleted}"
                    GroupName="HistAction"
                    IsChecked="{Binding IsActionDeleted, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!--  Content Area  -->
        <Panel Grid.Row="2">
            <!--  Empty DB  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding !HasHistory}"
                Spacing="16">
                <material:MaterialIcon
                    Width="64"
                    Height="64"
                    Kind="History"
                    Opacity="0.1" />
                <TextBlock
                    FontSize="15"
                    FontWeight="Medium"
                    Opacity="0.4"
                    Text="{DynamicResource l.history.no_history}" />
            </StackPanel>

            <!--  No filter matches  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasHistory" />
                        <Binding Path="!HasResults" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <material:MaterialIcon
                    Width="56"
                    Height="56"
                    Kind="MagnifyRemoveOutline"
                    Opacity="0.12" />
                <TextBlock
                    FontSize="14"
                    FontWeight="Medium"
                    Opacity="0.5"
                    Text="{DynamicResource l.history.no_results}" />
            </StackPanel>

            <!--  Grouped Timeline (Virtualized ItemsRepeater)  -->
            <ScrollViewer
                x:Name="HistoryScrollViewer"
                Padding="0,0,0,0"
                u:SmoothScroll.IsEnabled="True"
                HorizontalScrollBarVisibility="Disabled"
                IsVisible="{Binding HasResults}"
                VerticalScrollBarVisibility="Auto">
                <ItemsRepeater
                    x:Name="HistoryRepeater"
                    Margin="20,4,20,24"
                    ItemTemplate="{StaticResource HistoryTemplateSelector}"
                    ItemsSource="{Binding TimelineItems}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>


