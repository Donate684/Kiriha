<UserControl
    x:Class="Kiriha.Views.Search.SearchView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:entities="using:Kiriha.Core.Domain.Models.Entities"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmSearch="using:Kiriha.ViewModels.Search"
    x:DataType="vmSearch:SearchViewModel">

    <UserControl.Resources>
        <conv:LocConverter x:Key="LocConverter" />
        <conv:AdultColorConverter x:Key="AdultColorConverter" />
        <conv:AdultIconConverter x:Key="AdultIconConverter" />
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:StatusNotNoneConverter x:Key="StatusNotNoneConverter" />
        <conv:StatusNoneConverter x:Key="StatusNoneConverter" />

        <!--  Result Card Template (List View)  -->
        <DataTemplate x:Key="SearchResultTemplate" x:DataType="entities:AnimeEntity">
            <Border
                HorizontalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillDefault}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                BoxShadow="0 1 3 0 #06000000"
                ClipToBounds="True"
                CornerRadius="12"
                DoubleTapped="Poster_DoubleTapped">
                <Grid ColumnDefinitions="110, *">
                    <!--  Left: Poster  -->
                    <Panel Grid.Column="0">
                        <asyncImageLoader:AdvancedImage
                            Height="150"
                            Source="{Binding MainPictureUrl}"
                            Stretch="UniformToFill" />

                        <!--  Score overlay on poster  -->
                        <Border
                            Padding="5,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#CC000000"
                            CornerRadius="0,0,0,8"
                            IsVisible="{Binding Presentation.HasMeanScore}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <material:MaterialIcon
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Foreground="Gold"
                                    Kind="Star" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding MeanScore}" />
                            </StackPanel>
                        </Border>
                    </Panel>

                    <!--  Right: Content  -->
                    <Grid
                        Grid.Column="1"
                        Margin="14,10,14,10"
                        RowDefinitions="Auto, *, Auto">

                        <!--  Top: Titles & Action Buttons  -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Spacing="1">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SystemBaseHighColor}"
                                    MaxLines="1"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource SystemAccentColor}"
                                    IsVisible="{Binding RussianTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    MaxLines="1"
                                    Text="{Binding RussianTitle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />

                                <!--  Meta Info (Type, Episodes, Year)  -->
                                <StackPanel
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Border
                                        Padding="6,2"
                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Opacity="0.9"
                                            Text="{Binding Type, Converter={StaticResource LocConverter}}" />
                                    </Border>
                                    <!--  Episodes Card  -->
                                    <Border
                                        Padding="6,2"
                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                        CornerRadius="4"
                                        IsVisible="{Binding Presentation.HasTotalEpisodes}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Opacity="0.9"
                                                Text="{Binding TotalEpisodes}" />
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Opacity="0.9"
                                                Text="{DynamicResource l.history.unit_ep}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="6,2"
                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                        CornerRadius="4"
                                        IsVisible="{Binding Season, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Opacity="0.9"
                                            Text="{Binding Season, Converter={StaticResource LocConverter}}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!--  Action Buttons (Icon + Text)  -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                IsVisible="{Binding Status, Converter={StaticResource StatusNoneConverter}}"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Padding="10,6"
                                    Background="{DynamicResource SubtleFillColorSecondary}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                    BorderThickness="1"
                                    Command="{Binding $parent[UserControl].((vmSearch:SearchViewModel)DataContext).AddToWatchingCommand}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <material:MaterialIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource SystemAccentColor}"
                                            Kind="EyeOutline" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource SystemAccentColor}"
                                            Text="{DynamicResource l.anime.status.watching}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Padding="10,6"
                                    Background="{DynamicResource SubtleFillColorSecondary}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                    BorderThickness="1"
                                    Command="{Binding $parent[UserControl].((vmSearch:SearchViewModel)DataContext).AddToPlanToWatchCommand}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <material:MaterialIcon
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource SearchAccentForegroundBrush}"
                                            Kind="CalendarClock" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource SearchAccentForegroundBrush}"
                                            Text="{DynamicResource l.anime.status.plan_to_watch}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Middle: Synopsis (Compacted)  -->
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,8"
                            VerticalAlignment="Top"
                            FontSize="12"
                            MaxLines="2"
                            Opacity="0.6"
                            Text="{Binding Presentation.DisplaySynopsis}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <!--  Bottom: Genres / Status  -->
                        <Grid
                            Grid.Row="2"
                            VerticalAlignment="Bottom"
                            ColumnDefinitions="*, Auto">
                            <!--  Genres  -->
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                MaxLines="1"
                                Opacity="0.4"
                                Text="{Binding Genres, Converter={StaticResource LocConverter}}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  Status  -->
                            <Border
                                Grid.Column="1"
                                Padding="7,3"
                                Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                CornerRadius="3"
                                IsVisible="{Binding Status, Converter={StaticResource StatusNotNoneConverter}}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding Status, Converter={StaticResource LocConverter}}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,4,20,16" RowDefinitions="Auto, *">

        <!--  Search Bar + Filters (1:1 with My List style)  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="8,6"
            Background="{DynamicResource SubtleFillColorSecondary}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnDefinitions="*, Auto">
                <!--  Search  -->
                <TextBox
                    Grid.Column="0"
                    Height="34"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="13"
                    PlaceholderText="{DynamicResource l.search.placeholder}"
                    Text="{Binding SearchQuery}">
                    <TextBox.InnerRightContent>
                        <material:MaterialIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            Kind="Magnify"
                            Opacity="0.3" />
                    </TextBox.InnerRightContent>
                </TextBox>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefault}" />

                    <!--  Hide in lists toggle  -->
                    <ToggleButton
                        Padding="8,6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        IsChecked="{Binding HideInLists}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                Kind="{Binding HideInLists, Converter={StaticResource LocConverter}, ConverterParameter='eye_logic'}"
                                Opacity="0.6" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{DynamicResource l.filters.options.hide_in_lists}" />
                        </StackPanel>
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked">
                                <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
                            </Style>
                            <Style Selector="ToggleButton:checked material|MaterialIcon">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                            <Style Selector="ToggleButton:checked TextBlock">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </ToggleButton.Styles>
                    </ToggleButton>

                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource DividerStrokeColorDefault}" />

                    <!--  Adult Filter cycle button  -->
                    <Button
                        Padding="8,6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CycleAdultFilterCommand}"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                Foreground="{Binding AdultFilter, Converter={StaticResource AdultColorConverter}}"
                                Kind="{Binding AdultFilter, Converter={StaticResource AdultIconConverter}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{Binding AdultFilter, Converter={StaticResource AdultColorConverter}}"
                                Text="{Binding DisplayAdultFilter}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Status & Results  -->
        <Panel Grid.Row="1">
            <!--  Loading / Empty State  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding !SearchResults.Count}"
                Spacing="16">
                <material:MaterialIcon
                    Width="64"
                    Height="64"
                    Kind="TextBoxSearchOutline"
                    Opacity="0.1" />
            </StackPanel>

            <!--  List of Results  -->
            <ListBox
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ContainerPrepared="ListBox_ContainerPrepared"
                IsVisible="{Binding SearchResults.Count}"
                ItemsSource="{Binding SearchResults}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="20,0,20,12" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="ClipToBounds" Value="True" />
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.2" />
                            </Transitions>
                        </Setter>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <StaticResource ResourceKey="SearchResultTemplate" />
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </Grid>
</UserControl>


