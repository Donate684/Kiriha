<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmStartup="using:Kiriha.ViewModels.Startup"
        xmlns:vmDialogs="using:Kiriha.ViewModels.Dialogs"
        xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
        xmlns:vmMain="using:Kiriha.ViewModels.Main"
        xmlns:vm="using:Kiriha.ViewModels"
             xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics"
             xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
             xmlns:vmAnimeList="using:Kiriha.ViewModels.AnimeList"
             xmlns:vmHistory="using:Kiriha.ViewModels.History"
             xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
             xmlns:vmSeasonal="using:Kiriha.ViewModels.Seasonal"
             xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
             xmlns:vmTorrents="using:Kiriha.ViewModels.Torrents"
             xmlns:vmSearch="using:Kiriha.ViewModels.Search"
        xmlns:controls="using:Kiriha.Views.Controls"
        xmlns:u="using:Kiriha.Utils.Graphs"
        xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:conv="using:Kiriha.Views.Converters"
        x:Class="Kiriha.Views.FranchiseGraphWindow"
        x:DataType="vmDialogs:FranchiseGraphViewModel"
        x:Name="Root"
        Title="Ð“Ñ€Ð°Ñ„ Ñ„Ñ€Ð°Ð½ÑˆÐ¸Ð·Ñ‹"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{x:Null}"
        TransparencyLevelHint="Mica, AcrylicBlur"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="34"
        WindowDecorations="BorderOnly">

    <Window.Resources>
        <conv:StatusNotNoneConverter x:Key="StatusNotNoneConverter"/>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:LocConverter x:Key="LocConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Height="34" VerticalAlignment="Top" Background="Transparent" IsHitTestVisible="True" PointerPressed="OnTitleBarPressed" ZIndex="10"/>
        
        <controls:TitleBarButtons Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="999"/>
        
        <TextBlock Grid.Row="0" Text="Ð“Ñ€Ð°Ñ„ Ñ„Ñ€Ð°Ð½ÑˆÐ¸Ð·Ñ‹" FontWeight="SemiBold" FontSize="14" Margin="16,8,0,0" IsHitTestVisible="False"/>

        <Grid Grid.Row="1" IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" CornerRadius="2" Foreground="{DynamicResource SystemAccentColor}"/>
                <TextBlock Text="Ð—Ð°Ð³Ñ€ÑƒÐ·ÐºÐ° ÑÑ‚Ñ€ÑƒÐºÑ‚ÑƒÑ€Ñ‹ Ñ„Ñ€Ð°Ð½ÑˆÐ¸Ð·Ñ‹..." Opacity="0.6" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Interactive Graph Container -->
        <Border Grid.Row="1" x:Name="GraphContainer" Background="Transparent" IsVisible="{Binding !IsLoading}"
                PointerPressed="OnGraphPointerPressed"
                PointerMoved="OnGraphPointerMoved"
                PointerReleased="OnGraphPointerReleased"
                PointerWheelChanged="OnGraphPointerWheelChanged"
                ClipToBounds="True">
            
            <Grid Width="{Binding Layout.Width}" Height="{Binding Layout.Height}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                
                <!-- Lines Layer -->
                <ItemsControl ItemsSource="{Binding Layout.Links}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="u:FranchiseGraphVisualLink">
                            <Path Data="{Binding ConnectionPath}"
                                  Stroke="{DynamicResource DividerStrokeColorDefault}" 
                                  StrokeThickness="2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nodes Layer -->
                <ItemsControl ItemsSource="{Binding Layout.Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{Binding Layout.Width}" Height="{Binding Layout.Height}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="u:FranchiseGraphVisualNode">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="u:FranchiseGraphVisualNode">
                            <Button Command="{Binding #Root.((vmDialogs:FranchiseGraphViewModel)DataContext).NodeClickedCommand}"
                                    CommandParameter="{Binding}"
                                    Width="{Binding NodeWidth}" Height="{Binding NodeHeight}" Padding="0" CornerRadius="12"
                                    Background="{DynamicResource CardBackgroundFillDefault}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                    </Style>
                                    <Style Selector="Button.current">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Style>
                                </Button.Styles>
                                <Button.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Button.Transitions>
                                <Classes.current>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsCurrent"/>
                                    </MultiBinding>
                                </Classes.current>
                                
                                <Grid ColumnDefinitions="80, *">
                                    <Border Grid.Column="0" CornerRadius="12,0,0,12" ClipToBounds="True">
                                        <Image asyncImageLoader:ImageLoader.Source="{Binding DisplayImageUrl}" Stretch="UniformToFill"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Node.Name}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        
                                        <Grid Margin="0,8,0,0" ColumnDefinitions="Auto, *, Auto">
                                            <!-- Left side: Year & Current label -->
                                            <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Node.Year}" FontSize="12" Opacity="0.6" IsVisible="{Binding Node.Year, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                <TextBlock Text="Ð¢ÐµÐºÑƒÑ‰ÐµÐµ" FontSize="11" Foreground="{DynamicResource SystemAccentColor}" FontWeight="Bold" IsVisible="{Binding IsCurrent}"/>
                                            </StackPanel>
                                            
                                            <!-- Right side: Kind & Status badges -->
                                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="{Binding Node.Kind}" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                                </Border>
                                                
                                                <Border Background="{Binding UserStatus, Converter={StaticResource StatusToColorConverter}}" CornerRadius="4" Padding="4,2" IsVisible="{Binding UserStatus, Converter={StaticResource StatusNotNoneConverter}}">
                                                    <TextBlock Text="{Binding UserStatus, Converter={StaticResource LocConverter}}" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
