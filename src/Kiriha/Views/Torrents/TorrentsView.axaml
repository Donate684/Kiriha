<UserControl
    x:Class="Kiriha.Views.Torrents.TorrentsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:local="using:Kiriha.Views.Torrents"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:modelsTorrServer="using:Kiriha.Core.Domain.Models.TorrServer"
    xmlns:u="using:Kiriha.Utils.UI"
    xmlns:vmTorrents="using:Kiriha.ViewModels.Torrents"
    x:Name="torrentsRoot"
    x:DataType="vmTorrents:TorrentsViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kiriha/Views/Torrents/TorrentTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Kiriha/Views/Torrents/TorrentStyles.axaml" />
    </UserControl.Styles>

    <Grid Margin="0" RowDefinitions="Auto, Auto, *">

        <!--  Row 0: Filters  -->
        <local:TorrentFilters Grid.Row="0" />

        <!--  Row 2: Sidebar + Results  -->
        <Grid
            Grid.Row="2"
            Margin="20,0,0,16"
            ColumnDefinitions="280, *">

            <!--  Sidebar  -->
            <Border
                Grid.Column="0"
                Margin="0,0,14,0"
                Padding="8,8,2,8"
                Background="{DynamicResource SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowDefinitions="Auto, *">
                    <!--  Header: title + count + Hide button  -->
                    <Grid
                        Grid.Row="0"
                        Margin="8,6,10,8"
                        ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Opacity="0.55"
                                Text="{DynamicResource l.torrents.sidebar.watching_now}" />
                            <Border
                                Padding="5,1"
                                Background="{DynamicResource SubtleFillColorTertiary}"
                                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsVisible="{Binding WatchingAnime.Count}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Opacity="0.65"
                                    Text="{Binding WatchingAnime.Count}" />
                            </Border>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Padding="6,3"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Classes.active="{Binding IsHideMode}"
                            Command="{Binding ToggleHideModeCommand}"
                            CornerRadius="6"
                            ToolTip.Tip="{DynamicResource l.torrents.sidebar.hide_menu_title}">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Opacity" Value="0.6" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Opacity" Value="0.9" />
                                </Style>
                                <Style Selector="Button.active">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
                                    <Setter Property="Opacity" Value="1" />
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon
                                    Width="14"
                                    Height="14"
                                    Foreground="{Binding $parent[Button].Foreground}"
                                    IsVisible="{Binding !IsHideMode}"
                                    Kind="EyeOffOutline" />
                                <material:MaterialIcon
                                    Width="14"
                                    Height="14"
                                    Foreground="{Binding $parent[Button].Foreground}"
                                    IsVisible="{Binding IsHideMode}"
                                    Kind="Check" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{Binding $parent[Button].Foreground}"
                                    IsVisible="{Binding !IsHideMode}"
                                    Text="{DynamicResource l.torrents.sidebar.hide_button}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding $parent[Button].Foreground}"
                                    IsVisible="{Binding IsHideMode}"
                                    Text="{DynamicResource l.torrents.sidebar.hide_done}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Watching list (close overlay in hide mode without shifting layout)  -->
                    <ScrollViewer
                        Grid.Row="1"
                        u:SmoothScroll.IsEnabled="True"
                        HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemTemplate="{StaticResource HideableAnimeItemTemplate}" ItemsSource="{Binding HideMenuItems}" />
                    </ScrollViewer>

                    <!--  Empty list  -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !WatchingAnime.Count}"
                        Opacity="0.4"
                        Spacing="10">
                        <material:MaterialIcon
                            Width="36"
                            Height="36"
                            Kind="PlaylistRemove" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="{DynamicResource l.torrents.sidebar.empty}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Results area  -->
            <Grid Grid.Column="1">

                <!--  Loading overlay  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsLoading}"
                    Spacing="14">
                    <material:MaterialIcon
                        Width="40"
                        Height="40"
                        Kind="Loading"
                        Opacity="0.55">
                        <material:MaterialIcon.Styles>
                            <Style Selector="material|MaterialIcon">
                                <Style.Animations>
                                    <Animation IterationCount="Infinite" Duration="0:0:1.2">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </material:MaterialIcon.Styles>
                    </material:MaterialIcon>
                </StackPanel>

                <!--  Empty state  -->
                <StackPanel
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.45"
                    Spacing="12">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsLoading" />
                            <Binding Path="IsEmptyResults" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <material:MaterialIcon
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        Kind="Download" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{DynamicResource l.torrents.results.empty.title}"
                        TextAlignment="Center" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="{DynamicResource l.torrents.results.empty.subtitle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Grouped results (Torrents mode)  -->
                <ScrollViewer
                    u:SmoothScroll.IsEnabled="True"
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding HasTorrentResults}"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater ItemsSource="{Binding GroupedTorrents}" ItemTemplate="{StaticResource TorrentGroupTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!--  Online results (Online mode)  -->
                <ScrollViewer
                    u:SmoothScroll.IsEnabled="True"
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding HasOnlineResults}"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater ItemsSource="{Binding OnlineResults}" ItemTemplate="{StaticResource OnlineAnimeItemTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  Episode Selector Dialog (Batch torrents)  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="{DynamicResource ModalOverlayBackgroundBrush}"
            IsVisible="{Binding IsEpisodeSelectorVisible}"
            ZIndex="60">
            <Grid>
                <!--  Click dim overlay to close  -->
                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Classes="DimOverlay"
                    Command="{Binding CloseEpisodeSelectorCommand}"
                    Focusable="False" />

                <!--  Modal card  -->
                <Border
                    MinWidth="480"
                    MaxWidth="640"
                    MaxHeight="520"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ModalBackgroundFill}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    BoxShadow="0 12 40 0 #66000000"
                    CornerRadius="16">
                    <Grid Margin="22" RowDefinitions="Auto, *, Auto">
                        <!--  Dialog Header  -->
                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,16"
                            ColumnDefinitions="Auto, *, Auto">
                            <material:MaterialIcon
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                Kind="FolderPlayOutline" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{DynamicResource l.torrents.results.actions.select_episode}" />
                                <TextBlock
                                    FontSize="11.5"
                                    Opacity="0.6"
                                    Text="{Binding ActiveStreamingTorrent.Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Width="30"
                                Height="30"
                                VerticalAlignment="Center"
                                Classes="IconAction"
                                Command="{Binding CloseEpisodeSelectorCommand}">
                                <material:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    Kind="Close"
                                    Opacity="0.7" />
                            </Button>
                        </Grid>

                        <!--  Content Area  -->
                        <Grid Grid.Row="1" MinHeight="160">
                            <!--  Loading State  -->
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsEpisodeSelectorLoading}"
                                Spacing="12">
                                <material:MaterialIcon
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource SystemAccentColor}"
                                    Kind="Loading">
                                    <material:MaterialIcon.Styles>
                                        <Style Selector="material|MaterialIcon">
                                            <Style.Animations>
                                                <Animation IterationCount="Infinite" Duration="0:0:1.2">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="RotateTransform.Angle" Value="0" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="RotateTransform.Angle" Value="360" />
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </material:MaterialIcon.Styles>
                                </material:MaterialIcon>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Text="{DynamicResource l.torrents.streaming.searching_files}"
                                    TextAlignment="Center" />
                            </StackPanel>

                            <!--  Error State  -->
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding EpisodeSelectorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Spacing="10">
                                <material:MaterialIcon
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource SystemErrorTextColor}"
                                    Kind="AlertCircleOutline" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource SystemErrorTextColor}"
                                    Text="{Binding EpisodeSelectorError}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Episode Files List  -->
                            <ScrollViewer
                                Margin="0,0,0,10"
                                u:SmoothScroll.IsEnabled="True"
                                HorizontalScrollBarVisibility="Disabled"
                                IsVisible="{Binding !IsEpisodeSelectorLoading}"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater ItemsSource="{Binding EpisodeFiles}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="0" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="modelsTorrServer:TorrServerFileItem">
                                            <Border
                                                Margin="0,3"
                                                Padding="12,10"
                                                Background="{DynamicResource SubtleFillColorSecondary}"
                                                Classes="TorrentCard"
                                                CornerRadius="8">
                                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                                    <material:MaterialIcon
                                                        Grid.Column="0"
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource SystemAccentColor}"
                                                        Kind="VideoOutline" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                        <TextBlock
                                                            FontSize="12.5"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding FileName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Opacity="0.55"
                                                            Text="{Binding FormattedSize}" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Classes="ActionPill PlayPill"
                                                        Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).SelectEpisodeFileCommand}"
                                                        CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <material:MaterialIcon
                                                                Width="13"
                                                                Height="13"
                                                                Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                Kind="Play" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                Text="{DynamicResource l.torrents.results.actions.play_btn}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>

                        <!--  Footer  -->
                        <Grid
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            ColumnDefinitions="*, Auto">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Opacity="0.5"
                                Text="{Binding EpisodeSelectorCountText}" />
                            <Button
                                Grid.Column="1"
                                Padding="16,6"
                                Classes="ActionPill"
                                Command="{Binding CloseEpisodeSelectorCommand}">
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="Medium"
                                    Text="{DynamicResource l.torrents.results.actions.cancel}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  Online Episode & Voiceover Selector Dialog Redesign  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="{DynamicResource ModalOverlayBackgroundBrush}"
            IsVisible="{Binding IsOnlineEpisodeSelectorVisible}"
            ZIndex="65">
            <Grid>
                <!--  Click dim overlay to close  -->
                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Classes="DimOverlay"
                    Command="{Binding CloseOnlineEpisodeSelectorCommand}"
                    Focusable="False" />

                <!--  Modal Dialog Window  -->
                <Border
                    Width="860"
                    Height="580"
                    MinWidth="780"
                    MaxWidth="920"
                    MaxHeight="620"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ModalBackgroundFill}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    BoxShadow="0 20 60 0 #90000000"
                    ClipToBounds="True"
                    CornerRadius="16">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <!--  ═══ Dialog Header ═══  -->
                        <Border
                            Grid.Row="0"
                            Padding="18,12"
                            Background="{DynamicResource ModalSidebarFill}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                                <!--  Anime Poster Thumbnail  -->
                                <Border
                                    Grid.Column="0"
                                    Width="42"
                                    Height="58"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondary}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="8">
                                    <Panel>
                                        <material:MaterialIcon
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ActiveOnlineAnime.ThumbnailUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                            Kind="Filmstrip"
                                            Opacity="0.3" />
                                        <Image asyncImageLoader:ImageLoader.Source="{Binding ActiveOnlineAnime.ThumbnailUrl}" Stretch="UniformToFill" />
                                    </Panel>
                                </Border>

                                <!--  Header Title & Metadata  -->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Text="{DynamicResource l.torrents.online.select_episode}" />

                                        <!--  Provider pill  -->
                                        <Border
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SubtleFillColorSecondary}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <TextBlock
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Opacity="0.8"
                                                Text="{Binding ActiveOnlineAnime.ProviderName}" />
                                        </Border>

                                        <!--  FHD Available Badge  -->
                                        <Border
                                            VerticalAlignment="Center"
                                            Classes="QualityBadgeFhd"
                                            IsVisible="{Binding ShowActiveOnlineFhdBadge}">
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <material:MaterialIcon
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AnalyticsSectionPurpleBrush}"
                                                    Kind="CheckDecagram" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource AnalyticsSectionPurpleBrush}"
                                                    Text="{DynamicResource l.torrents.online.fhd_available}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!--  Anime Title  -->
                                    <TextBlock
                                        FontSize="12.5"
                                        Opacity="0.65"
                                        Text="{Binding ActiveOnlineAnime.Title}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!--  Close Button  -->
                                <Button
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Classes="IconAction"
                                    Command="{Binding CloseOnlineEpisodeSelectorCommand}"
                                    CornerRadius="16">
                                    <material:MaterialIcon
                                        Width="18"
                                        Height="18"
                                        Kind="Close"
                                        Opacity="0.75" />
                                </Button>
                            </Grid>
                        </Border>

                        <!--  ═══ Content: Two-Pane Split (Episodes | Sources) ═══  -->
                        <Grid Grid.Row="1" ColumnDefinitions="310, *">
                            <!--  Loading State  -->
                            <StackPanel
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsOnlineEpisodeSelectorLoading}"
                                Spacing="12">
                                <material:MaterialIcon
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource SystemAccentColor}"
                                    Kind="Loading">
                                    <material:MaterialIcon.Styles>
                                        <Style Selector="material|MaterialIcon">
                                            <Style.Animations>
                                                <Animation IterationCount="Infinite" Duration="0:0:1.2">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="RotateTransform.Angle" Value="0" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="RotateTransform.Angle" Value="360" />
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </material:MaterialIcon.Styles>
                                </material:MaterialIcon>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Text="{DynamicResource l.torrents.online.resolving_stream}"
                                    TextAlignment="Center" />
                            </StackPanel>

                            <!--  Error State  -->
                            <StackPanel
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding OnlineEpisodeSelectorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Spacing="10">
                                <material:MaterialIcon
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource SystemErrorTextColor}"
                                    Kind="AlertCircleOutline" />
                                <TextBlock
                                    MaxWidth="440"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource SystemErrorTextColor}"
                                    Text="{Binding OnlineEpisodeSelectorError}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Left: Episodes Column  -->
                            <Border
                                Grid.Column="0"
                                Padding="10,12,8,12"
                                Background="{DynamicResource ModalSidebarFill}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                                BorderThickness="0,0,1,0"
                                IsVisible="{Binding !IsOnlineEpisodeSelectorLoading}">
                                <Grid RowDefinitions="Auto, *">
                                    <!--  Header  -->
                                    <Grid
                                        Grid.Row="0"
                                        Margin="4,0,4,10"
                                        ColumnDefinitions="*, Auto">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <material:MaterialIcon
                                                Width="15"
                                                Height="15"
                                                VerticalAlignment="Center"
                                                Kind="FormatListNumbered"
                                                Opacity="0.6" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Opacity="0.8"
                                                Text="{DynamicResource l.torrents.online.episodes_header}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SubtleFillColorSecondary}"
                                            CornerRadius="10">
                                            <TextBlock
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Opacity="0.7"
                                                Text="{Binding OnlineEpisodes.Count}" />
                                        </Border>
                                    </Grid>

                                    <!--  Episodes List  -->
                                    <ScrollViewer
                                        Grid.Row="1"
                                        Padding="0,0,10,0"
                                        u:SmoothScroll.IsEnabled="True"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater ItemsSource="{Binding OnlineEpisodes}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Vertical" Spacing="0" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vmTorrents:OnlineEpisodeItem">
                                                    <Button
                                                        Margin="0,2"
                                                        Classes="OnlineEpBtn"
                                                        Classes.selected="{Binding IsSelected}"
                                                        Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).SelectOnlineEpisodeCommand}"
                                                        CommandParameter="{Binding}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem
                                                                    Command="{Binding #torrentsRoot.((vmTorrents:TorrentsViewModel)DataContext).MarkEpisodeWatchedCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Header="{DynamicResource l.torrents.online.mark_watched}">
                                                                    <MenuItem.Icon>
                                                                        <material:MaterialIcon
                                                                            Width="15"
                                                                            Height="15"
                                                                            Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                            Kind="Check" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                                            <!--  Unselected Number Tile  -->
                                                            <Border
                                                                Grid.Column="0"
                                                                Width="28"
                                                                Height="24"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource SubtleFillColorSecondary}"
                                                                CornerRadius="6"
                                                                IsVisible="{Binding !IsSelected}">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    FontWeight="Bold"
                                                                    Opacity="0.75"
                                                                    Text="{Binding FormattedNumber}" />
                                                            </Border>

                                                            <!--  Selected Number Tile  -->
                                                            <Border
                                                                Grid.Column="0"
                                                                Width="28"
                                                                Height="24"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource SystemAccentColor}"
                                                                CornerRadius="6"
                                                                IsVisible="{Binding IsSelected}">
                                                                <TextBlock
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    FontWeight="Bold"
                                                                    Foreground="White"
                                                                    Text="{Binding FormattedNumber}" />
                                                            </Border>

                                                            <!--  Title & Status Badges  -->
                                                            <Grid
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                ColumnDefinitions="*, Auto">
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12"
                                                                    FontWeight="Medium"
                                                                    Text="{Binding DisplayTitle}"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <Panel
                                                                    Grid.Column="1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                    <!--  Watched Badge  -->
                                                                    <Border Classes="EpBadgeWatched" IsVisible="{Binding IsWatched}">
                                                                        <StackPanel
                                                                            VerticalAlignment="Center"
                                                                            Orientation="Horizontal"
                                                                            Spacing="3">
                                                                            <material:MaterialIcon
                                                                                Width="10.5"
                                                                                Height="10.5"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                                Kind="Check" />
                                                                            <TextBlock
                                                                                VerticalAlignment="Center"
                                                                                FontSize="9.5"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                                Text="{DynamicResource l.torrents.online.ep_watched}" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!--  New Badge  -->
                                                                    <Border Classes="EpBadgeNew" IsVisible="{Binding IsNew}">
                                                                        <TextBlock Classes="EpBadgeNewText" Text="{DynamicResource l.torrents.online.ep_new}" />
                                                                    </Border>
                                                                </Panel>
                                                            </Grid>

                                                            <!--  Selected Chevron  -->
                                                            <material:MaterialIcon
                                                                Grid.Column="2"
                                                                Width="14"
                                                                Height="14"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource SystemAccentColor}"
                                                                IsVisible="{Binding IsSelected}"
                                                                Kind="ChevronRight" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!--  Right: Dubs / Sources Column  -->
                            <Grid
                                Grid.Column="1"
                                Margin="16,12,16,12"
                                IsVisible="{Binding !IsOnlineEpisodeSelectorLoading}"
                                RowDefinitions="Auto, *">
                                <!--  Quick Filters: Dub / Sub (Centered)  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,10"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <!--  Dubbing  -->
                                    <Button
                                        Classes="OnlineFilterChip"
                                        Classes.active="{Binding IsFilterDubSelected}"
                                        Command="{Binding SetOnlineSourceFilterCommand}"
                                        CommandParameter="dub">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <material:MaterialIcon
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center"
                                                Kind="AccountVoice" />
                                            <TextBlock FontSize="11" Text="{DynamicResource l.torrents.online.filter_dub}" />
                                            <TextBlock
                                                FontSize="10.5"
                                                Opacity="0.75"
                                                Text="{Binding DubSourcesCount, StringFormat='({0})'}" />
                                        </StackPanel>
                                    </Button>

                                    <!--  Subtitles  -->
                                    <Button
                                        Classes="OnlineFilterChip"
                                        Classes.active="{Binding IsFilterSubSelected}"
                                        Command="{Binding SetOnlineSourceFilterCommand}"
                                        CommandParameter="sub">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <material:MaterialIcon
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AnalyticsSectionOrangeBrush}"
                                                Kind="Subtitles" />
                                            <TextBlock FontSize="11" Text="{DynamicResource l.torrents.online.filter_sub}" />
                                            <TextBlock
                                                FontSize="10.5"
                                                Opacity="0.75"
                                                Text="{Binding SubSourcesCount, StringFormat='({0})'}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!--  Sources loading spinner  -->
                                <StackPanel
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsOnlineSourcesLoading}"
                                    Spacing="8">
                                    <material:MaterialIcon
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource SystemAccentColor}"
                                        Kind="Loading">
                                        <material:MaterialIcon.Styles>
                                            <Style Selector="material|MaterialIcon">
                                                <Style.Animations>
                                                    <Animation IterationCount="Infinite" Duration="0:0:1.2">
                                                        <KeyFrame Cue="0%">
                                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </material:MaterialIcon.Styles>
                                    </material:MaterialIcon>
                                </StackPanel>

                                <!--  All sources hidden by quality filters empty state  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasNoDisplayedSources}"
                                    Spacing="8">
                                    <material:MaterialIcon
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Center"
                                        Kind="FilterOffOutline"
                                        Opacity="0.35" />
                                    <TextBlock
                                        MaxWidth="320"
                                        FontSize="12"
                                        Opacity="0.6"
                                        Text="{DynamicResource l.torrents.online.no_sources_filtered}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  Sources List  -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    Padding="0,0,10,0"
                                    u:SmoothScroll.IsEnabled="True"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!IsOnlineSourcesLoading" />
                                            <Binding Path="!HasNoDisplayedSources" />
                                        </MultiBinding>
                                    </ScrollViewer.IsVisible>
                                    <ItemsRepeater ItemsSource="{Binding DisplayedOnlineSources}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="0" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vmTorrents:OnlineSourceItem">
                                                <Border
                                                    Margin="0,3"
                                                    Classes="OnlineSourceCard"
                                                    Classes.direct="{Binding IsDirectMp4}">
                                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                                        <!--  Category Icon (Audio or Subtitles only)  -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="36"
                                                            Height="36"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource SubtleFillColorSecondary}"
                                                            CornerRadius="8">
                                                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <!--  Subtitles  -->
                                                                <material:MaterialIcon
                                                                    Width="18"
                                                                    Height="18"
                                                                    Foreground="{DynamicResource AnalyticsSectionOrangeBrush}"
                                                                    IsVisible="{Binding IsSubtitles}"
                                                                    Kind="Subtitles" />
                                                                <!--  Voice / Dubbing  -->
                                                                <material:MaterialIcon
                                                                    Width="18"
                                                                    Height="18"
                                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                                    IsVisible="{Binding !IsSubtitles}"
                                                                    Kind="AccountVoice" />
                                                            </Panel>
                                                        </Border>

                                                        <!--  Studio Name & Badges  -->
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="6">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding CleanStudioName}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip.Tip="{Binding Title}" />

                                                            <!--  FHD Badge  -->
                                                            <Border Classes="QualityBadgeFhd" IsVisible="{Binding IsFhd}">
                                                                <TextBlock
                                                                    FontSize="9.5"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource AnalyticsSectionPurpleBrush}"
                                                                    Text="{DynamicResource l.torrents.online.badge_fhd}" />
                                                            </Border>

                                                            <!--  HD Badge  -->
                                                            <Border Classes="QualityBadgeHd" IsVisible="{Binding IsHd}">
                                                                <TextBlock
                                                                    FontSize="9.5"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource AnalyticsSectionBlueBrush}"
                                                                    Text="{DynamicResource l.torrents.online.badge_hd}" />
                                                            </Border>

                                                            <!--  Other Quality Badge  -->
                                                            <Border Classes="QualityBadgeDefault">
                                                                <Border.IsVisible>
                                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                        <Binding Path="HasQuality" />
                                                                        <Binding Path="!IsFhd" />
                                                                        <Binding Path="!IsHd" />
                                                                    </MultiBinding>
                                                                </Border.IsVisible>
                                                                <TextBlock
                                                                    FontSize="9.5"
                                                                    FontWeight="Medium"
                                                                    Opacity="0.75"
                                                                    Text="{Binding QualityTag}" />
                                                            </Border>

                                                            <!--  Language Badge  -->
                                                            <Border Classes="TypeBadgeLang" IsVisible="{Binding HasLanguage}">
                                                                <TextBlock Text="{Binding LanguageDisplay}" />
                                                            </Border>

                                                            <!--  Direct CDN Badge  -->
                                                            <Border Classes="TypeBadgeDirect" IsVisible="{Binding IsDirectMp4}">
                                                                <TextBlock
                                                                    FontSize="9.5"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                    Text="{DynamicResource l.torrents.online.badge_direct}" />
                                                            </Border>

                                                            <!--  Subtitles Badge  -->
                                                            <Border Classes="TypeBadgeSub" IsVisible="{Binding IsSubtitles}">
                                                                <TextBlock
                                                                    FontSize="9.5"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource AnalyticsSectionOrangeBrush}"
                                                                    Text="{DynamicResource l.torrents.online.badge_subs}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!--  Play Button  -->
                                                        <Button
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Classes="OnlinePlayPill"
                                                            Classes.direct="{Binding IsDirectMp4}"
                                                            Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).PlayOnlineSourceCommand}"
                                                            CommandParameter="{Binding}">
                                                            <StackPanel
                                                                VerticalAlignment="Center"
                                                                Orientation="Horizontal"
                                                                Spacing="5">
                                                                <material:MaterialIcon
                                                                    Width="14"
                                                                    Height="14"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                    Kind="Play" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11.5"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                    Text="{DynamicResource l.torrents.online.play_btn}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!--  ═══ Dialog Footer ═══  -->
                        <Border
                            Grid.Row="2"
                            Padding="18,10"
                            Background="{DynamicResource ModalSidebarFill}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <material:MaterialIcon
                                        Width="15"
                                        Height="15"
                                        VerticalAlignment="Center"
                                        Kind="Filmstrip"
                                        Opacity="0.5" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Opacity="0.6"
                                        Text="{Binding OnlineEpisodeSelectorCountText}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Padding="18,6"
                                    Classes="ActionPill"
                                    Command="{Binding CloseOnlineEpisodeSelectorCommand}">
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="Medium"
                                        Text="{DynamicResource l.torrents.results.actions.cancel}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--  Player Launching Overlay  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="{DynamicResource ModalOverlayBackgroundBrush}"
            IsVisible="{Binding IsPlayerLaunching}"
            ZIndex="70">
            <Border
                MinWidth="360"
                MaxWidth="440"
                Margin="20"
                Padding="26,22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ModalBackgroundFill}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                BoxShadow="0 12 40 0 #66000000"
                CornerRadius="16">
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <material:MaterialIcon
                        Width="38"
                        Height="38"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Kind="Loading">
                        <material:MaterialIcon.Styles>
                            <Style Selector="material|MaterialIcon">
                                <Style.Animations>
                                    <Animation IterationCount="Infinite" Duration="0:0:1.2">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </material:MaterialIcon.Styles>
                    </material:MaterialIcon>

                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock
                            FontSize="15"
                            FontWeight="Bold"
                            Text="{DynamicResource l.torrents.streaming.launching_player}"
                            TextAlignment="Center" />
                        <TextBlock
                            MaxWidth="360"
                            FontSize="12"
                            Opacity="0.65"
                            Text="{Binding PlayerLaunchingTitle}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Margin="0,4,0,0"
                        Padding="20,6"
                        HorizontalAlignment="Center"
                        Classes="ActionPill"
                        Command="{Binding CancelPlayerLaunchingCommand}">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Medium"
                            Text="{DynamicResource l.torrents.results.actions.cancel}" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!--  Streaming Error Overlay (Single-episode torrents)  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="{DynamicResource ModalOverlayBackgroundBrush}"
            IsVisible="{Binding StreamingErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            ZIndex="75">
            <Grid>
                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Classes="DimOverlay"
                    Command="{Binding DismissStreamingErrorCommand}"
                    Focusable="False" />

                <Border
                    MinWidth="360"
                    MaxWidth="460"
                    Margin="20"
                    Padding="26,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ModalBackgroundFill}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    BoxShadow="0 12 40 0 #66000000"
                    CornerRadius="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="14">
                        <material:MaterialIcon
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource SystemErrorTextColor}"
                            Kind="AlertCircleOutline" />
                        <TextBlock
                            FontSize="15"
                            FontWeight="Bold"
                            Text="{DynamicResource l.common.errors.generic}"
                            TextAlignment="Center" />
                        <TextBlock
                            MaxWidth="380"
                            FontSize="12.5"
                            Opacity="0.85"
                            Text="{Binding StreamingErrorMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,4,0,0"
                            Padding="22,6"
                            HorizontalAlignment="Center"
                            Classes="ActionPill"
                            Command="{Binding DismissStreamingErrorCommand}">
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="Medium"
                                Text="{DynamicResource l.common.actions.close}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

