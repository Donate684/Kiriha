<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmStartup="using:Kiriha.ViewModels.Startup"
        xmlns:vmDialogs="using:Kiriha.ViewModels.Dialogs"
        xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
        xmlns:vmMain="using:Kiriha.ViewModels.Main"
             xmlns:vm="using:Kiriha.ViewModels"
             xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics"
             xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
             xmlns:vmAnimeList="using:Kiriha.ViewModels.AnimeList"
             xmlns:vmHistory="using:Kiriha.ViewModels.History"
             xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
             xmlns:vmSeasonal="using:Kiriha.ViewModels.Seasonal"
             xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
             xmlns:vmTorrents="using:Kiriha.ViewModels.Torrents"
             xmlns:vmSearch="using:Kiriha.ViewModels.Search"
             xmlns:models="using:Kiriha.Core.Domain.Models" xmlns:entities="using:Kiriha.Core.Domain.Models.Entities"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:conv="using:Kiriha.Views.Converters"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:u="using:Kiriha.Utils.UI"
             xmlns:modelsTorrServer="using:Kiriha.Core.Domain.Models.TorrServer"
             x:Class="Kiriha.Views.Torrents.TorrentsView"
             x:DataType="vmTorrents:TorrentsViewModel"
             xmlns:local="using:Kiriha.Views.Torrents">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kiriha/Views/Torrents/TorrentTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Kiriha/Views/Torrents/TorrentStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *" Margin="0">

        <!-- Row 0: Filters -->
        <local:TorrentFilters Grid.Row="0" />

        <!-- Row 2: Sidebar + Results -->
        <Grid Grid.Row="2" ColumnDefinitions="280, *" Margin="20,0,0,16">

            <!-- Sidebar -->
            <Border Grid.Column="0" Margin="0,0,14,0" Padding="8,8,2,8"
                    Background="{DynamicResource SubtleFillColorSecondary}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1"
                    CornerRadius="12">
                <Grid RowDefinitions="Auto, *">
                    <!-- Header: title + count + Hide button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="8,6,10,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource l.torrents.sidebar.watching_now}"
                                       FontSize="11" FontWeight="SemiBold" Opacity="0.55"
                                       VerticalAlignment="Center"/>
                            <Border CornerRadius="8" Padding="5,1"
                                    Background="{DynamicResource SubtleFillColorTertiary}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                    BorderThickness="1"
                                    IsVisible="{Binding WatchingAnime.Count}">
                                <TextBlock Text="{Binding WatchingAnime.Count}"
                                           FontSize="10" FontWeight="SemiBold" Opacity="0.65"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                Padding="6,3" CornerRadius="6"
                                VerticalAlignment="Center"
                                Classes.active="{Binding IsHideMode}"
                                Command="{Binding ToggleHideModeCommand}"
                                ToolTip.Tip="{DynamicResource l.torrents.sidebar.hide_menu_title}">
                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Style>
                                <Style Selector="Button.active">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon Width="14" Height="14" Kind="EyeOffOutline"
                                                       IsVisible="{Binding !IsHideMode}"
                                                       Foreground="{Binding $parent[Button].Foreground}"/>
                                <material:MaterialIcon Width="14" Height="14" Kind="Check"
                                                       IsVisible="{Binding IsHideMode}"
                                                       Foreground="{Binding $parent[Button].Foreground}"/>
                                <TextBlock FontSize="11" FontWeight="Medium" VerticalAlignment="Center"
                                           Foreground="{Binding $parent[Button].Foreground}"
                                           IsVisible="{Binding !IsHideMode}"
                                           Text="{DynamicResource l.torrents.sidebar.hide_button}"/>
                                <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding $parent[Button].Foreground}"
                                           IsVisible="{Binding IsHideMode}"
                                           Text="{DynamicResource l.torrents.sidebar.hide_done}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Watching list (close overlay in hide mode without shifting layout) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" u:SmoothScroll.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding HideMenuItems}" ItemTemplate="{StaticResource HideableAnimeItemTemplate}">
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty list -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsVisible="{Binding !WatchingAnime.Count}" Spacing="10" Opacity="0.4">
                        <material:MaterialIcon Kind="PlaylistRemove" Width="36" Height="36"/>
                        <TextBlock Text="{DynamicResource l.torrents.sidebar.empty}"
                                   FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results area -->
            <Grid Grid.Column="1">

                <!-- Loading overlay -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14"
                            IsVisible="{Binding IsLoading}">
                    <material:MaterialIcon Kind="Loading" Width="40" Height="40"
                                           Opacity="0.55">
                        <material:MaterialIcon.Styles>
                            <Style Selector="material|MaterialIcon">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.2" IterationCount="Infinite">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="360"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </material:MaterialIcon.Styles>
                    </material:MaterialIcon>
                </StackPanel>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="12" Opacity="0.45" MaxWidth="360">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsLoading"/>
                            <Binding Path="IsEmptyResults"/>
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <material:MaterialIcon Kind="Download" Width="48" Height="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource l.torrents.results.empty.title}"
                               FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{DynamicResource l.torrents.results.empty.subtitle}"
                               FontSize="12" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Grouped results (Torrents mode) -->
                <ScrollViewer u:SmoothScroll.IsEnabled="True"
                              IsVisible="{Binding HasTorrentResults}">
                    <ItemsControl ItemsSource="{Binding GroupedTorrents}" ItemTemplate="{StaticResource TorrentGroupTemplate}"/>
                </ScrollViewer>

                <!-- Online results (Online mode) -->
                <ScrollViewer u:SmoothScroll.IsEnabled="True"
                              IsVisible="{Binding HasOnlineResults}">
                    <ItemsControl ItemsSource="{Binding OnlineResults}" ItemTemplate="{StaticResource OnlineAnimeItemTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Episode Selector Dialog (Batch torrents) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource ModalOverlayBackgroundBrush}"
                IsVisible="{Binding IsEpisodeSelectorVisible}"
                ZIndex="60">
            <Border.Styles>
                <Style Selector="Button.DimOverlay">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </Border.Styles>

            <Grid>
                <!-- Click dim overlay to close -->
                <Button Classes="DimOverlay"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Focusable="False"
                        Command="{Binding CloseEpisodeSelectorCommand}"/>

                <!-- Modal card -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource ModalBackgroundFill}"
                        BorderBrush="{DynamicResource CardStrokeColorDefault}"
                        BorderThickness="1" CornerRadius="16"
                        MinWidth="480" MaxWidth="640" MaxHeight="520"
                        BoxShadow="0 12 40 0 #66000000"
                        Margin="20">
                    <Grid RowDefinitions="Auto, *, Auto" Margin="22">
                        <!-- Dialog Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                            <material:MaterialIcon Grid.Column="0" Kind="FolderPlayOutline" Width="24" Height="24"
                                                   Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{DynamicResource l.torrents.results.actions.select_episode}"
                                           FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ActiveStreamingTorrent.Title}"
                                           FontSize="11.5" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="IconAction"
                                    Width="30" Height="30"
                                    Command="{Binding CloseEpisodeSelectorCommand}"
                                    VerticalAlignment="Center">
                                <material:MaterialIcon Kind="Close" Width="16" Height="16" Opacity="0.7"/>
                            </Button>
                        </Grid>

                        <!-- Content Area -->
                        <Grid Grid.Row="1" MinHeight="160">
                            <!-- Loading State -->
                            <StackPanel IsVisible="{Binding IsEpisodeSelectorLoading}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="12">
                                <material:MaterialIcon Kind="Loading" Width="36" Height="36"
                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                       HorizontalAlignment="Center">
                                    <material:MaterialIcon.Styles>
                                        <Style Selector="material|MaterialIcon">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                                                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </material:MaterialIcon.Styles>
                                </material:MaterialIcon>
                                <TextBlock Text="{DynamicResource l.torrents.streaming.searching_files}"
                                           FontSize="13" FontWeight="Medium"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Error State -->
                            <StackPanel IsVisible="{Binding EpisodeSelectorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="10">
                                <material:MaterialIcon Kind="AlertCircleOutline" Width="30" Height="30"
                                                       Foreground="{DynamicResource SystemErrorTextColor}"
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EpisodeSelectorError}"
                                           FontSize="12" Foreground="{DynamicResource SystemErrorTextColor}"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Episode Files List -->
                            <ScrollViewer IsVisible="{Binding !IsEpisodeSelectorLoading}"
                                          u:SmoothScroll.IsEnabled="True" Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding EpisodeFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="modelsTorrServer:TorrServerFileItem">
                                            <Border Classes="TorrentCard" Margin="0,3" Padding="12,10" CornerRadius="8"
                                                    Background="{DynamicResource SubtleFillColorSecondary}">
                                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                                    <material:MaterialIcon Grid.Column="0" Kind="VideoOutline" Width="18" Height="18"
                                                                           Foreground="{DynamicResource SystemAccentColor}"
                                                                           VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FormattedSize}"
                                                                   FontSize="11" Opacity="0.55"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="ActionPill PlayPill"
                                                            Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).SelectEpisodeFileCommand}"
                                                            CommandParameter="{Binding}"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <material:MaterialIcon Kind="Play" Width="13" Height="13"
                                                                                   Foreground="{DynamicResource AnalyticsSectionGreenBrush}"/>
                                                            <TextBlock Text="{DynamicResource l.torrents.results.actions.play_btn}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Footer -->
                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding EpisodeSelectorCountText}"
                                       FontSize="11.5" Opacity="0.5" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ActionPill"
                                    Command="{Binding CloseEpisodeSelectorCommand}"
                                    Padding="16,6">
                                <TextBlock Text="{DynamicResource l.torrents.results.actions.cancel}"
                                           FontSize="11.5" FontWeight="Medium"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Online Episode & Voiceover Selector Dialog Redesign -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource ModalOverlayBackgroundBrush}"
                IsVisible="{Binding IsOnlineEpisodeSelectorVisible}"
                ZIndex="65">
            <Grid>
                <!-- Click dim overlay to close -->
                <Button Classes="DimOverlay"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Focusable="False"
                        Command="{Binding CloseOnlineEpisodeSelectorCommand}"/>

                <!-- Modal Dialog Window -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource ModalBackgroundFill}"
                        BorderBrush="{DynamicResource CardStrokeColorDefault}"
                        BorderThickness="1" CornerRadius="16"
                        Width="860" MinWidth="780" MaxWidth="920" Height="580" MaxHeight="620"
                        BoxShadow="0 20 60 0 #90000000"
                        ClipToBounds="True"
                        Margin="24">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <!-- ═══ Dialog Header ═══ -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource ModalSidebarFill}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                                BorderThickness="0,0,0,1"
                                Padding="18,12">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                                <!-- Anime Poster Thumbnail -->
                                <Border Grid.Column="0" Width="42" Height="58" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Panel>
                                        <material:MaterialIcon Kind="Filmstrip" Width="20" Height="20"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Opacity="0.3"
                                                               IsVisible="{Binding ActiveOnlineAnime.ThumbnailUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                        <Image asyncImageLoader:ImageLoader.Source="{Binding ActiveOnlineAnime.ThumbnailUrl}"
                                               Stretch="UniformToFill"/>
                                    </Panel>
                                </Border>

                                <!-- Header Title & Metadata -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource l.torrents.online.select_episode}"
                                                   FontSize="16" FontWeight="Bold"/>

                                        <!-- Provider pill -->
                                        <Border Background="{DynamicResource SubtleFillColorSecondary}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveOnlineAnime.ProviderName}"
                                                       FontSize="10.5" FontWeight="SemiBold" Opacity="0.8"/>
                                        </Border>

                                        <!-- FHD Available Badge -->
                                        <Border Classes="QualityBadgeFhd"
                                                IsVisible="{Binding IsAnimeLibLoggedIn}"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <material:MaterialIcon Kind="CheckDecagram" Width="12" Height="12"
                                                                       Foreground="{DynamicResource AnalyticsSectionPurpleBrush}"
                                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource l.torrents.online.fhd_available}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource AnalyticsSectionPurpleBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Anime Title -->
                                    <TextBlock Text="{Binding ActiveOnlineAnime.Title}"
                                               FontSize="12.5" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Close Button -->
                                <Button Grid.Column="2" Classes="IconAction"
                                        Width="32" Height="32" CornerRadius="16"
                                        Command="{Binding CloseOnlineEpisodeSelectorCommand}"
                                        VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="Close" Width="18" Height="18" Opacity="0.75"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ═══ Content: Two-Pane Split (Episodes | Sources) ═══ -->
                        <Grid Grid.Row="1" ColumnDefinitions="310, *">
                            <!-- Loading State -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2"
                                        IsVisible="{Binding IsOnlineEpisodeSelectorLoading}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="12">
                                <material:MaterialIcon Kind="Loading" Width="36" Height="36"
                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                       HorizontalAlignment="Center">
                                    <material:MaterialIcon.Styles>
                                        <Style Selector="material|MaterialIcon">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                                                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </material:MaterialIcon.Styles>
                                </material:MaterialIcon>
                                <TextBlock Text="{DynamicResource l.torrents.online.resolving_stream}"
                                           FontSize="13" FontWeight="Medium"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- Error State -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2"
                                        IsVisible="{Binding OnlineEpisodeSelectorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="10" Margin="20">
                                <material:MaterialIcon Kind="AlertCircleOutline" Width="32" Height="32"
                                                       Foreground="{DynamicResource SystemErrorTextColor}"
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding OnlineEpisodeSelectorError}"
                                           FontSize="12.5" Foreground="{DynamicResource SystemErrorTextColor}"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                            </StackPanel>

                            <!-- Left: Episodes Column -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource ModalSidebarFill}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                                    BorderThickness="0,0,1,0"
                                    Padding="10,12,8,12"
                                    IsVisible="{Binding !IsOnlineEpisodeSelectorLoading}">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Header -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="4,0,4,10">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <material:MaterialIcon Kind="FormatListNumbered" Width="15" Height="15"
                                                                   Opacity="0.6" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource l.torrents.online.episodes_header}"
                                                       FontSize="12" FontWeight="SemiBold" Opacity="0.8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondary}"
                                                CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OnlineEpisodes.Count}"
                                                       FontSize="10.5" FontWeight="Bold" Opacity="0.7"/>
                                        </Border>
                                    </Grid>

                                    <!-- Episodes List -->
                                    <ScrollViewer Grid.Row="1" u:SmoothScroll.IsEnabled="True" Padding="0,0,10,0">
                                        <ItemsControl ItemsSource="{Binding OnlineEpisodes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vmTorrents:OnlineEpisodeItem">
                                                    <Button Classes="OnlineEpBtn"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Margin="0,2"
                                                            Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).SelectOnlineEpisodeCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{DynamicResource l.torrents.online.mark_watched}"
                                                                          Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).MarkEpisodeWatchedCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <material:MaterialIcon Kind="Check" Width="15" Height="15"
                                                                                               Foreground="{DynamicResource AnalyticsSectionGreenBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                                            <!-- Unselected Number Tile -->
                                                            <Border Grid.Column="0" Width="28" Height="24" CornerRadius="6"
                                                                    Background="{DynamicResource SubtleFillColorSecondary}"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding !IsSelected}">
                                                                <TextBlock Text="{Binding FormattedNumber}"
                                                                           FontSize="11" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Opacity="0.75"/>
                                                            </Border>

                                                            <!-- Selected Number Tile -->
                                                            <Border Grid.Column="0" Width="28" Height="24" CornerRadius="6"
                                                                    Background="{DynamicResource SystemAccentColor}"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsSelected}">
                                                                <TextBlock Text="{Binding FormattedNumber}"
                                                                           FontSize="11" FontWeight="Bold" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Title & Status Badges -->
                                                            <Grid Grid.Column="1" ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                                           FontSize="12" FontWeight="Medium"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>

                                                                <Panel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                    <!-- Watched Badge -->
                                                                    <Border Classes="EpBadgeWatched" IsVisible="{Binding IsWatched}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                            <material:MaterialIcon Kind="Check" Width="10.5" Height="10.5"
                                                                                                   Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                                                   VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{DynamicResource l.torrents.online.ep_watched}"
                                                                                       FontSize="9.5" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- New Badge -->
                                                                    <Border Classes="EpBadgeNew" IsVisible="{Binding IsNew}">
                                                                        <TextBlock Classes="EpBadgeNewText"
                                                                                   Text="{DynamicResource l.torrents.online.ep_new}"/>
                                                                    </Border>
                                                                </Panel>
                                                            </Grid>

                                                            <!-- Selected Chevron -->
                                                            <material:MaterialIcon Grid.Column="2" Kind="ChevronRight"
                                                                                   Width="14" Height="14"
                                                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding IsSelected}"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Right: Dubs / Sources Column -->
                            <Grid Grid.Column="1" RowDefinitions="Auto, *" Margin="16,12,16,12"
                                  IsVisible="{Binding !IsOnlineEpisodeSelectorLoading}">
                                <!-- Quick Filters: Dub / Sub (Centered) -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,10">
                                    <!-- Dubbing -->
                                    <Button Classes="OnlineFilterChip"
                                            Classes.active="{Binding IsFilterDubSelected}"
                                            Command="{Binding SetOnlineSourceFilterCommand}"
                                            CommandParameter="dub">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <material:MaterialIcon Kind="AccountVoice" Width="12" Height="12"
                                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource l.torrents.online.filter_dub}" FontSize="11"/>
                                            <TextBlock Text="{Binding DubSourcesCount, StringFormat='({0})'}"
                                                       FontSize="10.5" Opacity="0.75"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Subtitles -->
                                    <Button Classes="OnlineFilterChip"
                                            Classes.active="{Binding IsFilterSubSelected}"
                                            Command="{Binding SetOnlineSourceFilterCommand}"
                                            CommandParameter="sub">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <material:MaterialIcon Kind="Subtitles" Width="12" Height="12"
                                                                   Foreground="{DynamicResource AnalyticsSectionOrangeBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource l.torrents.online.filter_sub}" FontSize="11"/>
                                            <TextBlock Text="{Binding SubSourcesCount, StringFormat='({0})'}"
                                                       FontSize="10.5" Opacity="0.75"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Sources loading spinner -->
                                <StackPanel Grid.Row="1" IsVisible="{Binding IsOnlineSourcesLoading}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <material:MaterialIcon Kind="Loading" Width="28" Height="28"
                                                           Foreground="{DynamicResource SystemAccentColor}"
                                                           HorizontalAlignment="Center">
                                        <material:MaterialIcon.Styles>
                                            <Style Selector="material|MaterialIcon">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:1.2" IterationCount="Infinite">
                                                        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                                        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </material:MaterialIcon.Styles>
                                    </material:MaterialIcon>
                                </StackPanel>

                                <!-- All sources hidden by quality filters empty state -->
                                <StackPanel Grid.Row="1" IsVisible="{Binding HasNoDisplayedSources}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="20">
                                    <material:MaterialIcon Kind="FilterOffOutline" Width="30" Height="30" Opacity="0.35"
                                                           HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource l.torrents.online.no_sources_filtered}"
                                               FontSize="12" Opacity="0.6" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Sources List -->
                                <ScrollViewer Grid.Row="1" u:SmoothScroll.IsEnabled="True" Padding="0,0,10,0">
                                    <ScrollViewer.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!IsOnlineSourcesLoading"/>
                                            <Binding Path="!HasNoDisplayedSources"/>
                                        </MultiBinding>
                                    </ScrollViewer.IsVisible>
                                    <ItemsControl ItemsSource="{Binding DisplayedOnlineSources}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmTorrents:OnlineSourceItem">
                                                <Border Classes="OnlineSourceCard"
                                                        Classes.direct="{Binding IsDirectMp4}"
                                                        Margin="0,3">
                                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                                        <!-- Category Icon (Audio or Subtitles only) -->
                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                                Background="{DynamicResource SubtleFillColorSecondary}"
                                                                VerticalAlignment="Center">
                                                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <!-- Subtitles -->
                                                                <material:MaterialIcon Kind="Subtitles" Width="18" Height="18"
                                                                                       Foreground="{DynamicResource AnalyticsSectionOrangeBrush}"
                                                                                       IsVisible="{Binding IsSubtitles}"/>
                                                                <!-- Voice / Dubbing -->
                                                                <material:MaterialIcon Kind="AccountVoice" Width="18" Height="18"
                                                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                                                       IsVisible="{Binding !IsSubtitles}"/>
                                                            </Panel>
                                                        </Border>

                                                        <!-- Studio Name & Badges -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CleanStudioName}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Title}"/>

                                                            <!-- FHD Badge -->
                                                            <Border Classes="QualityBadgeFhd" IsVisible="{Binding IsFhd}">
                                                                <TextBlock Text="{DynamicResource l.torrents.online.badge_fhd}"
                                                                           FontSize="9.5" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AnalyticsSectionPurpleBrush}"/>
                                                            </Border>

                                                            <!-- HD Badge -->
                                                            <Border Classes="QualityBadgeHd" IsVisible="{Binding IsHd}">
                                                                <TextBlock Text="{DynamicResource l.torrents.online.badge_hd}"
                                                                           FontSize="9.5" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AnalyticsSectionBlueBrush}"/>
                                                            </Border>

                                                            <!-- Other Quality Badge -->
                                                            <Border Classes="QualityBadgeDefault">
                                                                <Border.IsVisible>
                                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                        <Binding Path="HasQuality"/>
                                                                        <Binding Path="!IsFhd"/>
                                                                        <Binding Path="!IsHd"/>
                                                                    </MultiBinding>
                                                                </Border.IsVisible>
                                                                <TextBlock Text="{Binding QualityTag}"
                                                                           FontSize="9.5" FontWeight="Medium"
                                                                           Opacity="0.75"/>
                                                            </Border>

                                                            <!-- Language Badge -->
                                                            <Border Classes="TypeBadgeLang" IsVisible="{Binding HasLanguage}">
                                                                <TextBlock Text="{Binding LanguageDisplay}"/>
                                                            </Border>

                                                            <!-- Direct CDN Badge -->
                                                            <Border Classes="TypeBadgeDirect" IsVisible="{Binding IsDirectMp4}">
                                                                <TextBlock Text="{DynamicResource l.torrents.online.badge_direct}"
                                                                           FontSize="9.5" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AnalyticsSectionGreenBrush}"/>
                                                            </Border>

                                                            <!-- Subtitles Badge -->
                                                            <Border Classes="TypeBadgeSub" IsVisible="{Binding IsSubtitles}">
                                                                <TextBlock Text="{DynamicResource l.torrents.online.badge_subs}"
                                                                           FontSize="9.5" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AnalyticsSectionOrangeBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Play Button -->
                                                        <Button Grid.Column="2" Classes="OnlinePlayPill"
                                                                Classes.direct="{Binding IsDirectMp4}"
                                                                Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).PlayOnlineSourceCommand}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <material:MaterialIcon Kind="Play" Width="14" Height="14"
                                                                                       Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                                       VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource l.torrents.online.play_btn}"
                                                                           FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- ═══ Dialog Footer ═══ -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource ModalSidebarFill}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                                BorderThickness="0,1,0,0"
                                Padding="18,10">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="Filmstrip" Width="15" Height="15"
                                                           Opacity="0.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OnlineEpisodeSelectorCountText}"
                                               FontSize="11.5" Opacity="0.6" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ActionPill"
                                        Command="{Binding CloseOnlineEpisodeSelectorCommand}"
                                        Padding="18,6">
                                    <TextBlock Text="{DynamicResource l.torrents.results.actions.cancel}"
                                               FontSize="11.5" FontWeight="Medium"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Player Launching Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource ModalOverlayBackgroundBrush}"
                IsVisible="{Binding IsPlayerLaunching}"
                ZIndex="70">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ModalBackgroundFill}"
                    BorderBrush="{DynamicResource CardStrokeColorDefault}"
                    BorderThickness="1" CornerRadius="16"
                    MinWidth="360" MaxWidth="440"
                    BoxShadow="0 12 40 0 #66000000"
                    Padding="26,22" Margin="20">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <material:MaterialIcon Kind="Loading" Width="38" Height="38"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           HorizontalAlignment="Center">
                        <material:MaterialIcon.Styles>
                            <Style Selector="material|MaterialIcon">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.2" IterationCount="Infinite">
                                        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </material:MaterialIcon.Styles>
                    </material:MaterialIcon>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource l.torrents.streaming.launching_player}"
                                   FontSize="15" FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding PlayerLaunchingTitle}"
                                   FontSize="12" Opacity="0.65"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   MaxWidth="360"/>
                    </StackPanel>

                    <Button Classes="ActionPill"
                            HorizontalAlignment="Center"
                            Command="{Binding CancelPlayerLaunchingCommand}"
                            Padding="20,6" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource l.torrents.results.actions.cancel}"
                                   FontSize="11.5" FontWeight="Medium"/>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

