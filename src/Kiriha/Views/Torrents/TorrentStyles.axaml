<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia">
        <!-- ═══ Filter Toggle inline chip (used in Flyout) ═══ -->
        <Style Selector="ToggleButton.FilterChip">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.FilterChip:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
        </Style>
        <Style Selector="ToggleButton.FilterChip:checked">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- ═══ Active filter chip (removable) ═══ -->
        <Style Selector="Border.ActiveChip">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4,4,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ChipClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ChipClose:pointerover">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>

        <!-- ═══ Sidebar item (Button) ═══ -->
        <Style Selector="Button.WatchItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.WatchItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.WatchItem.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.WatchItem.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Border.WatchItem.hidden">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- ═══ Torrent Card ═══ -->
        <Style Selector="Border.TorrentCard">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.TorrentCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorSecondary}"/>
        </Style>
        <Style Selector="Border.TorrentCard.matched">
            <Setter Property="BorderBrush" Value="{DynamicResource OrangeredAccentBrush}"/>
        </Style>
        <Style Selector="Border.TorrentCard.matched:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OrangeredAccentBrush}"/>
        </Style>

        <!-- ═══ Quality / group chip inline ═══ -->
        <Style Selector="Border.MetaChip">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.GroupChip">
            <Setter Property="Background" Value="#1A2E9D62"/>
            <Setter Property="BorderBrush" Value="#552E9D62"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.P1080Chip">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.BatchChip">
            <Setter Property="Background" Value="{DynamicResource AnalyticsSectionPurpleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Action Pill Button (Magnet & .torrent) ═══ -->
        <Style Selector="Button.ActionPill">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ActionPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorSecondary}"/>
        </Style>
        <Style Selector="Button.ActionPill.MagnetPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="Button.ActionPill.PlayPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AnalyticsSectionGreenBrush}"/>
        </Style>

        <!-- ═══ Download icon button ═══ -->
        <Style Selector="Button.IconAction">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
        </Style>

        <!-- ═══ Sort Pill (reuse global Pill visuals but smaller) ═══ -->
        <Style Selector="ComboBox.SortCombo">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ═══ Filter flyout presenter (Luxury/Glass style) ═══ -->
        <Style Selector="FlyoutPresenter.FilterFlyout, FlyoutPresenter.SourcesFlyout">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <!-- Semi-transparent background + shadow for depth -->
            <Setter Property="Background" Value="{DynamicResource LuxuryFlyoutBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LuxuryFlyoutBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="FlyoutPresenter.FilterFlyout ScrollViewer, FlyoutPresenter.SourcesFlyout ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- ═══ Filter notification banner ═══ -->
        <Style Selector="Border.FilterNotice">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- ═══ Search Query Preview box ═══ -->
        <Style Selector="Border.PreviewBox">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- ═══ Custom query input box ═══ -->
        <Style Selector="TextBox.CustomQueryInput">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- ═══ Filter toggle row ═══ -->
        <Style Selector="ToggleButton.FilterToggle, Button.FilterToggle">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiary}"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.FilterToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.FilterToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
        </Style>
        <Style Selector="ToggleButton.FilterToggle:checked, Button.FilterToggle.active">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.FilterToggle:checked /template/ ContentPresenter#PART_ContentPresenter, Button.FilterToggle.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.FilterToggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.FilterToggle.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.FilterToggle:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.FilterToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <!-- Switch indicator inside toggle -->
        <Style Selector="ToggleButton.FilterToggle Border.SwitchTrack, Button.FilterToggle Border.SwitchTrack">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#55808080"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.FilterToggle:checked Border.SwitchTrack, Button.FilterToggle.active Border.SwitchTrack">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="ToggleButton.FilterToggle Ellipse.SwitchThumb, Button.FilterToggle Ellipse.SwitchThumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.FilterToggle:checked Ellipse.SwitchThumb, Button.FilterToggle.active Ellipse.SwitchThumb">
            <Setter Property="Margin" Value="17,0,0,0"/>
        </Style>

        <!-- Reset button inside flyout -->
        <Style Selector="Button.FilterReset">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.FilterReset:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.FilterReset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
        </Style>
        <Style Selector="Button.FilterReset:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- Section label -->
        <Style Selector="TextBlock.FlyoutSection">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
            <Setter Property="Margin" Value="2,0,0,2"/>
        </Style>

        <!-- ═══ Search Mode (Torrents / Online) Capsule Toggle ═══ -->
        <Style Selector="ToggleButton.TorrentsModeToggle">
            <Setter Property="Width" Value="184"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource SubtleFillColorTertiary}"
                            BorderBrush="{DynamicResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <Panel>
                            <Border x:Name="Thumb"
                                    Background="{DynamicResource CardBackgroundFillDefault}"
                                    CornerRadius="12"
                                    Width="88" Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"
                                    BoxShadow="0 1 4 0 #18000000, 0 0 0 0.5 #14000000">
                                <Border.Transitions>
                                    <Transitions>
                                        <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="Magnet" Width="14" Height="14" x:Name="IconLeft"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center">
                                        <material:MaterialIcon.Transitions>
                                            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                        </material:MaterialIcon.Transitions>
                                    </material:MaterialIcon>
                                    <TextBlock Text="{DynamicResource l.torrents.mode.torrents}" FontSize="12" FontWeight="SemiBold"
                                               x:Name="TextLeft" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <TextBlock.Transitions>
                                            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                        </TextBlock.Transitions>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="TelevisionPlay" Width="14" Height="14" x:Name="IconRight"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center">
                                        <material:MaterialIcon.Transitions>
                                            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                        </material:MaterialIcon.Transitions>
                                    </material:MaterialIcon>
                                    <TextBlock Text="{DynamicResource l.torrents.mode.online}" FontSize="12"
                                               x:Name="TextRight" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Transitions>
                                            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                        </TextBlock.Transitions>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.TorrentsModeToggle:checked /template/ Border#Thumb">
            <Setter Property="Margin" Value="92,0,0,0"/>
        </Style>

        <Style Selector="ToggleButton.TorrentsModeToggle:checked /template/ material|MaterialIcon#IconLeft">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.TorrentsModeToggle:checked /template/ TextBlock#TextLeft">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style Selector="ToggleButton.TorrentsModeToggle:checked /template/ material|MaterialIcon#IconRight">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.TorrentsModeToggle:checked /template/ TextBlock#TextRight">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ToggleButton.TorrentsModeToggle:pointerover /template/ Border#Thumb">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
        </Style>

        <!-- ═══ Online Episode Selector Redesign Styles ═══ -->
        <Style Selector="Button.OnlineEpBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.OnlineEpBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
        </Style>
        <Style Selector="Button.OnlineEpBtn.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
        </Style>
        <Style Selector="Button.OnlineEpBtn.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorSecondary}"/>
        </Style>

        <!-- Online Source Card -->
        <Style Selector="Border.OnlineSourceCard">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.OnlineSourceCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorSecondary}"/>
        </Style>
        <Style Selector="Border.OnlineSourceCard.direct">
            <Setter Property="BorderBrush" Value="#3300C853"/>
        </Style>
        <Style Selector="Border.OnlineSourceCard.direct:pointerover">
            <Setter Property="BorderBrush" Value="#8000C853"/>
        </Style>

        <!-- Online Filter Chip -->
        <Style Selector="Button.OnlineFilterChip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.OnlineFilterChip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
        </Style>
        <Style Selector="Button.OnlineFilterChip.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="Button.OnlineFilterChip.active">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Online Play Pill Button -->
        <Style Selector="Button.OnlinePlayPill">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.OnlinePlayPill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorSecondary}"/>
        </Style>
        <Style Selector="Button.OnlinePlayPill.direct">
            <Setter Property="Background" Value="#1F00C853"/>
            <Setter Property="BorderBrush" Value="#4D00C853"/>
        </Style>
        <Style Selector="Button.OnlinePlayPill.direct:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3300C853"/>
            <Setter Property="BorderBrush" Value="#8000C853"/>
        </Style>

        <!-- Badges -->
        <Style Selector="Border.QualityBadgeFhd">
            <Setter Property="Background" Value="#227B61FF"/>
            <Setter Property="BorderBrush" Value="#557B61FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.QualityBadgeHd">
            <Setter Property="Background" Value="#222D7DD2"/>
            <Setter Property="BorderBrush" Value="#552D7DD2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.QualityBadgeDefault">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.TypeBadgeDirect">
            <Setter Property="Background" Value="#2200C853"/>
            <Setter Property="BorderBrush" Value="#5500C853"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.TypeBadgeSub">
            <Setter Property="Background" Value="#22FFB300"/>
            <Setter Property="BorderBrush" Value="#55FFB300"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.TypeBadgeLang">
            <Setter Property="Background" Value="#2200BCD4"/>
            <Setter Property="BorderBrush" Value="#5500BCD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.TypeBadgeLang > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AnalyticsSectionTealBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Episode Item Badges -->
        <Style Selector="Border.EpBadgeWatched">
            <Setter Property="Background" Value="#1A00C853"/>
            <Setter Property="BorderBrush" Value="#3800C853"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.EpBadgeNew">
            <Setter Property="Background" Value="#22FF4500"/>
            <Setter Property="BorderBrush" Value="#55FF4500"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.EpBadgeNewText">
            <Setter Property="Foreground" Value="#FFFF4500"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Provider Badges on Online Search Results (Matches GroupChip) ═══ -->
        <Style Selector="Border.ProviderBadge">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.ProviderBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- AniLibria: Brand Crimson Red -->
        <Style Selector="Border.ProviderBadge.anilibria">
            <Setter Property="Background" Value="#1AE53935"/>
            <Setter Property="BorderBrush" Value="#55E53935"/>
        </Style>
        <Style Selector="Border.ProviderBadge.anilibria TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AnalyticsSectionRedBrush}"/>
        </Style>

        <!-- AnimeLib: Brand Purple -->
        <Style Selector="Border.ProviderBadge.animelib">
            <Setter Property="Background" Value="#1A7B61FF"/>
            <Setter Property="BorderBrush" Value="#557B61FF"/>
        </Style>
        <Style Selector="Border.ProviderBadge.animelib TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AnalyticsSectionPurpleBrush}"/>
        </Style>

        <!-- DreamCast: Brand Warm Amber / Orange -->
        <Style Selector="Border.ProviderBadge.dreamcast">
            <Setter Property="Background" Value="#1AD17A22"/>
            <Setter Property="BorderBrush" Value="#55D17A22"/>
        </Style>
        <Style Selector="Border.ProviderBadge.dreamcast TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AnalyticsSectionOrangeBrush}"/>
        </Style>

        <!-- YummyAnime: Brand Deep Teal -->
        <Style Selector="Border.ProviderBadge.yummyanime">
            <Setter Property="Background" Value="#1A0F7B83"/>
            <Setter Property="BorderBrush" Value="#550F7B83"/>
        </Style>
        <Style Selector="Border.ProviderBadge.yummyanime TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AnalyticsSectionTealBrush}"/>
        </Style>

        <!-- Anime 365: Brand Forest Green (identical to GroupChip) -->
        <Style Selector="Border.ProviderBadge.anime365">
            <Setter Property="Background" Value="#1A2E9D62"/>
            <Setter Property="BorderBrush" Value="#552E9D62"/>
        </Style>
        <Style Selector="Border.ProviderBadge.anime365 TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AnalyticsSectionGreenBrush}"/>
        </Style>
</Styles>
