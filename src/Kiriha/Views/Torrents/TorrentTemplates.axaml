<ResourceDictionary
    x:Class="Kiriha.Views.Torrents.TorrentTemplates"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kiriha.Views.Controls"
    xmlns:core="using:Kiriha.Core"
    xmlns:entities="using:Kiriha.Core.Domain.Models.Entities"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmTorrents="using:Kiriha.ViewModels.Torrents">
    <DataTemplate x:Key="HideableAnimeItemTemplate" DataType="vmTorrents:HideableAnimeItem">
        <Grid Margin="0,0,14,2" Classes.row-hidden="{Binding IsHidden}">
            <Grid.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="$parent[ItemsControl].((vmTorrents:TorrentsViewModel)DataContext).IsHideMode" />
                    <Binding Path="!IsHidden" />
                </MultiBinding>
            </Grid.IsVisible>
            <Grid.Styles>
                <Style Selector="Grid.row-hidden">
                    <Setter Property="Opacity" Value="0.4" />
                </Style>
            </Grid.Styles>

            <!--  Card (selectable)  -->
            <Button
                Classes="WatchItem"
                Classes.selected="{Binding IsSelected}"
                Command="{Binding $parent[ItemsControl].((vmTorrents:TorrentsViewModel)DataContext).SelectAnimeCommand}"
                CommandParameter="{Binding Anime}">
                <Grid ColumnDefinitions="50, *" ColumnSpacing="10">
                    <Panel
                        Grid.Column="0"
                        Width="50"
                        Height="72"
                        VerticalAlignment="Top">
                        <Border
                            Background="{DynamicResource SubtleFillColorTertiary}"
                            ClipToBounds="True"
                            CornerRadius="6">
                            <Image core:CachedImage.Source="{Binding Anime.PosterSource}" Stretch="UniformToFill" />
                        </Border>

                        <!--  New episodes badge  -->
                        <Border
                            Margin="0,3,3,0"
                            Padding="5,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource TorrentRedBrush}"
                            BoxShadow="0 2 6 0 #55000000"
                            CornerRadius="6"
                            IsVisible="{Binding Anime.Presentation.ShowAiredProgressBar}"
                            ToolTip.Tip="{DynamicResource l.torrents.sidebar.new_episodes_tooltip}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Anime.Presentation.UnseenEpisodesCount, StringFormat='+{0}'}" />
                        </Border>
                    </Panel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemBaseHighColor}"
                            LineHeight="15"
                            MaxLines="2"
                            Text="{Binding Anime.Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="10"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            IsVisible="{Binding Anime.RussianTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            LineHeight="13"
                            MaxLines="1"
                            Text="{Binding Anime.RussianTitle}"
                            TextTrimming="CharacterEllipsis" />

                        <!--  Progress Display & Segmented Progress Bar  -->
                        <controls:SegmentedProgressBar
                            Margin="0,5,0,3"
                            HorizontalAlignment="Stretch"
                            AccentBrush="{DynamicResource SystemAccentColor}"
                            Aired="{Binding Anime.Presentation.ResolvedAiredEpisodes}"
                            AiredBrush="{DynamicResource TorrentRedBrush}"
                            Current="{Binding Anime.Presentation.EffectiveProgress}"
                            IsVisible="{Binding Anime.Presentation.ShowProgress}"
                            Total="{Binding Anime.Presentation.EffectiveTotal}"
                            TrackBrush="{DynamicResource SegmentedTrackBrush}" />

                        <TextBlock
                            FontSize="10"
                            Opacity="0.55"
                            Text="{Binding Anime.Presentation.ProgressDisplay}" />
                    </StackPanel>
                </Grid>
            </Button>

            <!--  × / + overlay (hide mode only)  -->
            <Button
                Width="24"
                Height="24"
                Margin="0,6,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{DynamicResource SubtleFillColorSecondary}"
                Classes="IconAction"
                Command="{Binding $parent[ItemsControl].((vmTorrents:TorrentsViewModel)DataContext).ToggleHideAnimeCommand}"
                CommandParameter="{Binding}"
                IsVisible="{Binding $parent[ItemsControl].((vmTorrents:TorrentsViewModel)DataContext).IsHideMode}">
                <Panel>
                    <material:MaterialIcon
                        Width="14"
                        Height="14"
                        Foreground="{DynamicResource TorrentRedBrush}"
                        IsVisible="{Binding !IsHidden}"
                        Kind="Close" />
                    <material:MaterialIcon
                        Width="14"
                        Height="14"
                        Foreground="{DynamicResource SystemAccentColor}"
                        IsVisible="{Binding IsHidden}"
                        Kind="Plus" />
                </Panel>
            </Button>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TorrentGroupTemplate" DataType="vmTorrents:TorrentGroup">
        <Border
            Margin="0,0,14,16"
            Padding="14,12"
            Background="{DynamicResource CardBackgroundFillSecondary}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="10">
                <!--  Group header  -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Border
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource OrangeredAccentTintBrush}"
                            BorderBrush="{DynamicResource OrangeredAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsVisible="{Binding HasMatch}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon
                                    Width="12"
                                    Height="12"
                                    Foreground="{DynamicResource OrangeredAccentBrush}"
                                    Kind="BellRingOutline" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource OrangeredAccentBrush}"
                                    LetterSpacing="0.4"
                                    Text="{DynamicResource l.torrents.results.in_list}" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding AnimeTitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--  Release count pill  -->
                    <Border
                        Grid.Column="1"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondary}"
                        BorderBrush="{DynamicResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Medium"
                            Opacity="0.65"
                            Text="{Binding Count, Converter={StaticResource LocConverter}, ConverterParameter=format:l.torrents.results.group_count}" />
                    </Border>
                </Grid>

                <!--  Divider line  -->
                <Border
                    Height="1"
                    Margin="0,0,0,2"
                    Background="{DynamicResource DividerStrokeColorDefault}" />

                <!--  Items  -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="entities:TorrentEntity">
                            <Border
                                Margin="0,3"
                                Classes="TorrentCard"
                                Classes.matched="{Binding IsMatched}">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">

                                    <!--  Left Accent Bar for Matched  -->
                                    <Border
                                        Grid.Column="0"
                                        Width="3"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource OrangeredAccentBrush}"
                                        CornerRadius="2"
                                        IsVisible="{Binding IsMatched}" />

                                    <!--  Center Info Area  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="5">
                                        <!--  Title  -->
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Text="{Binding DisplayTitle}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Title}" />

                                        <!--  Metadata chips & stats  -->
                                        <WrapPanel
                                            VerticalAlignment="Center"
                                            ItemWidth="NaN"
                                            Orientation="Horizontal">
                                            <!--  Release Group Chip  -->
                                            <Border
                                                Margin="0,0,6,0"
                                                Classes="GroupChip"
                                                IsVisible="{Binding ReleaseGroup, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                    Text="{Binding ReleaseGroup}" />
                                            </Border>

                                            <!--  Resolution Chip: 1080p highlighted  -->
                                            <Border
                                                Margin="0,0,6,0"
                                                Classes="P1080Chip"
                                                IsVisible="{Binding Is1080p}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    Text="{Binding Resolution}" />
                                            </Border>

                                            <!--  Other Resolution (e.g. 720p)  -->
                                            <Border
                                                Margin="0,0,6,0"
                                                Classes="MetaChip"
                                                IsVisible="{Binding IsOtherResolution}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="Medium"
                                                    Text="{Binding Resolution}" />
                                            </Border>

                                            <!--  Batch Chip  -->
                                            <Border
                                                Margin="0,0,6,0"
                                                Classes="BatchChip"
                                                IsVisible="{Binding IsBatch}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <material:MaterialIcon
                                                        Width="11"
                                                        Height="11"
                                                        Foreground="White"
                                                        Kind="PackageVariant" />
                                                    <TextBlock
                                                        FontSize="9"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{DynamicResource l.torrents.results.batch_badge}" />
                                                </StackPanel>
                                            </Border>

                                            <!--  Episode Chip (if not batch)  -->
                                            <Border
                                                Margin="0,0,6,0"
                                                Classes="MetaChip"
                                                IsVisible="{Binding ShowEpisodeBadge}">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Episode, Converter={StaticResource LocConverter}, ConverterParameter=format:l.torrents.results.episode_prefix}" />
                                            </Border>

                                            <!--  File Size Chip  -->
                                            <Border
                                                Margin="0,0,6,0"
                                                Classes="MetaChip"
                                                IsVisible="{Binding FormattedSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <material:MaterialIcon
                                                        Width="11"
                                                        Height="11"
                                                        Kind="Harddisk"
                                                        Opacity="0.55" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Medium"
                                                        Opacity="0.8"
                                                        Text="{Binding FormattedSize}" />
                                                </StackPanel>
                                            </Border>

                                            <!--  Seeders & Leechers  -->
                                            <Border
                                                Margin="0,0,6,0"
                                                Classes="MetaChip"
                                                IsVisible="{Binding HasSeeders}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <material:MaterialIcon
                                                        Width="10"
                                                        Height="10"
                                                        Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                        Kind="ArrowUpBold" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                        Text="{Binding Seeders}" />
                                                    <material:MaterialIcon
                                                        Width="10"
                                                        Height="10"
                                                        Margin="2,0,0,0"
                                                        Foreground="{DynamicResource AnalyticsSectionOrangeBrush}"
                                                        Kind="ArrowDownBold" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Opacity="0.55"
                                                        Text="{Binding Leechers}" />
                                                </StackPanel>
                                            </Border>

                                            <!--  Date  -->
                                            <StackPanel
                                                Margin="2,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="3">
                                                <material:MaterialIcon
                                                    Width="11"
                                                    Height="11"
                                                    Kind="ClockOutline"
                                                    Opacity="0.4" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Opacity="0.5"
                                                    Text="{Binding PublishDate, StringFormat='{}{0:dd MMM HH:mm}'}" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!--  Right Action Buttons  -->
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <!--  Play Online Button  -->
                                        <Button
                                            Classes="ActionPill PlayPill"
                                            Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).PlayTorrentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{DynamicResource l.torrents.results.actions.play_tooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                    Kind="Play" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                                    Text="{DynamicResource l.torrents.results.actions.play_btn}" />
                                            </StackPanel>
                                        </Button>

                                        <!--  Magnet Button  -->
                                        <Button
                                            Classes="ActionPill MagnetPill"
                                            Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).DownloadMagnetCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding MagnetLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            ToolTip.Tip="{DynamicResource l.torrents.results.actions.download_magnet}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    Kind="Magnet" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    Text="{DynamicResource l.torrents.results.actions.magnet_btn}" />
                                            </StackPanel>
                                        </Button>

                                        <!--  Download .torrent Button  -->
                                        <Button
                                            Classes="ActionPill TorrentPill"
                                            Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).DownloadTorrentFileCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding DownloadLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            ToolTip.Tip="{DynamicResource l.torrents.results.actions.download_file}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon
                                                    Width="14"
                                                    Height="14"
                                                    Kind="Download" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="{DynamicResource l.torrents.results.actions.torrent_btn}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="OnlineAnimeItemTemplate" DataType="vmTorrents:OnlineAnimeItem">
        <Border
            Margin="0,0,16,8"
            Padding="12,10"
            Classes="TorrentCard">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                <!--  Thumbnail Poster  -->
                <Border
                    Grid.Column="0"
                    Width="48"
                    Height="68"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillColorTertiary}"
                    ClipToBounds="True"
                    CornerRadius="6">
                    <Image core:CachedImage.Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                </Border>

                <!--  Info: Title and Provider Badge  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        MaxLines="2"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />

                    <!--  Provider badge matching torrent GroupChip style  -->
                    <Border
                        Classes="ProviderBadge"
                        Classes.anilibria="{Binding IsAniLibria}"
                        Classes.anime365="{Binding IsAnime365}"
                        Classes.animelib="{Binding IsAnimeLib}"
                        Classes.dreamcast="{Binding IsDreamCast}"
                        Classes.yummyanime="{Binding IsYummyAnime}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Text="{Binding DisplayProviderName}" />
                    </Border>
                </StackPanel>

                <!--  Action Button: Open Details / Episodes  -->
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Classes="ActionPill PlayPill"
                    Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).OpenOnlineAnimeCommand}"
                    CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <material:MaterialIcon
                            Width="14"
                            Height="14"
                            Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                            Kind="Play" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                            Text="{DynamicResource l.torrents.online.play_btn}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
