<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="using:Kiriha.Core.Domain.Models" xmlns:entities="using:Kiriha.Core.Domain.Models.Entities"
                    xmlns:material="using:Material.Icons.Avalonia"
                    xmlns:core="using:Kiriha.Core"
                    xmlns:u="using:Kiriha.Utils.UI"
                    xmlns:controls="using:Kiriha.Views.Controls"
                    xmlns:vmTorrents="using:Kiriha.ViewModels.Torrents"
                    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
                    x:Class="Kiriha.Views.Torrents.TorrentTemplates">
    <DataTemplate x:Key="HideableAnimeItemTemplate" DataType="vmTorrents:HideableAnimeItem">
        <Grid Margin="0,0,14,2" Classes.row-hidden="{Binding IsHidden}">
            <Grid.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="$parent[ItemsControl].((vmTorrents:TorrentsViewModel)DataContext).IsHideMode"/>
                    <Binding Path="!IsHidden"/>
                </MultiBinding>
            </Grid.IsVisible>
            <Grid.Styles>
                <Style Selector="Grid.row-hidden">
                    <Setter Property="Opacity" Value="0.4"/>
                </Style>
            </Grid.Styles>

            <!-- Card (selectable) -->
            <Button Classes="WatchItem"
                    Classes.selected="{Binding IsSelected}"
                    Command="{Binding $parent[ItemsControl].((vmTorrents:TorrentsViewModel)DataContext).SelectAnimeCommand}"
                    CommandParameter="{Binding Anime}">
                <Grid ColumnDefinitions="50, *" ColumnSpacing="10">
                    <Panel Grid.Column="0" Width="50" Height="72" VerticalAlignment="Top">
                        <Border CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource SubtleFillColorTertiary}">
                            <Image core:CachedImage.Source="{Binding Anime.MainPictureUrl}"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <!-- New episodes badge -->
                        <Border IsVisible="{Binding Anime.Presentation.ShowAiredProgressBar}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,3,3,0"
                                CornerRadius="6"
                                Padding="5,1"
                                Background="{DynamicResource TorrentRedBrush}"
                                BoxShadow="0 2 6 0 #55000000"
                                ToolTip.Tip="{DynamicResource l.torrents.sidebar.new_episodes_tooltip}">
                            <TextBlock Text="{Binding Anime.Presentation.UnseenEpisodesCount, StringFormat='+{0}'}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Panel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"
                                Margin="0,0,14,0">
                        <TextBlock Text="{Binding Anime.Title}"
                                   FontSize="12" FontWeight="SemiBold"
                                   LineHeight="15"
                                   TextTrimming="CharacterEllipsis" MaxLines="2"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemBaseHighColor}"/>
                        <TextBlock Text="{Binding Anime.RussianTitle}"
                                   FontSize="10" LineHeight="13"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   IsVisible="{Binding Anime.RussianTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Progress Display & Segmented Progress Bar -->
                        <controls:SegmentedProgressBar Margin="0,5,0,3"
                                                       HorizontalAlignment="Stretch"
                                                       Current="{Binding Anime.Presentation.EffectiveProgress}"
                                                       Total="{Binding Anime.Presentation.EffectiveTotal}"
                                                       Aired="{Binding Anime.Presentation.ResolvedAiredEpisodes}"
                                                       AccentBrush="{DynamicResource SystemAccentColor}"
                                                       AiredBrush="{DynamicResource TorrentRedBrush}"
                                                       TrackBrush="{DynamicResource SegmentedTrackBrush}"
                                                       IsVisible="{Binding Anime.Presentation.ShowProgress}"/>

                        <TextBlock Text="{Binding Anime.Presentation.ProgressDisplay}"
                                   FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- × / + overlay (hide mode only) -->
            <Button Classes="IconAction"
                    Width="24" Height="24"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Background="{DynamicResource SubtleFillColorSecondary}"
                    IsVisible="{Binding $parent[ItemsControl].((vmTorrents:TorrentsViewModel)DataContext).IsHideMode}"
                    Command="{Binding $parent[ItemsControl].((vmTorrents:TorrentsViewModel)DataContext).ToggleHideAnimeCommand}"
                    CommandParameter="{Binding}">
                <Panel>
                    <material:MaterialIcon Kind="Close" Width="14" Height="14"
                                           Foreground="{DynamicResource TorrentRedBrush}"
                                           IsVisible="{Binding !IsHidden}"/>
                    <material:MaterialIcon Kind="Plus" Width="14" Height="14"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           IsVisible="{Binding IsHidden}"/>
                </Panel>
            </Button>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TorrentGroupTemplate" DataType="vmTorrents:TorrentGroup">
        <Border Margin="0,0,14,16" Padding="14,12"
                Background="{DynamicResource CardBackgroundFillSecondary}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1" CornerRadius="12">
            <StackPanel Spacing="10">
                <!-- Group header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Border CornerRadius="6" Padding="7,2"
                                Background="{DynamicResource OrangeredAccentTintBrush}"
                                BorderBrush="{DynamicResource OrangeredAccentBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding HasMatch}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon Kind="BellRingOutline" Width="12" Height="12"
                                                       Foreground="{DynamicResource OrangeredAccentBrush}"/>
                                <TextBlock Text="{DynamicResource l.torrents.results.in_list}"
                                           Foreground="{DynamicResource OrangeredAccentBrush}"
                                           FontSize="9" FontWeight="Bold" LetterSpacing="0.4"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding AnimeTitle}"
                                   FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Release count pill -->
                    <Border Grid.Column="1" CornerRadius="10" Padding="8,3"
                            Background="{DynamicResource SubtleFillColorSecondary}"
                            BorderBrush="{DynamicResource CardStrokeColorDefault}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Opacity="0.65" FontSize="11" FontWeight="Medium"
                                   Text="{Binding Count, Converter={StaticResource LocConverter}, ConverterParameter=format:l.torrents.results.group_count}"/>
                    </Border>
                </Grid>

                <!-- Divider line -->
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefault}" Margin="0,0,0,2"/>

                <!-- Items -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="entities:TorrentEntity">
                            <Border Classes="TorrentCard" Classes.matched="{Binding IsMatched}"
                                    Margin="0,3">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">

                                    <!-- Left Accent Bar for Matched -->
                                    <Border Grid.Column="0" Width="3" CornerRadius="2"
                                            Background="{DynamicResource OrangeredAccentBrush}"
                                            IsVisible="{Binding IsMatched}"
                                            VerticalAlignment="Stretch"/>

                                    <!-- Center Info Area -->
                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                        <!-- Title Row -->
                                        <WrapPanel Orientation="Horizontal" ItemWidth="NaN" VerticalAlignment="Center">
                                            <!-- Release Group Chip -->
                                            <Border Classes="GroupChip" Margin="0,0,6,0"
                                                    IsVisible="{Binding ReleaseGroup, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding ReleaseGroup}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SystemAccentColor}"/>
                                            </Border>

                                            <!-- Raw / parsed title -->
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <!-- Metadata chips & stats -->
                                        <WrapPanel Orientation="Horizontal" ItemWidth="NaN" VerticalAlignment="Center">
                                            <!-- Resolution Chip: 1080p highlighted -->
                                            <Border Classes="P1080Chip" Margin="0,0,6,0"
                                                    IsVisible="{Binding Is1080p}">
                                                <TextBlock Text="{Binding Resolution}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource SystemAccentColor}"/>
                                            </Border>

                                            <!-- Other Resolution (e.g. 720p) -->
                                            <Border Classes="MetaChip" Margin="0,0,6,0"
                                                    IsVisible="{Binding IsOtherResolution}">
                                                <TextBlock Text="{Binding Resolution}"
                                                           FontSize="10" FontWeight="Medium"/>
                                            </Border>

                                            <!-- Batch Chip -->
                                            <Border Classes="BatchChip" Margin="0,0,6,0"
                                                    IsVisible="{Binding IsBatch}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <material:MaterialIcon Kind="PackageVariant" Width="11" Height="11"
                                                                           Foreground="White"/>
                                                    <TextBlock Text="{DynamicResource l.torrents.results.batch_badge}"
                                                               FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Episode Chip (if not batch) -->
                                            <Border Classes="MetaChip" Margin="0,0,6,0"
                                                    IsVisible="{Binding ShowEpisodeBadge}">
                                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                                           Text="{Binding Episode, Converter={StaticResource LocConverter}, ConverterParameter=format:l.torrents.results.episode_prefix}"/>
                                            </Border>

                                            <!-- File Size Chip -->
                                            <Border Classes="MetaChip" Margin="0,0,6,0"
                                                    IsVisible="{Binding FormattedSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <material:MaterialIcon Kind="Harddisk" Width="11" Height="11" Opacity="0.55"/>
                                                    <TextBlock Text="{Binding FormattedSize}"
                                                               FontSize="10" FontWeight="Medium" Opacity="0.8"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Seeders & Leechers -->
                                            <Border Classes="MetaChip" Margin="0,0,6,0"
                                                    IsVisible="{Binding HasSeeders}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <material:MaterialIcon Kind="ArrowUpBold" Width="10" Height="10"
                                                                           Foreground="{DynamicResource AnalyticsSectionGreenBrush}"/>
                                                    <TextBlock Text="{Binding Seeders}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AnalyticsSectionGreenBrush}"/>
                                                    <material:MaterialIcon Kind="ArrowDownBold" Width="10" Height="10"
                                                                           Foreground="{DynamicResource AnalyticsSectionOrangeBrush}"
                                                                           Margin="2,0,0,0"/>
                                                    <TextBlock Text="{Binding Leechers}"
                                                               FontSize="10" Opacity="0.55"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Date -->
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="2,0,0,0">
                                                <material:MaterialIcon Kind="ClockOutline" Width="11" Height="11" Opacity="0.4"/>
                                                <TextBlock Opacity="0.5" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding PublishDate, StringFormat='{}{0:dd MMM HH:mm}'}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Right Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center">
                                        <!-- Magnet Button -->
                                        <Button Classes="ActionPill MagnetPill"
                                                ToolTip.Tip="{DynamicResource l.torrents.results.actions.download_magnet}"
                                                Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).DownloadMagnetCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding MagnetLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon Kind="Magnet" Width="14" Height="14"
                                                                       Foreground="{DynamicResource SystemAccentColor}"/>
                                                <TextBlock Text="{DynamicResource l.torrents.results.actions.magnet_btn}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SystemAccentColor}"
                                                           VerticalAlignment="Center"/>
                                        </StackPanel>
                                        </Button>

                                        <!-- Download .torrent Button -->
                                        <Button Classes="ActionPill TorrentPill"
                                                ToolTip.Tip="{DynamicResource l.torrents.results.actions.download_file}"
                                                Command="{Binding $parent[UserControl].((vmTorrents:TorrentsViewModel)DataContext).DownloadTorrentFileCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding DownloadLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <material:MaterialIcon Kind="Download" Width="14" Height="14"/>
                                                <TextBlock Text="{DynamicResource l.torrents.results.actions.torrent_btn}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
