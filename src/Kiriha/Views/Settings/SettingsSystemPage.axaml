<UserControl
    x:Class="Kiriha.Views.Settings.SettingsSystemPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
    x:DataType="vmSettings:SettingsViewModel">

    <StackPanel>

        <TextBlock Classes="PageTitle" Text="{DynamicResource l.common.status.system}" />

        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.language.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.language.subtitle}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                Width="160"
                VerticalAlignment="Center"
                CornerRadius="6"
                ItemsSource="{Binding Ui.AvailableLanguages}"
                SelectedItem="{Binding Ui.SelectedLanguage}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmSettings:LanguageOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.theme.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.theme.subtitle}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                Width="160"
                VerticalAlignment="Center"
                CornerRadius="6"
                ItemsSource="{Binding Ui.AvailableThemes}"
                SelectedItem="{Binding Ui.SelectedTheme}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmSettings:ThemeOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.tray.close_to_tray}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.tray.close_to_tray_sub}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding System.CloseToTray}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.tray.minimize_to_tray}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.tray.minimize_to_tray_sub}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding System.MinimizeToTray}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.auto_launch.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.auto_launch.subtitle}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding System.AutoLaunch}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.launch_minimized.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.launch_minimized.subtitle}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding System.LaunchMinimized}"
                IsEnabled="{Binding System.AutoLaunch}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.metadata.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.metadata.subtitle}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding System.EnableBackgroundMetadataFetch}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.logging.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.logging.subtitle}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding System.EnableLogging}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <!--  invisible spacer to compensate viewport/visible area mismatch  -->
    </StackPanel>
</UserControl>

