<UserControl
    x:Class="Kiriha.Views.Settings.SettingsCustomLinksPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:models="using:Kiriha.Core.Domain.Models"
    xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
    x:DataType="vmSettings:SettingsCustomLinksViewModel">
    <UserControl.Resources>
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter" />
    </UserControl.Resources>
    <StackPanel>

        <TextBlock Classes="PageTitle" Text="{DynamicResource l.settings.custom_links.title}" />

        <!--  Help / placeholder cheat sheet + one-click examples.  -->
        <Border
            Margin="0,0,0,16"
            Padding="14,12"
            Background="{DynamicResource SubtleFillColorTertiary}"
            CornerRadius="8">
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{DynamicResource l.settings.custom_links.help_title}" />
                <TextBlock
                    FontSize="11"
                    Opacity="0.7"
                    Text="{DynamicResource l.settings.custom_links.help_body}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontFamily="Consolas,Menlo,monospace"
                    FontSize="11"
                    Opacity="0.55"
                    Text="{}{title}, {english}, {russian}, {japanese}, {id}, {malId}, {shikiId}"
                    TextWrapping="Wrap" />

                <!--
                    Examples: one-click presets that drop a fully-formed
                    link into the list below. The favicon hook then
                    fills the icon automatically. WrapPanel so the
                    row collapses onto multiple lines on narrow widths.
                -->
                <WrapPanel
                    Margin="0,8,0,0"
                    ItemSpacing="8"
                    LineSpacing="6"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Opacity="0.7"
                        Text="{DynamicResource l.settings.custom_links.examples}" />

                    <Button
                        Padding="10,4"
                        Background="{DynamicResource SubtleFillColorSecondary}"
                        Command="{Binding AddPresetLinkCommand}"
                        CommandParameter="RuTracker|https://rutracker.org/forum/tracker.php?nm={title}"
                        Content="RuTracker"
                        CornerRadius="6"
                        FontSize="11"
                        ToolTip.Tip="https://rutracker.org/forum/tracker.php?nm={}{title}" />

                    <Button
                        Padding="10,4"
                        Background="{DynamicResource SubtleFillColorSecondary}"
                        Command="{Binding AddPresetLinkCommand}"
                        CommandParameter="NNM-Club|https://nnmclub.to/forum/tracker.php?nm={title}"
                        Content="NNM-Club"
                        CornerRadius="6"
                        FontSize="11"
                        ToolTip.Tip="https://nnmclub.to/forum/tracker.php?nm={}{title}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!--  List of custom links  -->
        <ItemsControl ItemsSource="{Binding CustomLinks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CustomShareLink">
                    <Border
                        Padding="12"
                        Background="{DynamicResource SubtleFillColorSecondary}"
                        CornerRadius="10">
                        <Grid ColumnDefinitions="Auto,8,*,8,2*,8,Auto">
                            <!--
                                Read-only icon preview. Shows the auto-fetched favicon for
                                the URL's host when available; otherwise the default globe.
                                No interaction — the icon is derived purely from the URL.
                            -->
                            <Border
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SubtleFillColorTertiary}"
                                CornerRadius="6">
                                <Panel>
                                    <material:MaterialIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasNoIconPath}"
                                        Kind="Web" />
                                    <Image
                                        Width="28"
                                        Height="28"
                                        IsVisible="{Binding HasIconPath}"
                                        Source="{Binding IconPath, Converter={StaticResource FilePathToBitmapConverter}}"
                                        Stretch="UniformToFill" />
                                </Panel>
                            </Border>
                            <!--
                                MinWidth=0 lets the TextBoxes shrink below their natural
                                content width so a long URL doesn't push the whole settings
                                page wider than the viewport (which would defeat TextWrapping
                                on the "How it works" help block).
                            -->
                            <TextBox
                                Grid.Column="2"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                PlaceholderText="{DynamicResource l.settings.custom_links.name_placeholder}"
                                Text="{Binding Name}" />
                            <TextBox
                                Grid.Column="4"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                PlaceholderText="https://example.com/?q={title}"
                                Text="{Binding UrlTemplate}" />
                            <Button
                                Grid.Column="6"
                                Padding="8"
                                Background="{DynamicResource SubtleFillColorTertiary}"
                                BorderThickness="0"
                                Command="{Binding $parent[ItemsControl].((vmSettings:SettingsCustomLinksViewModel)DataContext).RemoveCustomLinkCommand}"
                                CommandParameter="{Binding}"
                                CornerRadius="6"
                                ToolTip.Tip="{DynamicResource l.common.actions.remove}">
                                <material:MaterialIcon
                                    Width="14"
                                    Height="14"
                                    Foreground="#ff5555"
                                    Kind="TrashCanOutline" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Add button  -->
        <Button
            Margin="0,14,0,0"
            Padding="14,8"
            HorizontalAlignment="Left"
            Background="{DynamicResource SystemAccentColor}"
            Command="{Binding AddCustomLinkCommand}"
            CornerRadius="6"
            Foreground="White">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Plus" />
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{DynamicResource l.settings.custom_links.add}" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>

