<Window
    x:Class="Kiriha.Views.Settings.AnimeLibLoginWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    Title="{DynamicResource l.settings.streaming.login_window_title}"
    Width="520"
    Height="720"
    MinWidth="420"
    MinHeight="550"
    Background="{DynamicResource SolidBackgroundFillColorBase}"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <!--  Header Info  -->
        <Border
            Grid.Row="0"
            Padding="16,10"
            Background="{DynamicResource SubtleFillColorSecondary}"
            BorderBrush="{DynamicResource DividerStrokeColorDefault}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <material:MaterialIcon
                        Width="22"
                        Height="22"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Kind="ShieldAccountOutline" />
                    <StackPanel>
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{DynamicResource l.settings.streaming.login_window_title}" />
                        <TextBlock
                            FontSize="11"
                            Opacity="0.6"
                            Text="{DynamicResource l.settings.streaming.login_window_sub}" />
                    </StackPanel>
                </StackPanel>

                <Button
                    Name="CancelButton"
                    Grid.Column="2"
                    Padding="12,5"
                    VerticalAlignment="Center"
                    Click="CancelButton_OnClick"
                    Content="{DynamicResource l.settings.streaming.cancel_button}"
                    CornerRadius="6" />
            </Grid>
        </Border>

        <!--  Loading / Status Placeholder (behind WebView2)  -->
        <Grid Name="HostGrid" Grid.Row="1">
            <StackPanel
                Name="LoadingIndicator"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <ProgressBar Width="200" IsIndeterminate="True" />
                <TextBlock
                    Name="StatusTextBlock"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Opacity="0.7"
                    Text="{DynamicResource l.settings.streaming.login_window_loading}" />
            </StackPanel>
        </Grid>

        <!--  Footer / Tip  -->
        <Border
            Grid.Row="2"
            Padding="16,8"
            Background="{DynamicResource SubtleFillColorTertiary}"
            BorderBrush="{DynamicResource DividerStrokeColorDefault}"
            BorderThickness="0,1,0,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <material:MaterialIcon
                    Width="16"
                    Height="16"
                    Kind="LockCheckOutline"
                    Opacity="0.7" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.6"
                    Text="{DynamicResource l.settings.streaming.login_window_footer}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
