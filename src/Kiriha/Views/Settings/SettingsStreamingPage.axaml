<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
             xmlns:material="using:Material.Icons.Avalonia"
             x:Class="Kiriha.Views.Settings.SettingsStreamingPage"
             x:DataType="vmSettings:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.AccentAction">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.AccentAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.DangerAction">
            <Setter Property="Background" Value="#20e85656"/>
            <Setter Property="Foreground" Value="#ff5555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">
        <!-- ═══ Page Header ═══ -->
        <TextBlock Classes="PageTitle" Text="{DynamicResource l.settings.sections.streaming}"/>

        <!-- ═══ Notification / Status Banner ═══ -->
        <Border Background="{DynamicResource SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource SystemAccentColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                IsVisible="{Binding Streaming.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <material:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="18" Height="18"
                                      Foreground="{DynamicResource SystemAccentColor}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Streaming.StatusMessage}"
                           VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0"
                        Padding="6,2" Cursor="Hand" Opacity="0.6"
                        Command="{Binding Streaming.ClearStatusCommand}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ── Card 1: AnimeLib Account & Direct CDN Player ──              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Background="{DynamicResource SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <StackPanel Spacing="16">
                <!-- Header row with brand and action -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorTertiary}"
                            CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <material:MaterialIcon Kind="TelevisionPlay" Width="24" Height="24"
                                              Foreground="{DynamicResource SystemAccentColor}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="AnimeLib" FontSize="16" FontWeight="SemiBold"/>

                            <!-- Status Badge: Logged In -->
                            <Border Background="#152ecc71" CornerRadius="4" Padding="7,2"
                                    IsVisible="{Binding Streaming.IsAnimeLibLoggedIn}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="CheckCircle" Width="13" Height="13" Foreground="#2ecc71"/>
                                    <TextBlock Text="{DynamicResource l.settings.streaming.status_logged_in}" FontSize="11" FontWeight="SemiBold" Foreground="#2ecc71"/>
                                </StackPanel>
                            </Border>

                            <!-- Status Badge: Guest -->
                            <Border Background="#15ff9500" CornerRadius="4" Padding="7,2"
                                    IsVisible="{Binding !Streaming.IsAnimeLibLoggedIn}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="InformationOutline" Width="13" Height="13" Foreground="#cc8400"/>
                                    <TextBlock Text="{DynamicResource l.settings.streaming.status_guest}" FontSize="11" FontWeight="SemiBold" Foreground="#cc8400"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Logged In description -->
                        <TextBlock Text="{Binding Streaming.AnimeLibUsername, StringFormat='{} {0}'}"
                                   FontSize="12" Opacity="0.75"
                                   IsVisible="{Binding Streaming.IsAnimeLibLoggedIn}"/>

                        <!-- Guest description -->
                        <TextBlock Text="{DynamicResource l.settings.streaming.guest_desc}"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   IsVisible="{Binding !Streaming.IsAnimeLibLoggedIn}"/>
                    </StackPanel>

                    <!-- Login Button -->
                    <Button Grid.Column="2" Classes="AccentAction" VerticalAlignment="Center"
                            Command="{Binding Streaming.LoginAnimeLibCommand}"
                            IsVisible="{Binding !Streaming.IsAnimeLibLoggedIn}"
                            IsEnabled="{Binding !Streaming.IsLoggingIn}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Login" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource l.settings.streaming.login_button}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Logout Button -->
                    <Button Grid.Column="2" Classes="DangerAction" VerticalAlignment="Center"
                            Command="{Binding Streaming.LogoutAnimeLibCommand}"
                            IsVisible="{Binding Streaming.IsAnimeLibLoggedIn}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Logout" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource l.settings.streaming.logout_button}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Prefer direct MP4 toggle (when logged in) -->
                <StackPanel Spacing="10" IsVisible="{Binding Streaming.IsAnimeLibLoggedIn}">
                    <Border Classes="Divider"/>
                    <Grid Classes="Row" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="Title" Text="{DynamicResource l.settings.streaming.prefer_direct_title}"/>
                            <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.prefer_direct_sub}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding Streaming.PreferDirectMp4}"
                                     OnContent="{DynamicResource l.common.status.on}"
                                     OffContent="{DynamicResource l.common.status.off}"/>
                    </Grid>
                </StackPanel>

                <!-- Manual Token input expander (for power users or fallback, hidden when logged in) -->
                <Border BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="0,1,0,0" Padding="0,10,0,0"
                        IsVisible="{Binding !Streaming.IsAnimeLibLoggedIn}">
                    <StackPanel Spacing="8">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding Streaming.ToggleManualTokenCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Opacity="0.6"
                                                      IsVisible="{Binding !Streaming.IsManualTokenExpanded}"/>
                                <material:MaterialIcon Kind="ChevronDown" Width="16" Height="16" Opacity="0.6"
                                                      IsVisible="{Binding Streaming.IsManualTokenExpanded}"/>
                                <TextBlock Text="{DynamicResource l.settings.streaming.manual_token_toggle}" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Spacing="8" IsVisible="{Binding Streaming.IsManualTokenExpanded}" Margin="4,4,0,0">
                            <TextBlock Text="{DynamicResource l.settings.streaming.manual_token_hint}"
                                       FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Streaming.ManualToken}"
                                         PlaceholderText="{DynamicResource l.settings.streaming.manual_token_placeholder}"
                                         CornerRadius="6" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="{DynamicResource l.settings.streaming.apply_button}" Padding="14,6" CornerRadius="6"
                                        Command="{Binding Streaming.ApplyManualTokenCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ── Card 2: Anime 365 (Smotret Anime) Account ──                 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Background="{DynamicResource SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <StackPanel Spacing="16">
                <!-- Header row with brand and status -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorTertiary}"
                            CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <material:MaterialIcon Kind="FilmstripBox" Width="24" Height="24"
                                              Foreground="{DynamicResource SystemAccentColor}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Anime 365" FontSize="16" FontWeight="SemiBold"/>

                            <!-- Status Badge: Logged In -->
                            <Border Background="#152ecc71" CornerRadius="4" Padding="7,2"
                                    IsVisible="{Binding Streaming.IsAnime365LoggedIn}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="CheckCircle" Width="13" Height="13" Foreground="#2ecc71"/>
                                    <TextBlock Text="{DynamicResource l.settings.streaming.status_logged_in}" FontSize="11" FontWeight="SemiBold" Foreground="#2ecc71"/>
                                </StackPanel>
                            </Border>

                            <!-- Status Badge: Not Logged In -->
                            <Border Background="#15ff9500" CornerRadius="4" Padding="7,2"
                                    IsVisible="{Binding !Streaming.IsAnime365LoggedIn}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="InformationOutline" Width="13" Height="13" Foreground="#cc8400"/>
                                    <TextBlock Text="{DynamicResource l.settings.streaming.anime365_account_required}" FontSize="11" FontWeight="SemiBold" Foreground="#cc8400"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Logged In details -->
                        <StackPanel Spacing="2" IsVisible="{Binding Streaming.IsAnime365LoggedIn}">
                            <TextBlock Text="{Binding Streaming.Anime365Username, StringFormat='{} {0}'}"
                                       FontSize="12" Opacity="0.8" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Streaming.Anime365StatusText}"
                                       FontSize="11" Opacity="0.65"/>
                        </StackPanel>

                        <!-- Not Logged In description -->
                        <TextBlock Text="{DynamicResource l.settings.streaming.anime365_desc}"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   IsVisible="{Binding !Streaming.IsAnime365LoggedIn}"/>
                    </StackPanel>

                    <!-- Logout Button -->
                    <Button Grid.Column="2" Classes="DangerAction" VerticalAlignment="Center"
                            Command="{Binding Streaming.LogoutAnime365Command}"
                            IsVisible="{Binding Streaming.IsAnime365LoggedIn}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon Kind="Logout" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource l.settings.streaming.logout_button}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Login form when not logged in -->
                <StackPanel Spacing="10" IsVisible="{Binding !Streaming.IsAnime365LoggedIn}">
                    <Border Classes="Divider"/>
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBox Grid.Column="0" Text="{Binding Streaming.Anime365Email}"
                                 PlaceholderText="{DynamicResource l.settings.streaming.anime365_email_placeholder}"
                                 CornerRadius="6"/>
                        <TextBox Grid.Column="1" Text="{Binding Streaming.Anime365Password}"
                                 PasswordChar="●"
                                 PlaceholderText="{DynamicResource l.settings.streaming.anime365_password_placeholder}"
                                 CornerRadius="6"/>
                        <Button Grid.Column="2" Classes="AccentAction" VerticalAlignment="Center"
                                Command="{Binding Streaming.LoginAnime365Command}"
                                IsEnabled="{Binding !Streaming.IsAnime365LoggingIn}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon Kind="Login" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource l.settings.streaming.login_button}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Site mirror selector -->
                <Border Classes="Divider"/>
                <Grid Classes="Row" ColumnDefinitions="*,260">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Classes="Title" Text="{DynamicResource l.settings.streaming.anime365_mirror_title}"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.anime365_mirror_sub}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Streaming.Anime365Mirrors}"
                              SelectedItem="{Binding Streaming.SelectedAnime365Mirror}"
                              CornerRadius="6">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vmSettings:Anime365MirrorOption">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Manual Token input expander (hidden when logged in) -->
                <Border BorderBrush="{DynamicResource CardStrokeColorDefault}" BorderThickness="0,1,0,0" Padding="0,10,0,0"
                        IsVisible="{Binding !Streaming.IsAnime365LoggedIn}">
                    <StackPanel Spacing="8">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding Streaming.ToggleAnime365ManualTokenCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <material:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Opacity="0.6"
                                                      IsVisible="{Binding !Streaming.IsAnime365ManualTokenExpanded}"/>
                                <material:MaterialIcon Kind="ChevronDown" Width="16" Height="16" Opacity="0.6"
                                                      IsVisible="{Binding Streaming.IsAnime365ManualTokenExpanded}"/>
                                <TextBlock Text="{DynamicResource l.settings.streaming.anime365_manual_token_toggle}" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Spacing="8" IsVisible="{Binding Streaming.IsAnime365ManualTokenExpanded}" Margin="4,4,0,0">
                            <TextBlock Text="{DynamicResource l.settings.streaming.anime365_manual_token_hint}"
                                       FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Streaming.Anime365ManualToken}"
                                         PlaceholderText="{DynamicResource l.settings.streaming.anime365_manual_token_placeholder}"
                                         CornerRadius="6" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="{DynamicResource l.settings.streaming.apply_button}" Padding="14,6" CornerRadius="6"
                                        Command="{Binding Streaming.ApplyManualAnime365TokenCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ── Card 3: Sources Manager ──                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Background="{DynamicResource SubtleFillColorSecondary}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource l.settings.streaming.sources_header}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource l.settings.streaming.sources_sub}"
                           FontSize="12" Opacity="0.6"/>

                <Border Classes="Divider" Margin="0,4"/>

                <!-- AniLibria -->
                <Grid Classes="Row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Title" Text="AniLibria"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.anilibria_sub}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                 IsChecked="{Binding Streaming.EnableAniLibria}"
                                 OnContent="{DynamicResource l.common.status.on}"
                                 OffContent="{DynamicResource l.common.status.off}"/>
                </Grid>

                <Border Classes="Divider"/>

                <!-- AnimeLib -->
                <Grid Classes="Row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Title" Text="AnimeLib"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.animelib_sub}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                 IsChecked="{Binding Streaming.EnableAnimeLib}"
                                 OnContent="{DynamicResource l.common.status.on}"
                                 OffContent="{DynamicResource l.common.status.off}"/>
                </Grid>

                <Border Classes="Divider"/>

                <!-- DreamCast -->
                <Grid Classes="Row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Title" Text="DreamCast"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.dreamcast_sub}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                 IsChecked="{Binding Streaming.EnableDreamCast}"
                                 OnContent="{DynamicResource l.common.status.on}"
                                 OffContent="{DynamicResource l.common.status.off}"/>
                </Grid>

                <Border Classes="Divider"/>

                <!-- YummyAnime -->
                <Grid Classes="Row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Title" Text="YummyAnime"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.yummyanime_sub}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                 IsChecked="{Binding Streaming.EnableYummyAnime}"
                                 OnContent="{DynamicResource l.common.status.on}"
                                 OffContent="{DynamicResource l.common.status.off}"/>
                </Grid>

                <Border Classes="Divider"/>

                <!-- Anime 365 -->
                <Grid Classes="Row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Title" Text="Anime 365"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.anime365_sub}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                 IsChecked="{Binding Streaming.EnableAnime365}"
                                 IsEnabled="{Binding Streaming.IsAnime365LoggedIn}"
                                 OnContent="{DynamicResource l.common.status.on}"
                                 OffContent="{DynamicResource l.common.status.off}"/>
                </Grid>

                <Border Classes="Divider"/>

                <!-- Hide 480p -->
                <Grid Classes="Row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Title" Text="{DynamicResource l.settings.streaming.hide_480p_title}"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.hide_480p_sub}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                 IsChecked="{Binding Streaming.Hide480p}"
                                 OnContent="{DynamicResource l.common.status.on}"
                                 OffContent="{DynamicResource l.common.status.off}"/>
                </Grid>

                <Border Classes="Divider"/>

                <!-- Hide 720p -->
                <Grid Classes="Row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Title" Text="{DynamicResource l.settings.streaming.hide_720p_title}"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.hide_720p_sub}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                 IsChecked="{Binding Streaming.Hide720p}"
                                 OnContent="{DynamicResource l.common.status.on}"
                                 OffContent="{DynamicResource l.common.status.off}"/>
                </Grid>

                <Border Classes="Divider"/>

                <!-- Hide Non-Russian -->
                <Grid Classes="Row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="Title" Text="{DynamicResource l.settings.streaming.hide_non_russian_title}"/>
                        <TextBlock Classes="Sub" Text="{DynamicResource l.settings.streaming.hide_non_russian_sub}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                 IsChecked="{Binding Streaming.HideNonRussian}"
                                 OnContent="{DynamicResource l.common.status.on}"
                                 OffContent="{DynamicResource l.common.status.off}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
