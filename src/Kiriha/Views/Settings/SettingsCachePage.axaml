<UserControl
    x:Class="Kiriha.Views.Settings.SettingsCachePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
    x:DataType="vmSettings:SettingsViewModel">

    <StackPanel>

        <TextBlock Classes="PageTitle" Text="{DynamicResource l.settings.cache.title}" />

        <Border
            Margin="0,0,0,16"
            Padding="14,12"
            Background="{DynamicResource SubtleFillColorTertiary}"
            CornerRadius="8">
            <TextBlock
                FontSize="12"
                Opacity="0.7"
                Text="{DynamicResource l.settings.cache.subtitle}"
                TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Text="{DynamicResource l.settings.cache.clear_data}" />
            <Button
                Grid.Column="1"
                Padding="12,6"
                Background="{DynamicResource SubtleFillColorSecondary}"
                Command="{Binding Cache.RefreshCacheStatsCommand}"
                CornerRadius="6"
                IsEnabled="{Binding !Cache.IsCacheBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <material:MaterialIcon
                        Width="14"
                        Height="14"
                        Kind="Refresh" />
                    <TextBlock FontSize="12" Text="{DynamicResource l.common.actions.refresh}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            Padding="14,6"
            Background="{DynamicResource CardBackgroundFillDefault}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="8">
            <ItemsControl ItemsSource="{Binding Cache.CacheItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmSettings:CacheCleanupItem">
                        <Grid MinHeight="44" ColumnDefinitions="*,Auto">
                            <CheckBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected}">
                                <TextBlock FontSize="14" Text="{Binding TitleKey, Converter={StaticResource LocConverter}}" />
                            </CheckBox>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Opacity="0.65"
                                Text="{Binding DisplayStats}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Margin="0,16,0,0" ColumnDefinitions="*,Auto">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Opacity="0.65"
                Text="{Binding Cache.CacheStatus}" />
            <Button
                Grid.Column="1"
                Padding="18,8"
                Background="{DynamicResource SystemAccentColor}"
                Command="{Binding Cache.ClearSelectedCacheCommand}"
                CornerRadius="6"
                Foreground="White"
                IsEnabled="{Binding Cache.CanClearSelectedCache}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon
                        Width="14"
                        Height="14"
                        Kind="TrashCanOutline" />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{DynamicResource l.settings.cache.clear}" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>

