<UserControl
    x:Class="Kiriha.Views.Settings.SettingsAuthOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
    d:DesignHeight="500"
    d:DesignWidth="700"
    x:DataType="vmSettings:SettingsViewModel"
    IsVisible="{Binding Auth.IsAuthDialogOpen}"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBlock.Title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.Sub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.DimOverlay">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource ModalOverlayBackgroundBrush}">
        <!--  Click dim overlay to cancel  -->
        <Button
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Classes="DimOverlay"
            Command="{Binding Auth.CancelAuthCommand}"
            Focusable="False" />

        <!--  Modal Dialog Card (Same aesthetic as PrimarySwitchOverlay / UpdateDialogView)  -->
        <Border
            Width="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource ModalBackgroundFill}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            BoxShadow="0 10 40 0 #60000000"
            ClipToBounds="True"
            CornerRadius="12">
            <Grid RowDefinitions="*,Auto">

                <!--  Content Area  -->
                <Grid
                    Grid.Row="0"
                    MinHeight="140"
                    Margin="28,24,28,20">

                    <!--  State: In progress / waiting in browser  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        IsVisible="{Binding !Auth.IsAuthFailed}"
                        Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="Title" Text="{DynamicResource l.settings.accounts_hub.auth_dialog_title}" />
                            <TextBlock Classes="Sub" Text="{DynamicResource l.settings.accounts_hub.auth_dialog_desc}" />
                        </StackPanel>

                        <!--  Selected Target Service Card  -->
                        <Border
                            Padding="12,10"
                            Background="{DynamicResource SubtleFillColorSecondary}"
                            BorderBrush="{DynamicResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border
                                    Grid.Column="0"
                                    Height="30"
                                    MinWidth="30"
                                    Margin="0,0,10,0"
                                    Padding="6,0"
                                    Background="{Binding Auth.ActiveAuthBadgeBackground}"
                                    CornerRadius="6">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Auth.ActiveAuthTrackerBadge}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding Auth.ActiveAuthTrackerName}" />
                                    <TextBlock
                                        FontFamily="Consolas,monospace"
                                        FontSize="10"
                                        Opacity="0.6"
                                        Text="{Binding Auth.ActiveAuthTrackerDomain}" />
                                </StackPanel>
                                <material:MaterialIcon
                                    Grid.Column="2"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="OpenInBrowser"
                                    Opacity="0.6" />
                            </Grid>
                        </Border>

                        <!--  Progress Bar & Status text  -->
                        <StackPanel Spacing="8">
                            <ProgressBar
                                Height="4"
                                Background="{DynamicResource SubtleFillColorSecondary}"
                                BorderThickness="0"
                                CornerRadius="2"
                                Foreground="{DynamicResource SystemAccentColor}"
                                IsIndeterminate="True" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="Sub"
                                FontSize="11"
                                Opacity="0.75"
                                Text="{Binding Auth.ActiveAuthStatusText}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  State: Failed  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding Auth.IsAuthFailed}"
                        Spacing="12">
                        <Border
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="#15ff9500"
                            CornerRadius="26">
                            <material:MaterialIcon
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#cc8400"
                                Kind="AlertCircle" />
                        </Border>
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Classes="Title"
                                Text="{DynamicResource l.settings.accounts_hub.auth_dialog_failed}"
                                TextAlignment="Center" />
                            <TextBlock
                                MaxWidth="380"
                                HorizontalAlignment="Center"
                                Classes="Sub"
                                Text="{DynamicResource l.settings.accounts_hub.auth_dialog_failed_desc}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                </Grid>

                <!--  Actions Bar  -->
                <Border
                    Grid.Row="1"
                    Padding="20,14"
                    Background="{DynamicResource ModalSidebarFill}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <!--  Actions when in progress  -->
                        <StackPanel
                            HorizontalAlignment="Right"
                            IsVisible="{Binding !Auth.IsAuthFailed}"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Classes="Secondary"
                                Command="{Binding Auth.CancelAuthCommand}"
                                Content="{DynamicResource l.common.actions.cancel}" />
                        </StackPanel>

                        <!--  Actions when failed  -->
                        <StackPanel
                            HorizontalAlignment="Right"
                            IsVisible="{Binding Auth.IsAuthFailed}"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Classes="Secondary"
                                Command="{Binding Auth.CancelAuthCommand}"
                                Content="{DynamicResource l.common.actions.close}" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
