<UserControl
    x:Class="Kiriha.Views.Settings.SettingsAppearancePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
    x:DataType="vmSettings:SettingsViewModel">

    <StackPanel>

        <TextBlock Classes="PageTitle" Text="{DynamicResource l.settings.sections.appearance}" />

        <Grid
            Classes="Row"
            ColumnDefinitions="*,Auto"
            IsVisible="{Binding Ui.IsMicaSupported}">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.mica.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.mica.subtitle}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding Ui.EnableMica}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" IsVisible="{Binding Ui.IsMicaSupported}" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.shikimori.russian_titles}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.shikimori.russian_titles_sub}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding Ui.UseRussianTitles}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.shikimori.russian_descriptions}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.shikimori.russian_descriptions_sub}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding Ui.UseRussianDescriptions}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.airing_info.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.airing_info.subtitle}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding Ui.ShowAiringInfo}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" IsVisible="{Binding Ui.ShowAiringInfo}" />
        <Grid
            Classes="Row"
            ColumnDefinitions="*,Auto"
            IsVisible="{Binding Ui.ShowAiringInfo}">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.airing_source.title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.airing_source.subtitle}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                Width="200"
                VerticalAlignment="Center"
                CornerRadius="6"
                ItemsSource="{Binding System.AvailableAiringSources}"
                SelectedItem="{Binding System.SelectedAiringSource}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmSettings:AiringSourceOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.ui.custom_accent_color}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.ui.custom_accent_color_sub}" />
            </StackPanel>
            <ColorPicker
                Grid.Column="1"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                IsVisible="{Binding Ui.EnableCustomAccentColor}"
                Color="{Binding Ui.CustomAccentColor}" />
            <ToggleSwitch
                Grid.Column="2"
                VerticalAlignment="Center"
                IsChecked="{Binding Ui.EnableCustomAccentColor}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Border Classes="Divider" />
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.ui.scale}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                Width="160"
                VerticalAlignment="Center"
                CornerRadius="6"
                ItemsSource="{Binding Ui.AvailableUiScales}"
                SelectedItem="{Binding Ui.UiScale}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:Double">
                        <TextBlock Text="{Binding StringFormat={}{0:P0}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </StackPanel>
</UserControl>

