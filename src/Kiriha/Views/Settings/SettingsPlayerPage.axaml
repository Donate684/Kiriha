<UserControl
    x:Class="Kiriha.Views.Settings.SettingsPlayerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:models="using:Kiriha.Core.Domain.Models"
    xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
    x:DataType="vmSettings:SettingsViewModel">

    <StackPanel>

        <TextBlock Classes="PageTitle" Text="{DynamicResource l.settings.sections.player}" />

        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.default_player}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.default_player_sub}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Padding="10,6"
                    VerticalAlignment="Center"
                    Background="#152ecc71"
                    CornerRadius="4"
                    IsVisible="{Binding Playback.IsSystemPlayer}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <material:MaterialIcon
                            Width="12"
                            Height="12"
                            Foreground="#2ecc71"
                            Kind="CheckCircle" />
                        <TextBlock
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#2ecc71"
                            Text="{DynamicResource l.settings.player.integrated}" />
                    </StackPanel>
                </Border>
                <Button
                    Padding="14,6"
                    Background="{DynamicResource SystemAccentColor}"
                    Command="{Binding Playback.RegisterSystemPlayerCommand}"
                    Content="{DynamicResource l.settings.player.integrate}"
                    CornerRadius="6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    IsVisible="{Binding !Playback.IsSystemPlayer}" />
                <Button
                    Padding="8"
                    Background="{DynamicResource SubtleFillColorSecondary}"
                    BorderThickness="0"
                    Command="{Binding Playback.UnregisterSystemPlayerCommand}"
                    CornerRadius="6"
                    IsVisible="{Binding Playback.IsSystemPlayer}"
                    ToolTip.Tip="{DynamicResource l.settings.player.remove_integration}">
                    <material:MaterialIcon
                        Width="14"
                        Height="14"
                        Foreground="#ff5555"
                        Kind="Close" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.keep_alive}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.keep_alive_sub}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding Playback.KeepPlayerProcessAlive}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.single_window}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.single_window_sub}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding Playback.SinglePlayerWindow}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Grid Classes="Row" ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.remember_position}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.remember_position_sub}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding Playback.RememberPlaybackPosition}"
                OffContent="{DynamicResource l.common.status.off}"
                OnContent="{DynamicResource l.common.status.on}" />
        </Grid>
        <Grid Classes="Row" ColumnDefinitions="*,180">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.skip_op_ed}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.skip_op_ed_sub}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding Playback.SkipOpeningEndingOptions}"
                SelectedItem="{Binding Playback.SelectedSkipOpeningEndingOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SkipOpeningEndingOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Border Classes="Divider" />

        <TextBlock
            Margin="0,18,0,4"
            Classes="Title"
            Text="{DynamicResource l.settings.player.pipeline_title}" />
        <TextBlock
            Margin="0,0,0,8"
            Classes="Sub"
            Text="{DynamicResource l.settings.player.pipeline_sub}" />
        <Grid Classes="Row" ColumnDefinitions="*,180">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.hwdec_title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.hwdec_sub}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding Playback.MpvHwdecOptions}"
                SelectedItem="{Binding Playback.MpvHwdec}" />
        </Grid>
        <Grid Classes="Row" ColumnDefinitions="*,180">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.vo_title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.vo_sub}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding Playback.MpvVoOptions}"
                SelectedItem="{Binding Playback.MpvVideoOutput}" />
        </Grid>
        <Grid Classes="Row" ColumnDefinitions="*,180">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.gpu_api_title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.gpu_api_sub}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding Playback.MpvGpuApiOptions}"
                SelectedItem="{Binding Playback.MpvGpuApi}" />
        </Grid>
        <Grid Classes="Row" ColumnDefinitions="*,180">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="Title" Text="{DynamicResource l.settings.player.gpu_context_title}" />
                <TextBlock Classes="Sub" Text="{DynamicResource l.settings.player.gpu_context_sub}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding Playback.MpvGpuContextOptions}"
                SelectedItem="{Binding Playback.MpvGpuContext}" />
        </Grid>

    </StackPanel>
</UserControl>
