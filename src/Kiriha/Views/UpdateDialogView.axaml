<UserControl
    x:Class="Kiriha.Views.UpdateDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vmDialogs="using:Kiriha.ViewModels.Dialogs"
    d:DesignHeight="280"
    d:DesignWidth="480"
    x:DataType="vmDialogs:UpdateDialogViewModel"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="TextBlock.Title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.Sub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Success">
            <Setter Property="Background" Value="#2ecc71" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">

        <!--  ═══ Content ═══  -->
        <Grid
            Grid.Row="0"
            Margin="28,24,28,20"
            VerticalAlignment="Stretch">

            <!--  Prompt: version row like Settings  -->
            <StackPanel VerticalAlignment="Center" IsVisible="{Binding !IsDownloadingOrFinished}">
                <Grid MinHeight="56" ColumnDefinitions="*,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Classes="Sub"
                        Text="{Binding VersionText}" />
                    <Border
                        Grid.Column="1"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondary}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemAccentColor}"
                            Text="{Binding NewVersionLabel}" />
                    </Border>
                </Grid>
            </StackPanel>

            <!--  Downloading  -->
            <StackPanel
                VerticalAlignment="Center"
                IsVisible="{Binding IsDownloading}"
                Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Classes="Title" Text="{DynamicResource l.updates.downloading_text}" />
                    <TextBlock Classes="Sub" Text="{Binding ProgressText}" />
                </StackPanel>
                <ProgressBar
                    Height="6"
                    Background="{DynamicResource SubtleFillColorSecondary}"
                    BorderThickness="0"
                    CornerRadius="3"
                    Foreground="{DynamicResource SystemAccentColor}"
                    Maximum="100"
                    Value="{Binding Progress}" />
            </StackPanel>

            <!--  Downloaded  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsDownloaded}"
                Spacing="12">
                <Border
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Background="#152ecc71"
                    CornerRadius="28">
                    <material:MaterialIcon
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#2ecc71"
                        Kind="CheckCircle" />
                </Border>
                <TextBlock
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Opacity="0.8"
                    Text="{DynamicResource l.updates.downloaded}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  ═══ Actions ═══  -->
        <Border
            Grid.Row="1"
            Padding="20,14"
            Background="{DynamicResource ModalSidebarFill}"
            BorderBrush="{DynamicResource DividerStrokeColorDefault}"
            BorderThickness="0,1,0,0">
            <Grid>
                <!--  Before download finished  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    IsVisible="{Binding !IsDownloaded}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Classes="Secondary"
                        Command="{Binding CloseDialogCommand}"
                        Content="{DynamicResource l.common.actions.cancel}"
                        IsEnabled="{Binding !IsDownloading}" />

                    <!--  Update (ready)  -->
                    <Button
                        Classes="Primary"
                        Command="{Binding StartUpdateCommand}"
                        IsVisible="{Binding !IsDownloading}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon
                                Width="14"
                                Height="14"
                                Kind="Download" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{DynamicResource l.updates.download}" />
                        </StackPanel>
                    </Button>

                    <!--  Downloading — progress inside button  -->
                    <Button
                        MinWidth="160"
                        Padding="16,9"
                        Background="{DynamicResource SystemAccentColor}"
                        ClipToBounds="True"
                        CornerRadius="6"
                        Foreground="White"
                        IsEnabled="False"
                        IsVisible="{Binding IsDownloading}">
                        <Grid>
                            <ProgressBar
                                Height="34"
                                Margin="-16,-9"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                Foreground="#40FFFFFF"
                                Maximum="100"
                                Value="{Binding Progress}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding ProgressText}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!--  After download: single Restart button  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    IsVisible="{Binding IsDownloaded}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Classes="Success" Command="{Binding RestartAppCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon
                                Width="14"
                                Height="14"
                                Kind="Restart" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{DynamicResource l.updates.install_and_restart}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
