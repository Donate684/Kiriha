<UserControl
    x:Class="Kiriha.Views.WelcomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kiriha.Views.Controls"
    xmlns:vmStartup="using:Kiriha.ViewModels.Startup"
    x:DataType="vmStartup:WelcomeViewModel">

    <UserControl.Styles>
        <!--
            Spinner Arc rotation: kept at the UserControl level (not inline on
            the Arc itself) so the Style/Animation/clock is parsed once and
            reused, instead of being rebuilt every time the loading Border
            toggles IsVisible during startup.
        -->
        <Style Selector="Arc.WelcomeSpinner">
            <Style.Animations>
                <Animation IterationCount="Infinite" Duration="0:0:1">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent">
        <StackPanel
            Margin="0,-80,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="0">

            <!--  Logo with soft accent halo  -->
            <Panel HorizontalAlignment="Center">
                <!--  Мягкое акцентное свечение сзади  -->
                <!--
                    Soft halo: pure RadialGradient gives the same visual feel as
                    a blurred fill at zero rendering cost. The previous BlurEffect
                    Radius=30 was contributing ~150ms+ to the first frame on
                    Mica windows because Avalonia's Effect pipeline runs through
                    skia software blur on every paint.
                -->
                <Ellipse
                    Width="390"
                    Height="390"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.22">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight2}" />
                            <GradientStop Offset="0.5" Color="{DynamicResource SystemAccentColor}" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!--  Сам логотип  -->
                <controls:LeafLogo
                    Width="270"
                    Height="270"
                    Margin="0,0,0,50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Panel>

            <!--  Brand (Margin top отрицательный — двигает текст выше, ближе к логотипу)  -->
            <StackPanel Margin="0,-70,0,0" Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="52"
                    FontWeight="Thin"
                    LetterSpacing="8"
                    Opacity="0.9"
                    Text="{DynamicResource l.common.app_name}" />
                <TextBlock
                    Name="VersionLabel"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    FontWeight="Black"
                    LetterSpacing="5"
                    Opacity="0.3" />
            </StackPanel>

        </StackPanel>

        <!--
            About link — bottom-centered, deliberately muted so it never
            competes with the brand or the loading badge. Click opens the
            AboutWindow modal (credits + library list).
        -->
        <Button
            Margin="0,0,0,16"
            Padding="10,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="Transparent"
            BorderThickness="0"
            Click="OnAboutClick"
            Content="{DynamicResource l.about.open_button}"
            Cursor="Hand"
            FontSize="11"
            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            Opacity="0.55" />

        <!--  Status / Progress Info — выведено за StackPanel, чтобы не двигало логотип/текст  -->
        <Border
            Margin="0,0,0,10"
            Padding="20,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{DynamicResource CardBackgroundFillDefault}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="20"
            IsVisible="{Binding IsLoading}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Arc
                    Width="12"
                    Height="12"
                    Classes="WelcomeSpinner"
                    Stroke="{DynamicResource SystemAccentColor}"
                    StrokeThickness="2"
                    SweepAngle="90" />
                <TextBlock
                    FontSize="13"
                    Opacity="0.5"
                    Text="{DynamicResource l.sync.syncing.mal}" />
            </StackPanel>
        </Border>

        <!--
            Decoration bits.
            Removed BlurEffect on these corner ellipses: skia software blur
            with Radius=80..100 on 200..300px ellipses costs hundreds of ms on
            the first frame and tens of ms on every subsequent paint. The
            ellipses are clipped half off-screen and at Opacity=0.1, so the
            remaining solid radial pseudo-glow via lower opacity still hints
            at the same accent without hammering the renderer.
        -->
        <Canvas IsHitTestVisible="False" Opacity="0.06">
            <Ellipse
                Canvas.Left="-180"
                Canvas.Top="-180"
                Width="300"
                Height="300">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Offset="0" Color="{DynamicResource SystemAccentColor}" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                Canvas.Right="-130"
                Canvas.Bottom="-130"
                Width="220"
                Height="220">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Offset="0" Color="{DynamicResource SystemAccentColor}" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
    </Grid>
</UserControl>
