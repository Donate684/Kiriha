<ResourceDictionary
    x:Class="Kiriha.Views.Seasonal.SeasonalCardTemplate"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:core="using:Kiriha.Core"
    xmlns:entities="using:Kiriha.Core.Domain.Models.Entities"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmSeasonal="using:Kiriha.ViewModels.Seasonal">

    <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
    <conv:StatusToIconConverter x:Key="StatusToIconConverter" />
    <conv:StatusNotNoneConverter x:Key="StatusNotNoneConverter" />
    <conv:StatusNoneConverter x:Key="StatusNoneConverter" />
    <conv:FranchiseToColorConverter x:Key="FranchiseToColorConverter" />
    <conv:FranchiseToIconConverter x:Key="FranchiseToIconConverter" />
    <conv:LocConverter x:Key="LocConverter" />
    <conv:IntToBooleanConverter x:Key="IntToBoolConverter" />

    <ControlTemplate x:Key="PosterLoadingTemplate">
        <Panel Background="{DynamicResource SubtleFillColorSecondary}">
            <material:MaterialIcon
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Kind="ImageOutline"
                Opacity="0.1" />
        </Panel>
    </ControlTemplate>

    <!--  ═══════════ Compact Horizontal Card ═══════════  -->
    <DataTemplate x:Key="AnimeGridItemTemplate" x:DataType="entities:AnimeEntity">
        <Border
            Margin="4"
            Background="{DynamicResource CardBackgroundFillSecondary}"
            BorderBrush="{DynamicResource DividerStrokeColorDefault}"
            BorderThickness="1"
            Classes="AnimeCard revealItem FloatingMagCard"
            ClipToBounds="False"
            CornerRadius="10">
            <Grid ColumnDefinitions="110, *" DoubleTapped="Poster_DoubleTapped">

                <!--  ─── Left: Poster ───  -->
                <Border
                    Grid.Column="0"
                    Width="110"
                    Height="165"
                    ClipToBounds="True"
                    CornerRadius="9,0,0,9">
                    <Panel Width="110" Height="165">
                        <TemplatedControl Template="{DynamicResource PosterLoadingTemplate}" />
                        <Image
                            Width="110"
                            Height="165"
                            core:CachedImage.DecodeWidth="200"
                            core:CachedImage.Source="{Binding MainPictureUrl}"
                            Stretch="UniformToFill" />

                        <!--  Top-left badges: Status / Franchise + Airing date  -->
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Spacing="3">
                            <Border
                                Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                Classes="Badge"
                                IsVisible="{Binding Status, Converter={StaticResource StatusNotNoneConverter}}">
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="3">
                                    <material:MaterialIcon
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                        Opacity="0.9" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Status, Converter={StaticResource LocConverter}}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Background="{Binding Franchise, Converter={StaticResource FranchiseToColorConverter}}"
                                Classes="Badge FranchiseBadge"
                                IsVisible="{Binding Presentation.HasFranchiseBadge}"
                                ToolTip.Tip="{Binding Presentation.FranchiseTooltip}">
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="3">
                                    <material:MaterialIcon
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="{Binding Franchise, Converter={StaticResource FranchiseToIconConverter}}"
                                        Opacity="0.9" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Presentation.FranchiseBadgeText}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="Badge DateBadge" ToolTip.Tip="{DynamicResource l.schedule.premiere}">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="Presentation.HasAiringDate" />
                                        <Binding Path="$parent[UserControl].((vmSeasonal:SeasonalViewModel)DataContext).IsDateSort" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="3">
                                    <material:MaterialIcon
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="CalendarOutline"
                                        Opacity="0.9" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Presentation.AiringDateDisplay}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="Badge ScoreBadge" ToolTip.Tip="{DynamicResource l.filters.sort.score}">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="Presentation.HasMeanScore" />
                                        <Binding Path="$parent[UserControl].((vmSeasonal:SeasonalViewModel)DataContext).IsScoreSort" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="3">
                                    <material:MaterialIcon
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource RatingStarForegroundBrush}"
                                        Kind="Star" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Presentation.MeanScoreDisplay}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="Badge PopularityBadge" ToolTip.Tip="{DynamicResource l.filters.sort.popularity}">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="Presentation.HasPopularity" />
                                        <Binding Path="$parent[UserControl].((vmSeasonal:SeasonalViewModel)DataContext).IsPopularitySort" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="3">
                                    <material:MaterialIcon
                                        Width="10"
                                        Height="10"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource OrangeredAccentBrush}"
                                        Kind="Fire" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Presentation.PopularityDisplay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--  Action buttons top-right  -->
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Spacing="4">
                            <!--  Hide btn top-right, appears on card hover  -->
                            <Border
                                Classes="HideBtn"
                                Classes.confirming="{Binding IsHideConfirming}"
                                Tapped="HideBtn_Tapped"
                                ToolTip.Tip="{DynamicResource l.filters.options.hide_tooltip}">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                        <Binding Converter="{StaticResource StatusNoneConverter}" Path="Status" />
                                        <Binding Path="IsHiddenInSeasons" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="3">
                                    <material:MaterialIcon
                                        Width="12"
                                        Height="12"
                                        Foreground="White"
                                        IsVisible="{Binding !IsHiddenInSeasons}"
                                        Kind="EyeOffOutline" />
                                    <material:MaterialIcon
                                        Width="12"
                                        Height="12"
                                        Foreground="White"
                                        IsVisible="{Binding IsHiddenInSeasons}"
                                        Kind="EyeOutline" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        IsVisible="{Binding IsHideConfirming}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static conv:HideConfirmTextConverter.Instance}">
                                                <Binding Path="IsHiddenInSeasons" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!--  Quick-add (+) btn — top-right, only when not in list  -->
                            <Border
                                Classes="HideBtn"
                                IsVisible="{Binding Status, Converter={StaticResource StatusNoneConverter}}"
                                Tapped="QuickAddBtn_Tapped"
                                ToolTip.Tip="{DynamicResource l.anime.list_actions.add_to_list}">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem
                                            Click="QuickAddMenuItem_Click"
                                            Header="{DynamicResource l.anime.status.plan_to_watch}"
                                            Tag="PlanToWatch">
                                            <MenuItem.Icon>
                                                <material:MaterialIcon Kind="BookmarkOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="QuickAddMenuItem_Click"
                                            Header="{DynamicResource l.anime.status.watching}"
                                            Tag="Watching">
                                            <MenuItem.Icon>
                                                <material:MaterialIcon Kind="PlayCircleOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="QuickAddMenuItem_Click"
                                            Header="{DynamicResource l.anime.status.on_hold}"
                                            Tag="OnHold">
                                            <MenuItem.Icon>
                                                <material:MaterialIcon Kind="PauseCircleOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="QuickAddMenuItem_Click"
                                            Header="{DynamicResource l.anime.status.completed}"
                                            Tag="Completed">
                                            <MenuItem.Icon>
                                                <material:MaterialIcon Kind="CheckCircleOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="QuickAddMenuItem_Click"
                                            Header="{DynamicResource l.anime.status.dropped}"
                                            Tag="Dropped">
                                            <MenuItem.Icon>
                                                <material:MaterialIcon Kind="CloseCircleOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <material:MaterialIcon
                                    Width="12"
                                    Height="12"
                                    Foreground="White"
                                    Kind="Plus" />
                            </Border>
                        </StackPanel>

                        <!--  Bottom overlay: gradient + Score/Type/Eps pills  -->
                        <Border VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#BB000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel
                                Margin="5,10,5,6"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Spacing="3">
                                <!--  Score pill  -->
                                <Border
                                    Padding="5,2"
                                    Background="#88000000"
                                    CornerRadius="5">
                                    <Border.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Converter="{x:Static StringConverters.IsNotNullOrEmpty}" Path="MeanScore" />
                                            <Binding Path="!$parent[UserControl].((vmSeasonal:SeasonalViewModel)DataContext).IsScoreSort" />
                                        </MultiBinding>
                                    </Border.IsVisible>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <material:MaterialIcon
                                            Width="9"
                                            Height="9"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource RatingStarForegroundBrush}"
                                            Kind="Star" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding MeanScore}" />
                                    </StackPanel>
                                </Border>
                                <!--  Type pill  -->
                                <Border
                                    Padding="5,2"
                                    Background="#88000000"
                                    CornerRadius="5"
                                    IsVisible="{Binding Type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Type, Converter={StaticResource LocConverter}}" />
                                </Border>
                                <!--  Eps pill  -->
                                <Border
                                    Padding="5,2"
                                    Background="#88000000"
                                    CornerRadius="5"
                                    IsVisible="{Binding TotalEpisodes, Converter={StaticResource IntToBoolConverter}}">
                                    <TextBlock
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Opacity="0.85">
                                        <Run Text="{Binding TotalEpisodes}" /><Run Text=" " /><Run Text="{DynamicResource l.anime.labels.ep_abbr}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Panel>
                </Border>

                <!--  ─── Right: Info ───  -->
                <Grid
                    Grid.Column="1"
                    Margin="11,10,10,10"
                    RowDefinitions="*, Auto">

                    <!--  Row 0: Romaji title + RU/EN title  -->
                    <StackPanel Grid.Row="0" Spacing="3">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemBaseHighColor}"
                            LineHeight="16"
                            MaxLines="2"
                            Text="{Binding Presentation.RomajiTitle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="10.5"
                            FontWeight="Medium"
                            Foreground="{DynamicResource SystemBaseHighColor}"
                            IsVisible="{Binding Presentation.HasSecondaryTitle}"
                            LineHeight="14"
                            MaxLines="2"
                            Opacity="0.6"
                            Text="{Binding Presentation.SecondaryTitle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Row 1: Genre pills  -->
                    <ItemsControl
                        Grid.Row="1"
                        Margin="0,7,0,0"
                        IsVisible="{Binding Presentation.HasGenres}"
                        ItemsSource="{Binding Genres}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border
                                    Margin="0,0,4,4"
                                    Padding="6,3"
                                    Background="{DynamicResource PillBgBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefault}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <TextBlock
                                        FontSize="9.5"
                                        FontWeight="Medium"
                                        Opacity="0.85"
                                        Text="{Binding Converter={StaticResource LocConverter}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>

            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
