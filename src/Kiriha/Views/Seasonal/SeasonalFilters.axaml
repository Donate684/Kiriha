<UserControl
    x:Class="Kiriha.Views.Seasonal.SeasonalFilters"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmSeasonal="using:Kiriha.ViewModels.Seasonal"
    x:DataType="vmSeasonal:SeasonalViewModel">
    <StackPanel Orientation="Horizontal" Spacing="12">
        <Button
            Padding="8,6"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Classes.active="{Binding IsFilterActive}"
            CornerRadius="6">
            <Button.Styles>
                <Style Selector="Button">
                    <Setter Property="Opacity" Value="0.6" />
                </Style>
                <Style Selector="Button.active">
                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="Button.active TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </Button.Styles>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <material:MaterialIcon
                    Width="16"
                    Height="16"
                    Foreground="{Binding $parent[Button].Foreground}"
                    Kind="FilterVariant" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{Binding $parent[Button].Foreground}"
                    Text="{DynamicResource l.filters.header}" />
            </StackPanel>
            <Button.Flyout>
                <Flyout FlyoutPresenterClasses="FilterFlyout" Placement="BottomEdgeAlignedRight">
                    <StackPanel Margin="10" Spacing="4">
                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterNotInList}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.filters.options.not_in_list}" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterWatching}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.anime.status.watching}" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterCompleted}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.anime.status.completed}" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterOnHold}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.anime.status.on_hold}" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterPlanToWatch}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.anime.status.plan_to_watch}" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterDropped}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.anime.status.dropped}" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterFranchise}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.filters.options.franchise_sequels}" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding ShowHidden}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.filters.options.show_hidden}" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>

                        <Border
                            Height="1"
                            Margin="2,4"
                            Background="{DynamicResource DividerStrokeColorDefault}" />

                        <ToggleButton Classes="FilterToggle" IsChecked="{Binding FilterNsfw}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                                <Border
                                    Grid.Column="0"
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource FilterRedTintBrush}"
                                    CornerRadius="6">
                                    <material:MaterialIcon
                                        Width="13"
                                        Height="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource FilterRedBrush}"
                                        Kind="AlertOctagonOutline" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{DynamicResource l.filters.adult.only}" />
                                <Border
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Classes="SwitchTrack">
                                    <Ellipse Classes="SwitchThumb" />
                                </Border>
                            </Grid>
                        </ToggleButton>

                        <Button
                            Margin="0,4,0,0"
                            Classes="FilterReset"
                            Command="{Binding ClearFiltersCommand}"
                            Content="{DynamicResource l.common.actions.reset}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

    </StackPanel>
</UserControl>
