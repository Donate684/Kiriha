<UserControl
    x:Class="Kiriha.Views.Seasonal.SeasonalView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kiriha.Views.Seasonal"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:u="using:Kiriha.Utils.UI"
    xmlns:vmSeasonal="using:Kiriha.ViewModels.Seasonal"
    x:CompileBindings="True"
    x:DataType="vmSeasonal:SeasonalViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kiriha/Views/Seasonal/SeasonalCardTemplate.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://Kiriha/Views/Seasonal/SeasonalView.Styles.axaml" />
    </UserControl.Styles>
    <Grid Margin="0" RowDefinitions="Auto, Auto, Auto, *">

        <!--  ═══ Top Bar ═══  -->
        <Border
            Grid.Row="0"
            Margin="20,4,20,12"
            Padding="8,6"
            Background="{DynamicResource SubtleFillColorSecondary}"
            BorderBrush="{DynamicResource CardStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                <!--  Search  -->
                <TextBox
                    Grid.Column="0"
                    Height="34"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="13"
                    PlaceholderText="{DynamicResource l.common.actions.search}"
                    Text="{Binding SearchQuery}">
                    <TextBox.InnerRightContent>
                        <material:MaterialIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            Kind="Magnify"
                            Opacity="0.3" />
                    </TextBox.InnerRightContent>
                </TextBox>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        Background="{DynamicResource DividerStrokeColorDefault}" />

                    <!--  Season nav  -->
                    <local:SeasonalNavigation />

                    <!--  Season nav  -->
                    <Button
                        Padding="6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding PreviousSeasonCommand}"
                        CornerRadius="4">
                        <material:MaterialIcon
                            Width="18"
                            Height="18"
                            Kind="ChevronLeft"
                            Opacity="0.6" />
                    </Button>

                    <Button
                        Height="34"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4">
                        <StackPanel
                            Width="90"
                            Height="30"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemAccentColor}"
                                Text="{Binding DisplaySeason}"
                                TextAlignment="Center" />
                            <TextBlock
                                FontSize="10"
                                Opacity="0.4"
                                Text="{Binding CurrentYear}"
                                TextAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Width="140" Spacing="8">
                                    <NumericUpDown
                                        FormatString="0"
                                        Maximum="2100"
                                        Minimum="1917"
                                        Value="{Binding CurrentYear}" />
                                    <ListBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding Seasons}"
                                        SelectedItem="{Binding CurrentSeason}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock
                                                    Padding="8,4"
                                                    FontSize="12"
                                                    Text="{Binding Converter={StaticResource LocConverter}}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        Padding="6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding NextSeasonCommand}"
                        CornerRadius="4">
                        <material:MaterialIcon
                            Width="18"
                            Height="18"
                            Kind="ChevronRight"
                            Opacity="0.6" />
                    </Button>

                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        Background="{DynamicResource DividerStrokeColorDefault}" />

                    <!--  Sort  -->
                    <Button
                        Padding="8,6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                Kind="SortVariant"
                                Opacity="0.6" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.6"
                                Text="{Binding DisplaySortBy}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout FlyoutPresenterClasses="FilterFlyout" Placement="BottomEdgeAlignedRight">
                                <ListBox
                                    Margin="6"
                                    Classes="SortList"
                                    ItemsSource="{Binding SortOptions}"
                                    SelectedItem="{Binding SortBy}"
                                    Tapped="SortListBox_Tapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid VerticalAlignment="Center" ColumnDefinitions="14,*">
                                                <material:MaterialIcon
                                                    Grid.Column="0"
                                                    Width="13"
                                                    Height="13"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                                    Kind="Check" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{Binding Converter={StaticResource LocConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--  Filters  -->
                    <local:SeasonalFilters />
                </StackPanel>

                <!--  Refresh  -->
                <Button
                    Grid.Column="3"
                    Height="34"
                    Padding="12,0"
                    Background="{DynamicResource SystemAccentColor}"
                    Command="{Binding ForceRefreshCommand}"
                    CornerRadius="8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            Kind="Refresh" />
                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource l.common.actions.refresh}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  ═══ Category Tabs ═══  -->
        <Border
            Grid.Row="1"
            Margin="20,0,20,12"
            Padding="4"
            HorizontalAlignment="Center"
            Background="{DynamicResource SubtleFillColorSecondary}"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="New"
                    Content="{Binding NewHeader}"
                    IsChecked="{Binding IsNewSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="Continuing"
                    Content="{Binding ContinuingHeader}"
                    IsChecked="{Binding IsContinuingSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="Movies"
                    Content="{Binding MoviesHeader}"
                    IsChecked="{Binding IsMoviesSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="ONA"
                    Content="{Binding OnaHeader}"
                    IsChecked="{Binding IsOnaSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="OVA"
                    Content="{Binding OvaHeader}"
                    IsChecked="{Binding IsOvaSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="Specials"
                    Content="{Binding SpecialsHeader}"
                    IsChecked="{Binding IsSpecialsSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="Other"
                    Content="{Binding OtherHeader}"
                    IsChecked="{Binding IsOtherSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="Donghua"
                    Content="{Binding DonghuaHeader}"
                    IsChecked="{Binding IsDonghuaSelected, Mode=OneWay}" />
                <RadioButton
                    Classes="Pill"
                    Command="{Binding SelectCategoryCommand}"
                    CommandParameter="Aeni"
                    Content="{Binding AeniHeader}"
                    IsChecked="{Binding IsAeniSelected, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!--  ═══════════════════════════════════════  -->
        <!--  ═══ GRID VIEW (Virtualized ItemsRepeater) ═══  -->
        <!--  ═══════════════════════════════════════  -->
        <Panel Grid.Row="3">
            <ScrollViewer
                x:Name="ContentScrollViewer"
                u:SmoothScroll.IsEnabled="True"
                u:SmoothScroll.SmoothingTimeMs="120"
                u:SmoothScroll.WheelMultiplier="120"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsRepeater
                    x:Name="SeasonalItemsRepeater"
                    Margin="20,0,20,16"
                    ItemsSource="{Binding DisplayItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            MinColumnSpacing="0"
                            MinItemHeight="175"
                            MinItemWidth="360"
                            MinRowSpacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <StaticResource ResourceKey="AnimeGridItemTemplate" />
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!--  No Results  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Spacing="10">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!DisplayItems.Count" />
                        <Binding Path="!IsLoading" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <material:MaterialIcon
                    Width="48"
                    Height="48"
                    Kind="FilterVariant"
                    Opacity="0.1" />
                <TextBlock
                    FontSize="14"
                    Opacity="0.3"
                    Text="{DynamicResource l.common.status.no_results}" />
            </StackPanel>

        </Panel>

        <!--  Loading Overlay  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="4"
            Background="#88000000"
            IsVisible="{Binding IsLoading}"
            ZIndex="100">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="15">
                <ProgressBar
                    Width="200"
                    Height="4"
                    CornerRadius="2"
                    Foreground="{DynamicResource SystemAccentColor}"
                    IsIndeterminate="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="Medium"
                    Foreground="White"
                    Opacity="0.9"
                    Text="{DynamicResource l.sync.loading.from_mal}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
