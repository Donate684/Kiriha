<UserControl
    x:Class="Kiriha.Views.Analytics.AnalyticsHeroBanner"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics"
    x:DataType="vmAnalytics:AnalyticsViewModel">
    <Border
        Margin="20,8,20,14"
        Background="{DynamicResource CardBackgroundFillDefault}"
        BorderBrush="{DynamicResource CardStrokeColorDefault}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="14">
        <Panel>
            <!--  Градиентный тинт слева  -->
            <Border CornerRadius="14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="85%,100%">
                        <GradientStop Offset="0" Color="#1A2D7DD2" />
                        <GradientStop Offset="0.6" Color="#007B61FF" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  Акцентная полоса сверху  -->
            <Border
                Height="3"
                VerticalAlignment="Top"
                CornerRadius="14,14,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Offset="0" Color="#FF7B61FF" />
                        <GradientStop Offset="0.5" Color="#FF2D7DD2" />
                        <GradientStop Offset="1" Color="#FF2E9D62" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!--  Основной контент  -->
            <Grid
                Margin="20,18,20,18"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="18">

                <!--  Аватар с градиентным кольцом  -->
                <Panel
                    Width="62"
                    Height="62"
                    VerticalAlignment="Center">
                    <!--  Кольцо (градиентный фон)  -->
                    <Border CornerRadius="31">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#FF7B61FF" />
                                <GradientStop Offset="1" Color="#FF2D7DD2" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!--  Внутренний круг  -->
                    <Border
                        Width="54"
                        Height="54"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundFillDefault}"
                        CornerRadius="27">
                        <material:MaterialIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SystemAccentColor}"
                            Kind="AccountCircle" />
                    </Border>
                </Panel>

                <!--  Заголовок  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="5">
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="{DynamicResource l.analytics.hero_title}" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.5"
                        Text="{DynamicResource l.analytics.hero_subtitle}" />
                </StackPanel>

                <!--  Декоративные стат-пузыри (2 ключевых показателя)  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">

                    <!--  Всего тайтлов  -->
                    <Border Padding="14,10" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#1A7B61FF" />
                                <GradientStop Offset="1" Color="#0D2D7DD2" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="22"
                                FontWeight="Light"
                                Foreground="{DynamicResource AnalyticsSectionPurpleBrush}"
                                Text="{Binding Overview.Metrics[0].Value}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                Opacity="0.55"
                                Text="{Binding Overview.Metrics[0].Label}" />
                        </StackPanel>
                    </Border>

                    <!--  Завершено  -->
                    <Border Padding="14,10" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#162E9D62" />
                                <GradientStop Offset="1" Color="#0D2D7DD2" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="22"
                                FontWeight="Light"
                                Foreground="{DynamicResource AnalyticsSectionGreenBrush}"
                                Text="{Binding Overview.Metrics[1].Value}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                Opacity="0.55"
                                Text="{Binding Overview.Metrics[1].Label}" />
                        </StackPanel>
                    </Border>

                    <!--  Средняя оценка  -->
                    <Border Padding="14,10" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#1AD17A22" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="22"
                                FontWeight="Light"
                                Foreground="{DynamicResource AnalyticsSectionOrangeBrush}"
                                Text="{Binding Overview.Metrics[2].Value}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                Opacity="0.55"
                                Text="{Binding Overview.Metrics[2].Label}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Panel>
    </Border>
</UserControl>
