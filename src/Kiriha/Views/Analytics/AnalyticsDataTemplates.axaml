<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Kiriha.Core"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics">

    <!--  ═══ MetricTemplate — крупная карточка с иконкой и большой цифрой ═══  -->
    <DataTemplate x:Key="MetricTemplate" x:DataType="vmAnalytics:AnalyticsMetric">
        <Border Margin="0,0,10,0" Classes="AnalyticsPanel MetricPanel">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                <TextBlock
                    FontSize="11"
                    FontWeight="Medium"
                    LetterSpacing="0.5"
                    Opacity="0.55"
                    Text="{Binding Label}" />
                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    FontSize="32"
                    FontWeight="Light"
                    Text="{Binding Value}" />
                <TextBlock
                    Grid.Row="2"
                    FontSize="10.5"
                    Opacity="0.42"
                    Text="{Binding Hint}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!--  ═══ BarTemplate — строка прогресса ═══  -->
    <DataTemplate x:Key="BarTemplate" x:DataType="vmAnalytics:AnalyticsBar">
        <Grid Margin="0,0,0,11" RowDefinitions="Auto,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    FontSize="12"
                    MaxLines="1"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Opacity="0.65"
                    Text="{Binding Value}" />
            </Grid>
            <ProgressBar
                Grid.Row="1"
                Margin="0,5,0,0"
                Classes="AnalyticsBar"
                Value="{Binding Percent}" />
        </Grid>
    </DataTemplate>

    <!--  ═══ StatusTileTemplate — плитка статуса с акцент-полосой ═══  -->
    <DataTemplate x:Key="StatusTileTemplate" x:DataType="vmAnalytics:AnalyticsBar">
        <Border
            Margin="0,0,8,8"
            Padding="0"
            Background="{DynamicResource SubtleFillColorTertiary}"
            ClipToBounds="True"
            CornerRadius="10">
            <Grid ColumnDefinitions="4,*">
                <!--  Цветная полоса акцента слева  -->
                <Border
                    Grid.Column="0"
                    Background="{Binding Accent}"
                    CornerRadius="10,0,0,10" />

                <Grid
                    Grid.Column="1"
                    Margin="10,10,10,10"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{Binding Label}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Grid.Column="1"
                            Padding="8,2"
                            Background="{Binding Accent}"
                            CornerRadius="8">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Value}" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        FontSize="10.5"
                        Opacity="0.52"
                        Text="{Binding ShareText}" />
                    <ProgressBar
                        Grid.Row="2"
                        Classes="AnalyticsBar"
                        Foreground="{Binding Accent}"
                        Value="{Binding Percent}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!--  ═══ TasteHighlightTemplate ═══  -->
    <DataTemplate x:Key="TasteHighlightTemplate" x:DataType="vmAnalytics:AnalyticsBar">
        <Border
            MinHeight="112"
            Margin="0,0,10,0"
            Classes="AnalyticsPanel">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border
                    Width="30"
                    Height="4"
                    HorizontalAlignment="Left"
                    Background="{Binding Accent}"
                    CornerRadius="2" />
                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        FontSize="11"
                        Opacity="0.62"
                        Text="{Binding Value, StringFormat='{}{0} тайтл.'}" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.42"
                        Text="{Binding ShareText, StringFormat='лидер {0}'}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!--  ═══ TasteRowTemplate — ranked-строка жанра/студии ═══  -->
    <DataTemplate x:Key="TasteRowTemplate" x:DataType="vmAnalytics:AnalyticsBar">
        <Border
            Margin="0,0,0,8"
            Padding="10,9"
            Background="{DynamicResource SubtleFillColorTertiary}"
            CornerRadius="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border
                    Width="8"
                    Height="34"
                    VerticalAlignment="Center"
                    Background="{Binding Accent}"
                    CornerRadius="4" />
                <StackPanel Grid.Column="1" Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{Binding Label}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.65"
                            Text="{Binding Value}" />
                    </Grid>
                    <ProgressBar
                        Classes="AnalyticsBar"
                        Foreground="{Binding Accent}"
                        Value="{Binding Percent}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.45"
                    Text="{Binding ShareText}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!--  ═══ ReleaseYearTemplate ═══  -->
    <DataTemplate x:Key="ReleaseYearTemplate" x:DataType="vmAnalytics:AnalyticsBar">
        <Border
            Height="62"
            Margin="2"
            Background="{DynamicResource SubtleFillColorTertiary}"
            ClipToBounds="True"
            CornerRadius="8">
            <Grid ColumnDefinitions="4,*">
                <Border
                    Grid.Column="0"
                    Background="{Binding Accent}"
                    CornerRadius="8,0,0,8" />
                <Grid
                    Grid.Column="1"
                    Margin="8,6,8,4"
                    RowDefinitions="Auto,*">
                    <TextBlock
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Opacity="0.55"
                        Text="{Binding Label}" />
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Bottom"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding Value}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!--  ═══ FavoriteRowTemplate — кликабельная ranked-строка ═══  -->
    <DataTemplate x:Key="FavoriteRowTemplate" x:DataType="vmAnalytics:AnalyticsFavoriteRow">
        <Button
            Classes="FavoriteRowButton"
            Command="{Binding $parent[UserControl].((vmAnalytics:AnalyticsViewModel)DataContext).History.OpenFavoriteCommand}"
            CommandParameter="{Binding}"
            ToolTip.Tip="{DynamicResource l.analytics.tastes.show_titles}">
            <Border
                Margin="0,0,0,8"
                Padding="0"
                Background="{DynamicResource SubtleFillColorTertiary}"
                ClipToBounds="True"
                CornerRadius="10">
                <Grid ColumnDefinitions="4,*">
                    <!--  Цветная полоса акцента слева  -->
                    <Border
                        Grid.Column="0"
                        Background="{Binding Accent}"
                        CornerRadius="10,0,0,10" />

                    <Grid
                        Grid.Column="1"
                        Margin="10,10,10,10"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="5">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                FontWeight="Bold"
                                Foreground="{Binding Accent}"
                                Text="{Binding Rank, StringFormat='{}#{0}'}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Grid.Column="2"
                                Padding="8,2"
                                Background="{Binding Accent}"
                                CornerRadius="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding WeightedScore}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            FontSize="10.5"
                            MaxLines="1"
                            Opacity="0.52"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis" />
                        <ProgressBar
                            Grid.Row="2"
                            Classes="AnalyticsBar"
                            Foreground="{Binding Accent}"
                            Value="{Binding Percent}" />
                    </Grid>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

    <!--  ═══ ProfileTodoTemplate — карточка «что посмотреть» ═══  -->
    <DataTemplate x:Key="ProfileTodoTemplate" x:DataType="vmAnalytics:ProfileTodoItem">
        <Border
            Margin="0,0,0,8"
            Padding="0"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource SubtleFillColorTertiary}"
            ClipToBounds="True"
            CornerRadius="10">
            <Grid ColumnDefinitions="4,*">
                <!--  Цветная полоса акцента слева  -->
                <Border
                    Grid.Column="0"
                    Background="{Binding Accent}"
                    CornerRadius="10,0,0,10" />

                <Grid
                    Grid.Column="1"
                    MinWidth="0"
                    Margin="10"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12">
                    <!--  Постер с закруглёнными краями  -->
                    <Border
                        Width="44"
                        Height="62"
                        Background="{DynamicResource SubtleFillColorSecondary}"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <Panel>
                            <material:MaterialIcon
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="ImageOutline"
                                Opacity="0.22" />
                            <Image core:CachedImage.Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                        </Panel>
                    </Border>

                    <!--  Информация  -->
                    <Grid
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        RowDefinitions="Auto,Auto,Auto">
                        <TextBlock
                            Margin="0,0,0,3"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,0,3"
                            FontSize="10.5"
                            Foreground="{DynamicResource SystemAccentColor}"
                            IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            MaxLines="1"
                            Opacity="0.75"
                            Text="{Binding Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="2"
                            FontSize="11"
                            MaxLines="1"
                            Opacity="0.52"
                            Text="{Binding Detail}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!--  Бейдж  -->
                    <Border
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        Background="{Binding Accent}"
                        CornerRadius="8">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding Badge}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>


