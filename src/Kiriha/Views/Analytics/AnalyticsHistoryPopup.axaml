<UserControl
    x:Class="Kiriha.Views.Analytics.AnalyticsHistoryPopup"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Kiriha.Core"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:u="using:Kiriha.Utils.UI"
    xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics"
    x:DataType="vmAnalytics:AnalyticsViewModel">
    <!--  ═══ ИСТОРИЯ POPUP ═══  -->
    <Border
        Background="{DynamicResource ModalOverlayBackgroundBrush}"
        IsVisible="{Binding History.IsHistoryPopupOpen}"
        ZIndex="50">
        <Grid>
            <Button
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding History.CloseHistoryPopupCommand}" />

            <Border
                Width="560"
                MaxHeight="640"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ModalBackgroundFill}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                BoxShadow="0 20 60 0 #70000000"
                ClipToBounds="True"
                CornerRadius="14">
                <Grid RowDefinitions="Auto,*">

                    <!--  Шапка попапа  -->
                    <Border
                        Grid.Row="0"
                        Padding="20,16"
                        Background="{DynamicResource SubtleFillColorSecondary}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding History.HistoryPopupTitle}" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.52"
                                    Text="{Binding History.HistoryPopupSubtitle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding History.CloseHistoryPopupCommand}"
                                CornerRadius="16">
                                <material:MaterialIcon
                                    Width="18"
                                    Height="18"
                                    Kind="Close"
                                    Opacity="0.65" />
                            </Button>
                        </Grid>
                    </Border>

                    <!--  Список записей  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Padding="16"
                        u:SmoothScroll.IsEnabled="True"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{Binding History.HistoryPopupEntries}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vmAnalytics:AnalyticsHistoryEntry">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{DynamicResource CardBackgroundFillDefault}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefault}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border
                                                Width="44"
                                                Height="60"
                                                Background="{DynamicResource SubtleFillColorSecondary}"
                                                ClipToBounds="True"
                                                CornerRadius="7">
                                                <Panel>
                                                    <material:MaterialIcon
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Kind="ImageOutline"
                                                        Opacity="0.22" />
                                                    <Image core:CachedImage.Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="3">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource SystemAccentColor}"
                                                    IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    MaxLines="1"
                                                    Opacity="0.75"
                                                    Text="{Binding Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Opacity="0.58"
                                                Text="{Binding Detail}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
