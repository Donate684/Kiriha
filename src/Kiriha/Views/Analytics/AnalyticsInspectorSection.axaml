<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:core="using:Kiriha.Core"
             x:Class="Kiriha.Views.Analytics.AnalyticsInspectorSection"
             x:DataType="vmAnalytics:AnalyticsViewModel"
             x:Name="inspectorRoot">

    <StackPanel Spacing="16"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding IsInspectorSelected}">

        <!-- ═══ СВОДНАЯ КАРТОЧКА ЗДОРОВЬЯ БИБЛИОТЕКИ И ПАКЕТНЫХ ДЕЙСТВИЙ ═══ -->
        <Border Classes="AnalyticsPanel">
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">

                <!-- Левая часть: Health Score & Заголовок -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto, *" ColumnSpacing="14" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="14"
                            Background="{DynamicResource SubtleFillColorSecondary}"
                            VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding Inspector.HealthScore, StringFormat='{}{0}%'}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{Binding Inspector.HealthStatusColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource l.analytics.inspector.health_score}"
                                       FontSize="8" Opacity="0.5"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource l.analytics.inspector.title}"
                                       FontSize="16" FontWeight="SemiBold"/>
                            <Border Background="{Binding Inspector.HealthStatusColor}"
                                    CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Inspector.HealthStatusText}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource l.analytics.inspector.subtitle}"
                                   FontSize="11" Opacity="0.55" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Правая часть: Кнопка глубокого парсинга -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Subtle"
                            Command="{Binding Inspector.OpenDeepParserCommand}"
                            ToolTip.Tip="{DynamicResource l.analytics.inspector.deep_parser_title}"
                            Height="34" CornerRadius="8" Padding="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="CloudDownloadOutline" Width="15" Height="15"/>
                            <TextBlock Text="{DynamicResource l.analytics.inspector.deep_parser_button}"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Сообщение о пакетном результате (если есть) -->
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding Inspector.StatusMessage}"
                           FontSize="11.5" Foreground="{DynamicResource SystemAccentColor}"
                           Margin="0,8,0,0"
                           IsVisible="{Binding Inspector.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Grid>
        </Border>

        <!-- ═══ ФИЛЬТРЫ ПО КАТЕГОРИЯМ (CHIPS) ═══ -->
        <Border Padding="4"
                Background="{DynamicResource SubtleFillColorSecondary}"
                CornerRadius="10"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- Все проблемы -->
                <Button Classes="SectionTab"
                        Command="{Binding Inspector.SetFilterCategoryCommand}"
                        CommandParameter="{x:Static vmAnalytics:InspectorFilterCategory.All}"
                        CornerRadius="8" Padding="10,6"
                        Background="{DynamicResource SubtleFillColorTertiary}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{DynamicResource l.analytics.inspector.all_issues}" FontSize="11.5" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Inspector.IssuesCount}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Даты -->
                <Button Classes="SectionTab"
                        Command="{Binding Inspector.SetFilterCategoryCommand}"
                        CommandParameter="{x:Static vmAnalytics:InspectorFilterCategory.Dates}"
                        CornerRadius="8" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="CalendarClock" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource l.analytics.inspector.missing_dates}" FontSize="11.5" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SubtleFillColorSecondary}" CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Inspector.MissingDatesCount}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Оценки -->
                <Button Classes="SectionTab"
                        Command="{Binding Inspector.SetFilterCategoryCommand}"
                        CommandParameter="{x:Static vmAnalytics:InspectorFilterCategory.Scores}"
                        CornerRadius="8" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="StarOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource l.analytics.inspector.missing_scores}" FontSize="11.5" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SubtleFillColorSecondary}" CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Inspector.MissingScoresCount}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Статусы и серии -->
                <Button Classes="SectionTab"
                        Command="{Binding Inspector.SetFilterCategoryCommand}"
                        CommandParameter="{x:Static vmAnalytics:InspectorFilterCategory.StatusAndProgress}"
                        CornerRadius="8" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="PlaylistCheck" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource l.analytics.inspector.status_mismatch}" FontSize="11.5" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource SubtleFillColorSecondary}" CornerRadius="6" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Inspector.StatusMismatchCount}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ СОСТОЯНИЕ УСПЕХА: НЕТ ПРОБЛЕМ ═══ -->
        <Border Classes="AnalyticsPanel"
                IsVisible="{Binding !Inspector.HasIssues}"
                Padding="32" HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{DynamicResource SubtleFillColorSecondary}"
                        HorizontalAlignment="Center">
                    <material:MaterialIcon Kind="CheckDecagram" Width="36" Height="36"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource l.analytics.inspector.no_issues_title}"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource l.analytics.inspector.no_issues_desc}"
                           FontSize="12" Opacity="0.6"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           MaxWidth="420" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══ СПИСОК КАРТОЧЕК ПРОБЛЕМ ═══ -->
        <ItemsControl ItemsSource="{Binding Inspector.FilteredIssues}"
                      IsVisible="{Binding Inspector.HasIssues}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmAnalytics:ProfileIssueItem">
                    <Border Background="{DynamicResource SubtleFillColorTertiary}"
                            CornerRadius="10"
                            Margin="0,0,0,8"
                            ClipToBounds="True"
                            BorderBrush="{DynamicResource CardStrokeColorDefault}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="4, *">
                            <!-- Цветная полоса акцента категории -->
                            <Border Grid.Column="0"
                                    Background="{Binding AccentColor}"
                                    CornerRadius="10,0,0,10"/>

                            <Grid Grid.Column="1" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Margin="10">
                                <!-- Постер тайтла -->
                                <Border Width="44" Height="62" CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                        VerticalAlignment="Center">
                                    <Panel>
                                        <material:MaterialIcon Kind="ImageOutline" Width="18" Height="18"
                                                               Opacity="0.25"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image core:CachedImage.Source="{Binding PosterUrl}"
                                               Stretch="UniformToFill"/>
                                    </Panel>
                                </Border>

                                <!-- Информация о тайтле и проблеме -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" MinWidth="0">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                        <!-- Бейдж текущего статуса -->
                                        <Border Background="{Binding StatusAccent}"
                                                CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>

                                        <!-- Название тайтла -->
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Заголовок проблемы -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                        <material:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14"
                                                               Foreground="{Binding AccentColor}"
                                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding IssueTitle}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding AccentColor}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Описание проблемы -->
                                    <TextBlock Text="{Binding IssueDescription}"
                                               FontSize="11" Opacity="0.6"
                                               MaxLines="2" TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Кнопки действий справа -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- Быстрое исправление -->
                                    <Button Command="{Binding #inspectorRoot.((vmAnalytics:AnalyticsViewModel)DataContext).Inspector.FixIssueCommand}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource SystemAccentColor}"
                                            Foreground="White"
                                            CornerRadius="7" Height="32" Padding="10,0"
                                            BorderThickness="0">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <material:MaterialIcon Kind="LightningBolt" Width="13" Height="13"/>
                                            <TextBlock Text="{Binding ActionLabel}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Открыть редактор деталей -->
                                    <Button Command="{Binding #inspectorRoot.((vmAnalytics:AnalyticsViewModel)DataContext).Inspector.OpenDetailsCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{DynamicResource l.analytics.inspector.action_details}"
                                            Width="32" Height="32" CornerRadius="7" Padding="0"
                                            Background="{DynamicResource ControlFillColorDefault}">
                                        <material:MaterialIcon Kind="SquareEditOutline" Width="15" Height="15" Opacity="0.75"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Height="80" IsHitTestVisible="False"/>
    </StackPanel>
</UserControl>
