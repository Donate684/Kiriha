<UserControl
    x:Class="Kiriha.Views.Analytics.AnalyticsOverviewSection"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics"
    x:DataType="vmAnalytics:AnalyticsViewModel">
    <StackPanel
        HorizontalAlignment="Stretch"
        IsVisible="{Binding IsOverviewSelected}"
        Spacing="16">

        <!--  Мой список + Распределение оценок  -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

            <!--  Мой список  -->
            <Border VerticalAlignment="Top" Classes="AnalyticsPanel">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemAccentColor}"
                            CornerRadius="8">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="PlaylistCheck" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{DynamicResource l.analytics.overview.my_list}" />
                            <TextBlock
                                FontSize="10.5"
                                Opacity="0.45"
                                Text="{DynamicResource l.analytics.overview.by_status}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemTemplate="{StaticResource StatusTileTemplate}" ItemsSource="{Binding Overview.StatusDistribution}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Распределение оценок — вертикальный гистограмм  -->
            <Border
                Grid.Column="1"
                VerticalAlignment="Top"
                Classes="AnalyticsPanel">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AnalyticsSectionGreenBrush}"
                            CornerRadius="8">
                            <material:MaterialIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="StarOutline" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{DynamicResource l.analytics.overview.scores}" />
                            <TextBlock
                                FontSize="10.5"
                                Opacity="0.45"
                                Text="{DynamicResource l.analytics.overview.score_distribution}" />
                        </StackPanel>
                    </Grid>

                    <!--  Вертикальный chart —  10 → 1 слева направо  -->
                    <ItemsControl ItemsSource="{Binding Overview.ScoreDistribution}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmAnalytics:AnalyticsBar">
                                <Grid Margin="2,0" RowDefinitions="Auto,72,Auto">

                                    <!--  Кол-во сверху  -->
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Opacity="0.6"
                                        Text="{Binding Value}" />

                                    <!--  Область бара фиксированной высоты  -->
                                    <Grid Grid.Row="1">
                                        <!--  Фоновый трек  -->
                                        <Border
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource SubtleFillColorSecondary}"
                                            CornerRadius="4" />
                                        <!--  Цветной бар от низа  -->
                                        <Border
                                            Height="{Binding BarHeight}"
                                            VerticalAlignment="Bottom"
                                            Background="{Binding Accent}"
                                            CornerRadius="4,4,0,0" />
                                    </Grid>

                                    <!--  Оценка снизу  -->
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Opacity="0.7"
                                        Text="{Binding Label}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                </StackPanel>
            </Border>
        </Grid>

        <Border Height="110" IsHitTestVisible="False" />
    </StackPanel>

    <!--  ══════════ СЕКЦИЯ: ВКУСЫ ══════════  -->
</UserControl>


