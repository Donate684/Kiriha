<Window
    x:Class="Kiriha.Views.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kiriha.Views.Controls"
    xmlns:m="using:Kiriha.Models"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:views="using:Kiriha.Views"
    Title=""
    Width="860"
    Height="530"
    MinWidth="500"
    MinHeight="400"
    x:DataType="views:AboutWindow"
    Background="{x:Null}"
    ExtendClientAreaTitleBarHeightHint="34"
    ExtendClientAreaToDecorationsHint="True"
    Icon="/Assets/kiriha.ico"
    TransparencyBackgroundFallback="Transparent"
    TransparencyLevelHint="Mica, AcrylicBlur"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterOwner">

    <Window.Styles>

        <!--  ─── Section caption ───  -->
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="2.4" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!--  ─── Comfortable pill chip ───  -->
        <Style Selector="Button.Chip">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.Chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>

        <!--  Tonal version pill  -->
        <Style Selector="Border.VersionChip">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Divider  -->
        <Style Selector="Border.Divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefault}" />
            <Setter Property="Margin" Value="0,14,0,14" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>

    </Window.Styles>

    <LayoutTransformControl Name="ScaleRoot">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </LayoutTransformControl.LayoutTransform>
        <Grid PointerPressed="OnTitleBarPressed" RowDefinitions="34,*">

            <!--  Drag-area  -->
            <Border Grid.Row="0" Background="Transparent" />

            <!--  Custom Caption Buttons  -->
            <controls:TitleBarButtons
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                ZIndex="999" />

            <!--  ═══ Body ═══  -->
            <Panel Grid.Row="1" ClipToBounds="True">

                <!--  Background halo (left-tinted)  -->
                <Ellipse
                    Width="800"
                    Height="800"
                    Margin="-300,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight2}" />
                            <GradientStop Offset="0.5" Color="{DynamicResource SystemAccentColor}" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!--  Two-column layout with broader columns  -->
                <Grid Margin="24,16,20,16" ColumnDefinitions="310,1,*">

                    <!--  ── Vertical separator ──  -->
                    <Border
                        Grid.Column="1"
                        Width="1"
                        Margin="0,8,0,8"
                        Background="{DynamicResource CardStrokeColorDefault}"
                        Opacity="0.35" />

                    <!--  ── LEFT: Hero ──  -->
                    <StackPanel
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top"
                        Spacing="0">

                        <controls:LeafLogo
                            Width="128"
                            Height="128"
                            HorizontalAlignment="Center"
                            ShowHalo="False" />

                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontSize="34"
                            FontWeight="Thin"
                            LetterSpacing="6"
                            Opacity="0.95"
                            Text="Kiriha" />

                        <Border
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Classes="VersionChip">
                            <TextBlock
                                Name="VersionLabel"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemAccentColor}"
                                LetterSpacing="2.2"
                                Opacity="0.85" />
                        </Border>

                        <TextBlock
                            Margin="0,14,0,0"
                            FontSize="12"
                            LineHeight="17"
                            Opacity="0.55"
                            Text="{DynamicResource l.about.description}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <Border Classes="Divider" />

                        <TextBlock
                            FontSize="10"
                            LineHeight="14"
                            Opacity="0.4"
                            Text="{DynamicResource l.about.license_note}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  ── RIGHT: Credits ──  -->
                    <ScrollViewer
                        Grid.Column="2"
                        Margin="20,0,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="0">

                            <!--  Data Sources  -->
                            <TextBlock
                                Margin="0,6,0,6"
                                Classes="SectionHeader"
                                Text="{DynamicResource l.about.data_sources}" />
                            <ItemsControl ItemsSource="{Binding DataSources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:CenteredWrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:CreditEntry">
                                        <Button
                                            Classes="Chip"
                                            Click="OnEntryClick"
                                            Tag="{Binding Url}"
                                            ToolTip.Tip="{Binding Note}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <material:MaterialIcon
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Kind="Database"
                                                    Opacity="0.65" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Inspirations  -->
                            <TextBlock
                                Margin="0,16,0,6"
                                Classes="SectionHeader"
                                Text="{DynamicResource l.about.inspirations}" />
                            <ItemsControl ItemsSource="{Binding Inspirations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:CenteredWrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:CreditEntry">
                                        <Button
                                            Classes="Chip"
                                            Click="OnEntryClick"
                                            Tag="{Binding Url}"
                                            ToolTip.Tip="{Binding Note}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <material:MaterialIcon
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Kind="LightbulbOutline"
                                                    Opacity="0.65" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--  Libraries  -->
                            <TextBlock
                                Margin="0,16,0,6"
                                Classes="SectionHeader"
                                Text="{DynamicResource l.about.libraries}" />
                            <ItemsControl ItemsSource="{Binding Libraries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:CenteredWrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:CreditEntry">
                                        <Button
                                            Classes="Chip"
                                            Click="OnEntryClick"
                                            Tag="{Binding Url}"
                                            ToolTip.Tip="{Binding Note}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <material:MaterialIcon
                                                    Width="12"
                                                    Height="12"
                                                    VerticalAlignment="Center"
                                                    Kind="Package"
                                                    Opacity="0.65" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Panel>

        </Grid>
    </LayoutTransformControl>
</Window>
