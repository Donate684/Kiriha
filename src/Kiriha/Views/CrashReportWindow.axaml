<Window
    x:Class="Kiriha.Views.CrashReportWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmDialogs="using:Kiriha.ViewModels.Dialogs"
    Title="{DynamicResource l.crash.title}"
    Width="780"
    Height="560"
    MinWidth="520"
    MinHeight="360"
    x:DataType="vmDialogs:CrashReportViewModel"
    Background="{DynamicResource ModalBackgroundFill}"
    Icon="/Assets/kiriha.ico"
    WindowStartupLocation="CenterScreen">

    <LayoutTransformControl Name="ScaleRoot">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </LayoutTransformControl.LayoutTransform>
        <Grid
            Margin="20"
            ColumnDefinitions="*"
            RowDefinitions="Auto,Auto,*,Auto,Auto">

            <TextBlock
                Grid.Row="0"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{DynamicResource l.crash.heading}" />

            <TextBlock
                Grid.Row="1"
                Margin="0,6,0,12"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Opacity="0.75"
                Text="{DynamicResource l.crash.subtitle}"
                TextWrapping="Wrap" />

            <Border
                Grid.Row="2"
                Padding="2"
                Background="{DynamicResource CardBackgroundFillSecondary}"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBox
                    VerticalContentAlignment="Top"
                    AcceptsReturn="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas, Cascadia Mono, Menlo, monospace"
                    FontSize="12"
                    IsReadOnly="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{Binding ReportText, Mode=OneWay}"
                    TextWrapping="NoWrap" />
            </Border>

            <TextBlock
                Grid.Row="3"
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Opacity="0.85"
                Text="{Binding StatusText}" />

            <StackPanel
                Grid.Row="4"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{Binding OpenFolderCommand}" Content="{DynamicResource l.crash.button.open_folder}" />
                <Button Command="{Binding CopyCommand}" Content="{DynamicResource l.crash.button.copy}" />
                <Button
                    Classes="accent"
                    Click="OnCloseClick"
                    Content="{DynamicResource l.crash.button.close}" />
            </StackPanel>
        </Grid>
    </LayoutTransformControl>
</Window>
