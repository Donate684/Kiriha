<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
        xmlns:vmStartup="using:Kiriha.ViewModels.Startup"
        xmlns:vmDialogs="using:Kiriha.ViewModels.Dialogs"
        xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
        xmlns:vmMain="using:Kiriha.ViewModels.Main"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Kiriha.ViewModels"
        xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:controls="using:Kiriha.Views.Controls"
        xmlns:playerControls="using:Kiriha.Views.Player.Controls"
        xmlns:conv="using:Kiriha.Views.Converters"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Kiriha.Views.Player.PlayerWindow"
        x:DataType="vmPlayer:PlayerViewModel"
        Title="{Binding TrackingTitle}"
        Background="Black"
        TransparencyLevelHint="Mica, AcrylicBlur, Transparent"
        TransparencyBackgroundFallback="Black"
        Width="960" Height="540"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="34"
        WindowDecorations="BorderOnly"
        DragDrop.AllowDrop="True">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kiriha/Views/Styles/PlayerOverlayWindowResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://Kiriha/Views/Styles/PlayerSliderStyles.axaml"/>
        <StyleInclude Source="avares://Kiriha/Views/Styles/PlayerControlStyles.axaml"/>
        <StyleInclude Source="avares://Kiriha/Views/Styles/PlayerSettingsStyles.axaml"/>
        <StyleInclude Source="avares://Kiriha/Views/Styles/PlayerOsdStyles.axaml"/>
    </Window.Styles>

    <Grid Background="Black" Name="MainGrid"
          PointerMoved="OnGridPointerMoved"
          PointerExited="OnGridPointerExited"
          PointerPressed="OnBackgroundPointerPressed"
          PointerWheelChanged="OnBackgroundPointerWheelChanged"
          DoubleTapped="OnBackgroundDoubleTapped">
        
        <!-- Base Video Layer -->
        <controls:MpvOpenGlVideoView x:Name="VideoHost"/>

        <!-- Minimal Center Accent Spinner (Clean, modern streaming style) -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False"
                IsVisible="{Binding IsBufferingOrLoading}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <material:MaterialIcon Kind="Loading" Width="44" Height="44"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   Opacity="0.85">
                <material:MaterialIcon.Styles>
                    <Style Selector="material|MaterialIcon">
                        <Style.Animations>
                            <Animation Duration="0:0:1.0" IterationCount="Infinite">
                                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </material:MaterialIcon.Styles>
            </material:MaterialIcon>
        </Border>

        <!-- Playback Error Panel -->
        <Border Classes="player-state-panel error"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding HasPlaybackError}">
            <StackPanel Spacing="12" Width="340">
                <material:MaterialIcon Kind="AlertCircleOutline"
                                       Width="32"
                                       Height="32"
                                       Foreground="#FFFFD166"
                                       HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource l.player.overlay.error_failed_to_play}"
                           Classes="overlay-text"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextAlignment="Center"/>
                <TextBlock Text="{Binding PlaybackErrorMessage}"
                           Foreground="#BFFFFFFF"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Classes="icon-btn state-action"
                            Command="{Binding ReloadMediaCommand}"
                            ToolTip.Tip="{DynamicResource l.player.overlay.error_retry}">
                        <material:MaterialIcon Kind="Refresh" Width="20" Height="20" Foreground="White"/>
                    </Button>
                    <Button Classes="icon-btn state-action"
                            Command="{Binding OpenNextMediaCommand}"
                            IsEnabled="{Binding CanOpenNextMedia}"
                            ToolTip.Tip="{DynamicResource l.player.overlay.error_next_file}">
                        <material:MaterialIcon Kind="SkipNext" Width="20" Height="20" Foreground="White"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== TOP GRADIENT + BAR (Cinematic Header & Unified Inline Stream HUD) ===== -->
        <Border Name="TopBar" VerticalAlignment="Top"
                CornerRadius="8,8,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#68000000" Offset="0"/>
                    <GradientStop Color="#28000000" Offset="0.55"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>

            <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Top"
                  Background="Transparent" PointerPressed="OnTopBarPointerPressed"
                  Margin="0,0,0,10">

                <!-- Left: Anime Title, Episode / Romaji & Inline Dynamic Telemetry/Toasts -->
                <StackPanel Grid.Column="0"
                            Spacing="2"
                            VerticalAlignment="Top"
                            Margin="24,14,0,0"
                            MaxWidth="850">
                    <!-- Primary Russian/Romaji Anime Title -->
                    <TextBlock Classes="overlay-text"
                               Text="{Binding TopTitle}"
                               Foreground="White" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Opacity="0.98"/>

                    <!-- Row 2: Episode Title | Romaji / English Title -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,0,0">
                        <TextBlock Classes="overlay-secondary-text"
                                   Text="{Binding EpisodeTitle}"
                                   Foreground="#E6FFFFFF" FontSize="13.5"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding EpisodeTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Classes="overlay-secondary-text"
                                   Text="|"
                                   Foreground="#B3FFFFFF" FontSize="13.5"
                                   IsVisible="{Binding HasEpisodeAndBottom}"/>
                        <TextBlock Classes="overlay-secondary-text"
                                   Text="{Binding BottomTitle}"
                                   Foreground="#CCFFFFFF" FontSize="13.5"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasBottomTitle}"/>
                    </StackPanel>

                    <!-- Row 3: Organic Inline Status (OSD & Torrent Telemetry, No Bubbles) -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,0,0">

                        <!-- Inline OSD Notification (Volume, Tracks, Subtitles) -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                    IsVisible="{Binding Overlay.IsOsdVisible}">
                            <material:MaterialIcon Classes="overlay-icon"
                                                   Kind="InformationOutline" Width="13" Height="13"
                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                   VerticalAlignment="Center"/>
                            <TextBlock Classes="overlay-secondary-text"
                                       Text="{Binding Overlay.OsdMessage}"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Classes="overlay-secondary-text"
                                       Text="{Binding Overlay.OsdDetail}"
                                       Foreground="White" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding Overlay.OsdDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Classes="overlay-secondary-text"
                                       Text="|"
                                       Foreground="#80FFFFFF" FontSize="13"
                                       IsVisible="{Binding IsTorrentStream}"/>
                        </StackPanel>

                        <!-- Inline Torrent Telemetry Strip (ALWAYS visible when streaming torrents) -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding IsTorrentStream}"
                                    ToolTip.Tip="{Binding TorrentDetailsTooltip}">

                            <!-- Active Buffering / Rebuffering Indicator -->
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                        IsVisible="{Binding IsBufferingOrLoading}">
                                <material:MaterialIcon Classes="overlay-icon"
                                                       Kind="Loading" Width="13" Height="13"
                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                       VerticalAlignment="Center">
                                    <material:MaterialIcon.Styles>
                                        <Style Selector="material|MaterialIcon">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.0" IterationCount="Infinite">
                                                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </material:MaterialIcon.Styles>
                                </material:MaterialIcon>
                                <TextBlock Classes="overlay-secondary-text"
                                           Text="{Binding StreamStatusBadgeText}"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="overlay-secondary-text"
                                           Text="{Binding TorrentBufferPercent, StringFormat='{}{0:0}%'}"
                                           Foreground="White" FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Classes="overlay-secondary-text"
                                           Text="|"
                                           Foreground="#80FFFFFF" FontSize="13"/>
                            </StackPanel>

                            <!-- Torrent Speed -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        IsVisible="{Binding TorrentDownloadSpeedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <material:MaterialIcon Classes="overlay-icon"
                                                       Kind="LightningBolt" Width="13" Height="13"
                                                       Foreground="#00E676" VerticalAlignment="Center"/>
                                <TextBlock Classes="overlay-secondary-text"
                                           Text="{Binding TorrentDownloadSpeedText}"
                                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Separator -->
                            <TextBlock Classes="overlay-secondary-text"
                                       Text="|"
                                       Foreground="#80FFFFFF" FontSize="13"
                                       IsVisible="{Binding TorrentPeersBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- Torrent Peers -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        IsVisible="{Binding TorrentPeersBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <material:MaterialIcon Classes="overlay-icon"
                                                       Kind="AccountMultipleOutline" Width="13" Height="13"
                                                       Foreground="#E6FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Classes="overlay-secondary-text"
                                           Text="{Binding TorrentPeersBadgeText}"
                                           Foreground="White" FontSize="13"
                                           FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Separator -->
                            <TextBlock Classes="overlay-secondary-text"
                                       Text="|"
                                       Foreground="#80FFFFFF" FontSize="13"
                                       IsVisible="{Binding TorrentBufferText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- Preload Buffer / Cache text -->
                            <TextBlock Classes="overlay-secondary-text"
                                       Text="{Binding TorrentBufferText}"
                                       Foreground="#E6FFFFFF" FontSize="12.5"
                                       FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding TorrentBufferText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <!-- Non-Torrent Buffering Status (HTTP or local loading) -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                    IsVisible="{Binding ShowNonTorrentBuffering}">
                            <material:MaterialIcon Classes="overlay-icon"
                                                   Kind="Loading" Width="13" Height="13"
                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                   VerticalAlignment="Center">
                                <material:MaterialIcon.Styles>
                                    <Style Selector="material|MaterialIcon">
                                        <Style.Animations>
                                            <Animation Duration="0:0:1.0" IterationCount="Infinite">
                                                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0"/></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360"/></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </material:MaterialIcon.Styles>
                            </material:MaterialIcon>
                            <TextBlock Classes="overlay-secondary-text"
                                       Text="{Binding PlaybackStatusMessage}"
                                       Foreground="White" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Empty drag region -->
                <Grid Grid.Column="1" Background="Transparent" PointerPressed="OnTopBarPointerPressed"/>

                <!-- Right: Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0"
                            VerticalAlignment="Top">
                    <Button Classes="wnd-btn" Click="OnMinimizeClick">
                        <TextBlock Text="&#xE921;"/>
                    </Button>
                    <Button Classes="wnd-btn" Click="OnMaximizeClick">
                        <TextBlock Name="MaximizeIcon" Text="&#xE922;"/>
                    </Button>
                    <Button Name="CloseButton" Classes="wnd-btn close" Click="OnCloseClick">
                        <TextBlock Text="&#xE8BB;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BOTTOM GRADIENT + BAR (Cinematic Full-Width Scrubber & Controls) ===== -->
        <Border Name="BottomBar" VerticalAlignment="Bottom"
                CornerRadius="0,0,8,8" ClipToBounds="False"
                PointerPressed="OnBottomBarPointerPressed">
            <Border.Background>
                <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                    <GradientStop Color="#E6000000" Offset="0"/>
                    <GradientStop Color="#A0000000" Offset="0.5"/>
                    <GradientStop Color="#33000000" Offset="0.8"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>

            <StackPanel Margin="0,20,0,0">
                <!-- Timeline Preview Popup (Canvas) -->
                <Canvas Height="0"
                        HorizontalAlignment="Stretch"
                        IsHitTestVisible="False"
                        ZIndex="20">
                    <Border Width="236"
                            Height="160"
                            Canvas.Left="{Binding Overlay.TimelinePreviewLeft}"
                            Canvas.Top="-168"
                            IsVisible="{Binding Overlay.IsTimelinePreviewVisible}"
                            Background="#F0141414"
                            BorderBrush="#2AFFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            BoxShadow="0 12 36 0 #80000000"
                            Padding="6">
                        <Grid RowDefinitions="126,Auto">
                            <Border Grid.Row="0"
                                    Width="224"
                                    Height="126"
                                    Background="#FF050505"
                                    CornerRadius="6"
                                    ClipToBounds="True">
                                <Image Source="{Binding Overlay.TimelinePreviewImage}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Overlay.TimelinePreviewTime}"
                                       Foreground="White"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </Grid>
                    </Border>
                </Canvas>

                <!-- ===== FULL-WIDTH TIMELINE (Scrubber + Preload Buffer Bar) ===== -->
                <Grid Name="TimelineContainer"
                      Margin="24,0,24,6"
                      PointerMoved="OnTimelinePointerMoved"
                      PointerExited="OnTimelinePointerExited">
                    <!-- Preload Stream Buffer (Torrent RAM buffer bar) -->
                    <ProgressBar Name="TimelineBufferBar"
                                 Height="3.5"
                                 VerticalAlignment="Center"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding TorrentBufferPercent}"
                                 IsIndeterminate="False"
                                 IsVisible="{Binding IsTorrentStream}"
                                 Background="Transparent"
                                 Foreground="#50FFFFFF"
                                 CornerRadius="2"/>
                    <Slider Name="TimelineSlider"
                            Classes="timeline"
                            Minimum="0" Maximum="{Binding Duration}"
                            Value="{Binding CurrentTime}"
                            VerticalAlignment="Center"/>
                    <playerControls:PlayerChapterMarkers Margin="7,0,7,0"
                                                         VerticalAlignment="Stretch" />
                </Grid>

                <!-- ===== CINEMATIC CONTROLS ROW ===== -->
                <playerControls:PlayerControlBar Name="ControlBar"
                                                 SettingsClicked="OnSettingsClicked"
                                                 ActionExecuted="OnActionExecuted"
                                                 FullscreenClicked="OnFullscreenClick" />
            </StackPanel>
        </Border>

        <!-- Edge Drag Strips for Frameless Resizing & Moving -->
        <Border Name="TopDragStrip"
                Height="8"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Margin="0,0,160,0"
                Background="Transparent"
                Cursor="SizeAll"
                PointerPressed="OnDragStripPointerPressed"/>

        <Border Name="LeftDragStrip"
                Width="8"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Margin="0,58,0,14"
                Background="Transparent"
                Cursor="SizeAll"
                PointerPressed="OnDragStripPointerPressed"/>

        <Border Name="RightDragStrip"
                Width="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,58,0,14"
                Background="Transparent"
                Cursor="SizeAll"
                PointerPressed="OnDragStripPointerPressed"/>

        <Border Name="BottomDragStrip"
                Height="8"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="SizeAll"
                PointerPressed="OnDragStripPointerPressed"/>

        <!-- Resume Playback Prompt Notification -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,96"
                ZIndex="25"
                IsVisible="{Binding Overlay.IsResumePromptVisible}"
                Background="#EE141416"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 8 32 0 #90000000"
                Padding="16,10">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="34" Height="34"
                        CornerRadius="8"
                        Background="#2638bdf8"
                        VerticalAlignment="Center">
                    <material:MaterialIcon Kind="History"
                                           Width="18" Height="18"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{DynamicResource l.player.resume.prompt}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{DynamicResource l.player.resume.at_time}"
                                   FontSize="11.5"
                                   Foreground="#9EFFFFFF"/>
                        <TextBlock Text="{Binding Overlay.ResumePromptTimeString}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentColor}"/>
                    </StackPanel>
                </StackPanel>
                <Button Classes="resume-action-btn"
                        Command="{Binding ResumeFromSavedPositionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="White"/>
                        <TextBlock Text="{DynamicResource l.player.resume.continue}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Classes="icon-btn"
                        Command="{Binding DismissResumePromptCommand}"
                        Width="28" Height="28"
                        Padding="0"
                        CornerRadius="6"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{DynamicResource l.player.resume.dismiss}">
                    <material:MaterialIcon Kind="Close" Width="15" Height="15"
                                           Foreground="#80FFFFFF"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Skip Opening/Ending/Recap Prompt Notification -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,96"
                ZIndex="25"
                IsVisible="{Binding Overlay.IsSkipPromptVisible}"
                Background="#EE141416"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 8 32 0 #90000000"
                Padding="16,10">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="34" Height="34"
                        CornerRadius="8"
                        Background="#2638bdf8"
                        VerticalAlignment="Center">
                    <material:MaterialIcon Kind="FastForward"
                                           Width="18" Height="18"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Overlay.SkipPromptTitle}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="{Binding Overlay.SkipPromptSubtitle}"
                               FontSize="11.5"
                               Foreground="#9EFFFFFF"/>
                </StackPanel>
                <Button Classes="resume-action-btn"
                        Command="{Binding SkipActiveSegmentCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="FastForward" Width="14" Height="14" Foreground="White"/>
                        <TextBlock Text="{DynamicResource l.player.skip.action}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Classes="icon-btn"
                        Command="{Binding DismissSkipPromptCommand}"
                        Width="28" Height="28"
                        Padding="0"
                        CornerRadius="6"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{DynamicResource l.player.resume.dismiss}">
                    <material:MaterialIcon Kind="Close" Width="15" Height="15"
                                           Foreground="#80FFFFFF"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Skip Confirmation Toast Notification (2 seconds) -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,96"
                ZIndex="26"
                IsVisible="{Binding Overlay.IsSkipToastVisible}"
                Background="#EE141416"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 8 32 0 #90000000"
                Padding="16,10">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34"
                        CornerRadius="8"
                        Background="#2638bdf8"
                        VerticalAlignment="Center">
                    <material:MaterialIcon Kind="FastForward"
                                           Width="18" Height="18"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Overlay.SkipToastMessage}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Settings Overlay -->
        <playerControls:PlayerSettingsOverlay Name="SettingsOverlayControl" OverlayClosed="OnSettingsOverlayClosed" />
    </Grid>
</Window>
