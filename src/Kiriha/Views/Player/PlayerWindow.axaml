<Window
    x:Class="Kiriha.Views.Player.PlayerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kiriha.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:playerControls="using:Kiriha.Views.Player.Controls"
    xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
    Title="{Binding TrackingTitle}"
    Width="960"
    Height="540"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    x:DataType="vmPlayer:PlayerViewModel"
    Background="Black"
    DragDrop.AllowDrop="True"
    ExtendClientAreaTitleBarHeightHint="34"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyBackgroundFallback="Black"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kiriha/Views/Styles/PlayerOverlayWindowResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://Kiriha/Views/Styles/PlayerSliderStyles.axaml" />
        <StyleInclude Source="avares://Kiriha/Views/Styles/PlayerControlStyles.axaml" />
        <StyleInclude Source="avares://Kiriha/Views/Styles/PlayerSettingsStyles.axaml" />
        <StyleInclude Source="avares://Kiriha/Views/Styles/PlayerOsdStyles.axaml" />
    </Window.Styles>

    <Grid
        Name="MainGrid"
        Background="Black"
        DoubleTapped="OnBackgroundDoubleTapped"
        PointerExited="OnGridPointerExited"
        PointerMoved="OnGridPointerMoved"
        PointerPressed="OnBackgroundPointerPressed"
        PointerWheelChanged="OnBackgroundPointerWheelChanged">

        <!--  Base Video Layer  -->
        <controls:MpvOpenGlVideoView x:Name="VideoHost" />

        <!--  Minimal Center Accent Spinner (Clean, modern streaming style)  -->
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            IsVisible="{Binding IsBufferingOrLoading}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.2" />
                </Transitions>
            </Border.Transitions>
            <material:MaterialIcon
                Width="44"
                Height="44"
                Foreground="{DynamicResource SystemAccentColor}"
                IsVisible="{Binding IsBufferingOrLoading}"
                Kind="Loading"
                Opacity="0.85">
                <material:MaterialIcon.Styles>
                    <Style Selector="material|MaterialIcon[IsVisible=True]">
                        <Style.Animations>
                            <Animation
                                IterationCount="Infinite"
                                PlaybackBehavior="OnlyIfVisible"
                                Duration="0:0:1.0">
                                <KeyFrame Cue="0%">
                                    <Setter Property="RotateTransform.Angle" Value="0" />
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="RotateTransform.Angle" Value="360" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </material:MaterialIcon.Styles>
            </material:MaterialIcon>
        </Border>

        <!--  Playback Error Panel  -->
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="player-state-panel error"
            IsVisible="{Binding HasPlaybackError}">
            <StackPanel Width="340" Spacing="12">
                <material:MaterialIcon
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    Foreground="#FFFFD166"
                    Kind="AlertCircleOutline" />
                <TextBlock
                    Classes="overlay-text"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{DynamicResource l.player.overlay.error_failed_to_play}"
                    TextAlignment="Center" />
                <TextBlock
                    FontSize="12"
                    Foreground="#BFFFFFFF"
                    Text="{Binding PlaybackErrorMessage}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Classes="icon-btn state-action"
                        Command="{Binding ReloadMediaCommand}"
                        ToolTip.Tip="{DynamicResource l.player.overlay.error_retry}">
                        <material:MaterialIcon
                            Width="20"
                            Height="20"
                            Foreground="White"
                            Kind="Refresh" />
                    </Button>
                    <Button
                        Classes="icon-btn state-action"
                        Command="{Binding OpenNextMediaCommand}"
                        IsEnabled="{Binding CanOpenNextMedia}"
                        ToolTip.Tip="{DynamicResource l.player.overlay.error_next_file}">
                        <material:MaterialIcon
                            Width="20"
                            Height="20"
                            Foreground="White"
                            Kind="SkipNext" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  ===== TOP GRADIENT + BAR (Cinematic Header & Unified Inline Stream HUD) =====  -->
        <Border
            Name="TopBar"
            VerticalAlignment="Top"
            CornerRadius="8,8,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Offset="0" Color="#68000000" />
                    <GradientStop Offset="0.55" Color="#28000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>

            <Grid
                Margin="0,0,0,10"
                VerticalAlignment="Top"
                Background="Transparent"
                ColumnDefinitions="Auto, *, Auto"
                PointerPressed="OnTopBarPointerPressed">

                <!--  Left: Anime Title, Episode / Romaji & Inline Dynamic Telemetry/Toasts  -->
                <StackPanel
                    Grid.Column="0"
                    MaxWidth="850"
                    Margin="24,14,0,0"
                    VerticalAlignment="Top"
                    Spacing="2">
                    <!--  Primary Russian/Romaji Anime Title  -->
                    <TextBlock
                        Classes="overlay-text"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Opacity="0.98"
                        Text="{Binding TopTitle}"
                        TextTrimming="CharacterEllipsis" />

                    <!--  Row 2: Episode Title | Romaji / English Title  -->
                    <StackPanel
                        Margin="0,1,0,0"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            Classes="overlay-secondary-text"
                            FontSize="13.5"
                            Foreground="#E6FFFFFF"
                            IsVisible="{Binding EpisodeTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Text="{Binding EpisodeTitle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Classes="overlay-secondary-text"
                            FontSize="13.5"
                            Foreground="#B3FFFFFF"
                            IsVisible="{Binding HasEpisodeAndBottom}"
                            Text="|" />
                        <TextBlock
                            Classes="overlay-secondary-text"
                            FontSize="13.5"
                            Foreground="#CCFFFFFF"
                            IsVisible="{Binding HasBottomTitle}"
                            Text="{Binding BottomTitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--  Row 3: Organic Inline Status (OSD & Torrent Telemetry, No Bubbles)  -->
                    <StackPanel
                        Margin="0,3,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">

                        <!--  Inline OSD Notification (Volume, Tracks, Subtitles)  -->
                        <StackPanel
                            VerticalAlignment="Center"
                            IsVisible="{Binding Overlay.IsOsdVisible}"
                            Orientation="Horizontal"
                            Spacing="5">
                            <material:MaterialIcon
                                Width="13"
                                Height="13"
                                VerticalAlignment="Center"
                                Classes="overlay-icon"
                                Foreground="{DynamicResource SystemAccentColor}"
                                Kind="InformationOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="overlay-secondary-text"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Overlay.OsdMessage}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="overlay-secondary-text"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                IsVisible="{Binding Overlay.OsdDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Text="{Binding Overlay.OsdDetail}" />
                            <TextBlock
                                Classes="overlay-secondary-text"
                                FontSize="13"
                                Foreground="#80FFFFFF"
                                IsVisible="{Binding IsTorrentStream}"
                                Text="|" />
                        </StackPanel>

                        <!--  Inline Torrent Telemetry Strip (ALWAYS visible when streaming torrents)  -->
                        <StackPanel
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsTorrentStream}"
                            Orientation="Horizontal"
                            Spacing="6"
                            ToolTip.Tip="{Binding TorrentDetailsTooltip}">

                            <!--  Active Buffering / Rebuffering Indicator  -->
                            <StackPanel
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsBufferingOrLoading}"
                                Orientation="Horizontal"
                                Spacing="5">
                                <material:MaterialIcon
                                    Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Classes="overlay-icon"
                                    Foreground="{DynamicResource SystemAccentColor}"
                                    IsVisible="{Binding IsBufferingOrLoading}"
                                    Kind="Loading">
                                    <material:MaterialIcon.Styles>
                                        <Style Selector="material|MaterialIcon[IsVisible=True]">
                                            <Style.Animations>
                                                <Animation
                                                    IterationCount="Infinite"
                                                    PlaybackBehavior="OnlyIfVisible"
                                                    Duration="0:0:1.0">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="RotateTransform.Angle" Value="0" />
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="RotateTransform.Angle" Value="360" />
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </material:MaterialIcon.Styles>
                                </material:MaterialIcon>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="overlay-secondary-text"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding StreamStatusBadgeText}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="overlay-secondary-text"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding TorrentBufferPercent, StringFormat='{}{0:0}%'}" />
                                <TextBlock
                                    Classes="overlay-secondary-text"
                                    FontSize="13"
                                    Foreground="#80FFFFFF"
                                    Text="|" />
                            </StackPanel>

                            <!--  Torrent Speed  -->
                            <StackPanel
                                VerticalAlignment="Center"
                                IsVisible="{Binding TorrentDownloadSpeedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Orientation="Horizontal"
                                Spacing="4">
                                <material:MaterialIcon
                                    Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Classes="overlay-icon"
                                    Foreground="#00E676"
                                    Kind="LightningBolt" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="overlay-secondary-text"
                                    FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding TorrentDownloadSpeedText}" />
                            </StackPanel>

                            <!--  Separator  -->
                            <TextBlock
                                Classes="overlay-secondary-text"
                                FontSize="13"
                                Foreground="#80FFFFFF"
                                IsVisible="{Binding TorrentPeersBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Text="|" />

                            <!--  Torrent Peers  -->
                            <StackPanel
                                VerticalAlignment="Center"
                                IsVisible="{Binding TorrentPeersBadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Orientation="Horizontal"
                                Spacing="4">
                                <material:MaterialIcon
                                    Width="13"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Classes="overlay-icon"
                                    Foreground="#E6FFFFFF"
                                    Kind="AccountMultipleOutline" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="overlay-secondary-text"
                                    FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"
                                    FontSize="13"
                                    Foreground="White"
                                    Text="{Binding TorrentPeersBadgeText}" />
                            </StackPanel>

                            <!--  Separator  -->
                            <TextBlock
                                Classes="overlay-secondary-text"
                                FontSize="13"
                                Foreground="#80FFFFFF"
                                IsVisible="{Binding TorrentBufferText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Text="|" />

                            <!--  Preload Buffer / Cache text  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="overlay-secondary-text"
                                FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"
                                FontSize="12.5"
                                Foreground="#E6FFFFFF"
                                IsVisible="{Binding TorrentBufferText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Text="{Binding TorrentBufferText}" />
                        </StackPanel>

                        <!--  Non-Torrent Buffering Status (HTTP or local loading)  -->
                        <StackPanel
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowNonTorrentBuffering}"
                            Orientation="Horizontal"
                            Spacing="5">
                            <material:MaterialIcon
                                Width="13"
                                Height="13"
                                VerticalAlignment="Center"
                                Classes="overlay-icon"
                                Foreground="{DynamicResource SystemAccentColor}"
                                IsVisible="{Binding ShowNonTorrentBuffering}"
                                Kind="Loading">
                                <material:MaterialIcon.Styles>
                                    <Style Selector="material|MaterialIcon[IsVisible=True]">
                                        <Style.Animations>
                                            <Animation
                                                IterationCount="Infinite"
                                                PlaybackBehavior="OnlyIfVisible"
                                                Duration="0:0:1.0">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="RotateTransform.Angle" Value="0" />
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="RotateTransform.Angle" Value="360" />
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </material:MaterialIcon.Styles>
                            </material:MaterialIcon>
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="overlay-secondary-text"
                                FontSize="13"
                                Foreground="White"
                                Text="{Binding PlaybackStatusMessage}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  Center: Empty drag region  -->
                <Grid
                    Grid.Column="1"
                    Background="Transparent"
                    PointerPressed="OnTopBarPointerPressed" />

                <!--  Right: Window Control Buttons  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="0">
                    <Button Classes="wnd-btn" Click="OnMinimizeClick">
                        <TextBlock Text="&#xE921;" />
                    </Button>
                    <Button Classes="wnd-btn" Click="OnMaximizeClick">
                        <TextBlock Name="MaximizeIcon" Text="&#xE922;" />
                    </Button>
                    <Button
                        Name="CloseButton"
                        Classes="wnd-btn close"
                        Click="OnCloseClick">
                        <TextBlock Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ===== BOTTOM GRADIENT + BAR (Cinematic Full-Width Scrubber & Controls) =====  -->
        <Border
            Name="BottomBar"
            VerticalAlignment="Bottom"
            ClipToBounds="False"
            CornerRadius="0,0,8,8"
            PointerPressed="OnBottomBarPointerPressed">
            <Border.Background>
                <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                    <GradientStop Offset="0" Color="#E6000000" />
                    <GradientStop Offset="0.5" Color="#A0000000" />
                    <GradientStop Offset="0.8" Color="#33000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>

            <StackPanel Margin="0,20,0,0">
                <!--  Timeline Preview Popup (Canvas)  -->
                <Canvas
                    Height="0"
                    HorizontalAlignment="Stretch"
                    IsHitTestVisible="False"
                    ZIndex="20">
                    <Border
                        Name="TimelinePreviewBorder"
                        Canvas.Left="{Binding Overlay.TimelinePreviewLeft}"
                        Canvas.Bottom="14"
                        Padding="6"
                        Background="#F0141414"
                        BorderBrush="#2AFFFFFF"
                        BorderThickness="1"
                        BoxShadow="0 12 36 0 #80000000"
                        CornerRadius="10"
                        IsVisible="{Binding Overlay.IsTimelinePreviewVisible}">
                        <Grid RowDefinitions="Auto,Auto">
                            <Border
                                Grid.Row="0"
                                Width="224"
                                Height="126"
                                Background="#FF050505"
                                ClipToBounds="True"
                                CornerRadius="6"
                                IsVisible="{Binding Overlay.TimelinePreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding Overlay.TimelinePreviewImage}"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Overlay.TimelinePreviewTime}" />
                        </Grid>
                    </Border>
                </Canvas>

                <!--  ===== FULL-WIDTH TIMELINE (Scrubber + Preload Buffer Bar) =====  -->
                <Grid
                    Name="TimelineContainer"
                    Margin="24,0,24,6"
                    PointerExited="OnTimelinePointerExited"
                    PointerMoved="OnTimelinePointerMoved">
                    <!--  Preload Stream Buffer (Torrent RAM buffer bar)  -->
                    <ProgressBar
                        Name="TimelineBufferBar"
                        Height="3.5"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        CornerRadius="2"
                        Foreground="#50FFFFFF"
                        IsIndeterminate="False"
                        IsVisible="{Binding IsTorrentStream}"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding TorrentBufferPercent}" />
                    <Slider
                        Name="TimelineSlider"
                        VerticalAlignment="Center"
                        Classes="timeline"
                        Maximum="{Binding Duration}"
                        Minimum="0"
                        Value="{Binding CurrentTime}" />
                    <playerControls:PlayerChapterMarkers Margin="7,0,7,0" VerticalAlignment="Stretch" />
                </Grid>

                <!--  ===== CINEMATIC CONTROLS ROW =====  -->
                <playerControls:PlayerControlBar
                    Name="ControlBar"
                    ActionExecuted="OnActionExecuted"
                    FullscreenClicked="OnFullscreenClick"
                    SettingsClicked="OnSettingsClicked" />
            </StackPanel>
        </Border>

        <!--  Edge Drag Strips for Frameless Resizing & Moving  -->
        <Border
            Name="TopDragStrip"
            Height="8"
            Margin="0,0,160,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="Transparent"
            Cursor="SizeAll"
            PointerPressed="OnDragStripPointerPressed" />

        <Border
            Name="LeftDragStrip"
            Width="8"
            Margin="0,58,0,14"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeAll"
            PointerPressed="OnDragStripPointerPressed" />

        <Border
            Name="RightDragStrip"
            Width="8"
            Margin="0,58,0,14"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="SizeAll"
            PointerPressed="OnDragStripPointerPressed" />

        <Border
            Name="BottomDragStrip"
            Height="8"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Cursor="SizeAll"
            PointerPressed="OnDragStripPointerPressed" />

        <!--  Resume Playback Prompt Notification  -->
        <Border
            Margin="0,0,0,96"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#EE141416"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            BoxShadow="0 8 32 0 #90000000"
            CornerRadius="12"
            IsVisible="{Binding Overlay.IsResumePromptVisible}"
            ZIndex="25">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="14">
                <Border
                    Width="34"
                    Height="34"
                    VerticalAlignment="Center"
                    Background="#2638bdf8"
                    CornerRadius="8">
                    <material:MaterialIcon
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Kind="History" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{DynamicResource l.player.resume.prompt}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            FontSize="11.5"
                            Foreground="#9EFFFFFF"
                            Text="{DynamicResource l.player.resume.at_time}" />
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemAccentColor}"
                            Text="{Binding Overlay.ResumePromptTimeString}" />
                    </StackPanel>
                </StackPanel>
                <Button Classes="resume-action-btn" Command="{Binding ResumeFromSavedPositionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon
                            Width="14"
                            Height="14"
                            Foreground="White"
                            Kind="Play" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{DynamicResource l.player.resume.continue}" />
                    </StackPanel>
                </Button>
                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Classes="icon-btn"
                    Command="{Binding DismissResumePromptCommand}"
                    CornerRadius="6"
                    Cursor="Hand"
                    ToolTip.Tip="{DynamicResource l.player.resume.dismiss}">
                    <material:MaterialIcon
                        Width="15"
                        Height="15"
                        Foreground="#80FFFFFF"
                        Kind="Close" />
                </Button>
            </StackPanel>
        </Border>

        <!--  Skip Opening/Ending/Recap Prompt Notification  -->
        <Border
            Margin="0,0,0,96"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#EE141416"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            BoxShadow="0 8 32 0 #90000000"
            CornerRadius="12"
            IsHitTestVisible="{Binding Overlay.IsSkipPromptHitTestVisible}"
            IsVisible="{Binding Overlay.IsSkipPromptVisible}"
            Opacity="{Binding Overlay.SkipPromptOpacity}"
            PointerEntered="OnSkipPromptPointerEntered"
            PointerExited="OnSkipPromptPointerExited"
            ZIndex="25">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.35" />
                </Transitions>
            </Border.Transitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="14">
                <Border
                    Width="34"
                    Height="34"
                    VerticalAlignment="Center"
                    Background="#2638bdf8"
                    CornerRadius="8">
                    <material:MaterialIcon
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Kind="FastForward" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding Overlay.SkipPromptTitle}" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="#9EFFFFFF"
                        Text="{Binding Overlay.SkipPromptSubtitle}" />
                </StackPanel>
                <Button Classes="resume-action-btn" Command="{Binding SkipActiveSegmentCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon
                            Width="14"
                            Height="14"
                            Foreground="White"
                            Kind="FastForward" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{DynamicResource l.player.skip.action}" />
                    </StackPanel>
                </Button>
                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Classes="icon-btn"
                    Command="{Binding DismissSkipPromptCommand}"
                    CornerRadius="6"
                    Cursor="Hand"
                    ToolTip.Tip="{DynamicResource l.player.resume.dismiss}">
                    <material:MaterialIcon
                        Width="15"
                        Height="15"
                        Foreground="#80FFFFFF"
                        Kind="Close" />
                </Button>
            </StackPanel>
        </Border>

        <!--  Skip Confirmation Toast Notification (2 seconds)  -->
        <Border
            Margin="0,0,0,96"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#EE141416"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            BoxShadow="0 8 32 0 #90000000"
            CornerRadius="12"
            IsVisible="{Binding Overlay.IsSkipToastVisible}"
            ZIndex="26">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.2" />
                </Transitions>
            </Border.Transitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Border
                    Width="34"
                    Height="34"
                    VerticalAlignment="Center"
                    Background="#2638bdf8"
                    CornerRadius="8">
                    <material:MaterialIcon
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Kind="FastForward" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding Overlay.SkipToastMessage}" />
            </StackPanel>
        </Border>

        <!--  Settings Overlay  -->
        <playerControls:PlayerSettingsOverlay Name="SettingsOverlayControl" OverlayClosed="OnSettingsOverlayClosed" />
    </Grid>
</Window>
