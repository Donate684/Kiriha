<UserControl
    x:Class="Kiriha.Views.Player.Controls.PlayerVolumeControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
    x:DataType="vmPlayer:PlayerViewModel">
    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="2">
        <Button
            Classes="icon-btn"
            Command="{Binding ToggleMuteCommand}"
            IsVisible="{Binding ShowMuteButton}"
            ToolTip.Tip="{DynamicResource l.player.controls.mute_toggle}">
            <Panel>
                <material:MaterialIcon
                    Width="21"
                    Height="21"
                    Foreground="White"
                    IsVisible="{Binding !IsMuted}"
                    Kind="VolumeHigh" />
                <material:MaterialIcon
                    Width="21"
                    Height="21"
                    Foreground="#B3FFFFFF"
                    IsVisible="{Binding IsMuted}"
                    Kind="VolumeOff" />
            </Panel>
        </Button>
        <Slider
            Width="82"
            VerticalAlignment="Center"
            Classes="volume"
            IsVisible="{Binding ShowVolumeSlider}"
            Maximum="100"
            Minimum="0"
            Value="{Binding Volume}" />
    </StackPanel>
</UserControl>
