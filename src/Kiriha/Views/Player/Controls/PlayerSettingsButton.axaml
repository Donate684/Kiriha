<UserControl
    x:Class="Kiriha.Views.Player.Controls.PlayerSettingsButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
    x:DataType="vmPlayer:PlayerViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kiriha/Views/Styles/PlayerOverlayWindowResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Button
        Classes="icon-btn"
        Click="OnSettingsButtonClick"
        ToolTip.Tip="{DynamicResource l.player.settings}">
        <material:MaterialIcon
            Width="22"
            Height="22"
            Foreground="White"
            Kind="Cog" />
    </Button>
</UserControl>
