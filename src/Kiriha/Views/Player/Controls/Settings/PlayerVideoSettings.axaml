<UserControl
    x:Class="Kiriha.Views.Player.Controls.Settings.PlayerVideoSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
    x:DataType="vmPlayer:PlayerViewModel">
    <UserControl.Resources>
        <conv:SettingModifiedConverter x:Key="SettingModifiedConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="10">
        <TextBlock Classes="player-settings-title" Text="{DynamicResource l.settings.player.video_preset_title}" />

        <Grid MinHeight="44" ColumnDefinitions="*,180,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.settings.player.video_preset_title}" />
                <TextBlock
                    Classes="player-settings-row-sub"
                    Text="{DynamicResource l.settings.player.video_preset_sub}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                SelectedValue="{Binding MpvVideoPreset}"
                SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}">
                <ComboBoxItem Content="{DynamicResource l.settings.player.video_preset_default}" Tag="default" />
                <ComboBoxItem Content="{DynamicResource l.settings.player.video_preset_balanced}" Tag="balanced" />
                <ComboBoxItem Content="{DynamicResource l.settings.player.video_preset_quality}" Tag="quality" />
                <ComboBoxItem Content="{DynamicResource l.settings.player.video_preset_custom}" Tag="custom" />
            </ComboBox>
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvVideoPreset"
                IsVisible="{Binding MpvVideoPreset, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=default}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>

        <Border Classes="player-settings-divider" />
        <TextBlock
            Margin="0,6,0,0"
            Classes="player-settings-row-title"
            Text="{DynamicResource l.player.settings_adv.scaling_processing}" />

        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.scale}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.default_lanczos}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                SelectedValue="{Binding MpvScale}"
                SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}">
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_bilinear}" Tag="bilinear" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_spline36}" Tag="spline36" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_lanczos}" Tag="lanczos" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_ewa_lanczossharp}" Tag="ewa_lanczossharp" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_mitchell}" Tag="mitchell" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_oversample}" Tag="oversample" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_nearest}" Tag="nearest" />
            </ComboBox>
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvScale"
                IsVisible="{Binding MpvScale, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=bilinear}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.cscale}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.default_lanczos}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                SelectedValue="{Binding MpvChromaScale}"
                SelectedValueBinding="{Binding Tag, DataType=ComboBoxItem}">
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_bilinear}" Tag="bilinear" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_spline36}" Tag="spline36" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_lanczos}" Tag="lanczos" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_ewa_lanczossharp}" Tag="ewa_lanczossharp" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_mitchell}" Tag="mitchell" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_oversample}" Tag="oversample" />
                <ComboBoxItem Content="{DynamicResource l.player.settings_adv.opt_nearest}" Tag="nearest" />
            </ComboBox>
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvChromaScale"
                IsVisible="{Binding MpvChromaScale, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=bilinear}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.dither_depth}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.default_auto}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding MpvDitherDepthOptions}"
                SelectedItem="{Binding MpvDitherDepth}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvDitherDepth"
                IsVisible="{Binding MpvDitherDepth, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=auto}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,Auto,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.correct_downscaling}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.default_yes}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding MpvCorrectDownscaling}"
                OffContent="{DynamicResource l.player.settings_adv.off}"
                OnContent="{DynamicResource l.player.settings_adv.on}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvCorrectDownscaling"
                IsVisible="{Binding MpvCorrectDownscaling, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=False}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,Auto,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.deband}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.deband_desc}" />
            </StackPanel>
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding MpvDeband}"
                OffContent="{DynamicResource l.player.settings_adv.off}"
                OnContent="{DynamicResource l.player.settings_adv.on}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvDeband"
                IsVisible="{Binding MpvDeband, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=False}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.deband_iterations}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.default_3}" />
            </StackPanel>
            <NumericUpDown
                Grid.Column="1"
                VerticalAlignment="Center"
                Increment="1"
                Maximum="16"
                Minimum="0"
                Value="{Binding MpvDebandIterations}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvDebandIterations"
                IsVisible="{Binding MpvDebandIterations, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=1}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.deband_threshold}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.default_30}" />
            </StackPanel>
            <NumericUpDown
                Grid.Column="1"
                VerticalAlignment="Center"
                Increment="1"
                Maximum="4096"
                Minimum="0"
                Value="{Binding MpvDebandThreshold}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvDebandThreshold"
                IsVisible="{Binding MpvDebandThreshold, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=30}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>

        <Border Classes="player-settings-divider" />

        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.hwdec}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.hwdec_desc}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding MpvHwdecOptions}"
                SelectedItem="{Binding MpvHwdec}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvHwdec"
                IsVisible="{Binding MpvHwdec, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=auto}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.vo}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.vo_desc}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding MpvVoOptions}"
                SelectedItem="{Binding MpvVideoOutput}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvVideoOutput"
                IsVisible="{Binding MpvVideoOutput, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=gpu-next}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.gpu_api}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.gpu_api_desc}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding MpvGpuApiOptions}"
                SelectedItem="{Binding MpvGpuApi}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvGpuApi"
                IsVisible="{Binding MpvGpuApi, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=auto}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>
        <Grid MinHeight="44" ColumnDefinitions="*,220,32">
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock Classes="player-settings-row-title" Text="{DynamicResource l.player.settings_adv.gpu_context}" />
                <TextBlock Classes="player-settings-row-sub" Text="{DynamicResource l.player.settings_adv.gpu_context_desc}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemsSource="{Binding MpvGpuContextOptions}"
                SelectedItem="{Binding MpvGpuContext}" />
            <Button
                Grid.Column="2"
                Classes="player-settings-reset-btn"
                Command="{Binding ResetSettingCommand}"
                CommandParameter="MpvGpuContext"
                IsVisible="{Binding MpvGpuContext, Converter={StaticResource SettingModifiedConverter}, ConverterParameter=auto}"
                ToolTip.Tip="{DynamicResource l.player.reset_default}">
                <material:MaterialIcon
                    Width="14"
                    Height="14"
                    Kind="Restore" />
            </Button>
        </Grid>



        <Border Height="110" IsHitTestVisible="False" />
    </StackPanel>
</UserControl>
