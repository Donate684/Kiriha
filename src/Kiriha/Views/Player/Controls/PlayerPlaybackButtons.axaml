<UserControl
    x:Class="Kiriha.Views.Player.Controls.PlayerPlaybackButtons"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
    x:DataType="vmPlayer:PlayerViewModel">
    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="4">
        <!--  Previous File  -->
        <Button
            Classes="icon-btn"
            Command="{Binding OpenPreviousMediaCommand}"
            IsEnabled="{Binding CanOpenPreviousMedia}"
            IsVisible="{Binding ShowSkipButtons}"
            ToolTip.Tip="{DynamicResource l.player.controls.prev_file}">
            <material:MaterialIcon
                Width="22"
                Height="22"
                Foreground="White"
                Kind="SkipPrevious" />
        </Button>

        <!--  Play / Pause (Clean Icon Button, No Circular Background)  -->
        <Button
            Classes="icon-btn"
            Command="{Binding TogglePlayPauseCommand}"
            IsVisible="{Binding ShowPlayPauseButton}"
            ToolTip.Tip="{DynamicResource l.player.controls.play_pause}">
            <Panel>
                <material:MaterialIcon
                    Width="24"
                    Height="24"
                    Foreground="White"
                    IsVisible="{Binding IsPlaying}"
                    Kind="Pause" />
                <material:MaterialIcon
                    Width="24"
                    Height="24"
                    Margin="2,0,0,0"
                    Foreground="White"
                    IsVisible="{Binding !IsPlaying}"
                    Kind="Play" />
            </Panel>
        </Button>

        <!--  Next File  -->
        <Button
            Classes="icon-btn"
            Command="{Binding OpenNextMediaCommand}"
            IsEnabled="{Binding CanOpenNextMedia}"
            IsVisible="{Binding ShowSkipButtons}"
            ToolTip.Tip="{DynamicResource l.player.controls.next_file}">
            <material:MaterialIcon
                Width="22"
                Height="22"
                Foreground="White"
                Kind="SkipNext" />
        </Button>
    </StackPanel>
</UserControl>
