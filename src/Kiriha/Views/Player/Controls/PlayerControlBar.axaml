<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
             xmlns:mpv="using:Kiriha.Mpv"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:conv="using:Kiriha.Views.Converters"
             x:Class="Kiriha.Views.Player.Controls.PlayerControlBar"
             x:DataType="vmPlayer:PlayerViewModel"
             xmlns:controls="using:Kiriha.Views.Player.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kiriha/Views/Styles/PlayerOverlayWindowResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,2,24,14" ColumnDefinitions="Auto, *, Auto">

        <!-- ===== LEFT: Playback & Volume & Time ===== -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <!-- Play/Pause / Rewind / FastForward / Prev / Next -->
            <controls:PlayerPlaybackButtons />

            <!-- Volume Control -->
            <controls:PlayerVolumeControl Margin="4,0,0,0"/>

            <!-- Current / Duration Time Display -->
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                        IsVisible="{Binding ShowTimeDisplay}" Margin="6,0,0,0">
                <TextBlock Classes="overlay-text"
                           Text="{Binding CurrentTimeString}"
                           Foreground="White" FontSize="13" FontWeight="SemiBold"
                           FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"/>
                <TextBlock Text="/" Foreground="#55FFFFFF" FontSize="13" FontWeight="Normal"/>
                <TextBlock Text="{Binding DurationString}"
                           Foreground="#A6FFFFFF" FontSize="13" FontWeight="SemiBold"
                           FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== RIGHT: Speed, Subs, Audio, Screenshot, Settings, Fullscreen ===== -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3"
                    HorizontalAlignment="Right" VerticalAlignment="Center">

            <!-- Playback Speed -->
            <Button Name="SpeedButton"
                    Classes="icon-btn"
                    IsVisible="{Binding ShowSpeedButton}"
                    ToolTip.Tip="{DynamicResource l.player.controls.speed}">
                <Button.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuItem Header="0.25x" Classes="speed-item"
                                  Command="{Binding SetSpeedCommand}" CommandParameter="0.25"/>
                        <MenuItem Header="0.5x" Classes="speed-item"
                                  Command="{Binding SetSpeedCommand}" CommandParameter="0.5"/>
                        <MenuItem Header="0.75x" Classes="speed-item"
                                  Command="{Binding SetSpeedCommand}" CommandParameter="0.75"/>
                        <MenuItem Header="1x" Classes="speed-item"
                                  Command="{Binding SetSpeedCommand}" CommandParameter="1"/>
                        <MenuItem Header="1.25x" Classes="speed-item"
                                  Command="{Binding SetSpeedCommand}" CommandParameter="1.25"/>
                        <MenuItem Header="1.5x" Classes="speed-item"
                                  Command="{Binding SetSpeedCommand}" CommandParameter="1.5"/>
                        <MenuItem Header="1.75x" Classes="speed-item"
                                  Command="{Binding SetSpeedCommand}" CommandParameter="1.75"/>
                        <MenuItem Header="2x" Classes="speed-item"
                                  Command="{Binding SetSpeedCommand}" CommandParameter="2"/>
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="2,0">
                    <material:MaterialIcon Kind="SpeedometerMedium" Width="19" Height="19" Foreground="White"/>
                    <TextBlock Text="{Binding PlaybackSpeed, StringFormat='{}{0}x'}"
                               Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Subtitles -->
            <Button Name="SubtitleButton"
                    Classes="icon-btn"
                    IsVisible="{Binding ShowSubtitleButton}"
                    ToolTip.Tip="{DynamicResource l.player.controls.subtitles_toggle}">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Border Width="260"
                                MaxHeight="340"
                                CornerRadius="14"
                                Background="#F0141414"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                BoxShadow="0 14 42 0 #90000000"
                                Padding="8">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource l.player.controls.subtitles_toggle}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#CCFFFFFF" Margin="8,4,8,4"/>
                                    <Rectangle Height="1" Fill="#1EFFFFFF" Margin="0,2,0,4"/>
                                    <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="mpv:TrackInfo">
                                                <Button Classes="track-menu-item"
                                                        Click="OnTrackMenuItemClick">
                                                    <Grid ColumnDefinitions="22,*">
                                                        <material:MaterialIcon Grid.Column="0"
                                                                               Kind="Check"
                                                                               Width="14"
                                                                               Height="14"
                                                                               Foreground="{DynamicResource SystemAccentColor}"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding Selected}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <material:MaterialIcon Kind="SubtitlesOutline" Width="21" Height="21" Foreground="White"/>
            </Button>

            <!-- Audio tracks -->
            <Button Name="AudioButton"
                    Classes="icon-btn"
                    IsVisible="{Binding ShowAudioButton}"
                    ToolTip.Tip="{DynamicResource l.player.controls.audio_track_toggle}">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Border Width="260"
                                MaxHeight="340"
                                CornerRadius="14"
                                Background="#F0141414"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                BoxShadow="0 14 42 0 #90000000"
                                Padding="8">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource l.player.controls.audio_track_toggle}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#CCFFFFFF" Margin="8,4,8,4"/>
                                    <Rectangle Height="1" Fill="#1EFFFFFF" Margin="0,2,0,4"/>
                                    <ItemsControl ItemsSource="{Binding AudioTracks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="mpv:TrackInfo">
                                                <Button Classes="track-menu-item"
                                                        Click="OnTrackMenuItemClick">
                                                    <Grid ColumnDefinitions="22,*">
                                                        <material:MaterialIcon Grid.Column="0"
                                                                               Kind="Check"
                                                                               Width="14"
                                                                               Height="14"
                                                                               Foreground="{DynamicResource SystemAccentColor}"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding Selected}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <material:MaterialIcon Kind="MusicNote" Width="21" Height="21" Foreground="White"/>
            </Button>

            <!-- Subtitle position -->
            <Button Name="SubtitlePositionButton"
                    Classes="icon-btn"
                    ToolTip.Tip="{DynamicResource l.player.controls.subtitles_position_tip}"
                    PointerReleased="OnSubtitlePositionButtonPointerReleased"
                    IsVisible="{Binding ShowSubtitlePositionButton}">
                <material:MaterialIcon Kind="FormatLineSpacing" Width="20" Height="20" Foreground="White"/>
            </Button>

            <!-- Subtitle style override -->
            <Button Classes="icon-btn"
                    Classes.active="{Binding SubtitleStyleOverrideEnabled}"
                    ToolTip.Tip="{DynamicResource l.player.controls.subtitles_style}"
                    Command="{Binding ToggleSubtitleStyleOverrideCommand}"
                    IsVisible="{Binding ShowSubtitleStyleButton}">
                <material:MaterialIcon Kind="FormatPaint" Width="20" Height="20" Foreground="White"/>
            </Button>

            <!-- Screenshot -->
            <Button Name="ScreenshotButton"
                    Classes="icon-btn"
                    ToolTip.Tip="{DynamicResource l.player.controls.screenshot}"
                    PointerReleased="OnScreenshotButtonPointerReleased"
                    IsVisible="{Binding ShowScreenshotButton}">
                <material:MaterialIcon Kind="CameraOutline" Width="20" Height="20" Foreground="White"/>
            </Button>

            <!-- Player settings -->
            <controls:PlayerSettingsButton x:Name="SettingsBtn" />

            <!-- Fullscreen -->
            <Button Name="FullscreenButton"
                    Classes="icon-btn"
                    Click="OnFullscreenButtonClick"
                    ToolTip.Tip="{DynamicResource l.player.controls.fullscreen}">
                <material:MaterialIcon Kind="Fullscreen" Width="22" Height="22" Foreground="White"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
