<UserControl
    x:Class="Kiriha.Views.Player.Controls.PlayerControlBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kiriha.Views.Player.Controls"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:mpv="using:Kiriha.Mpv"
    xmlns:vmPlayer="using:Kiriha.Mpv.UI.ViewModels.Player"
    x:DataType="vmPlayer:PlayerViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kiriha/Views/Styles/PlayerOverlayWindowResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,2,24,14" ColumnDefinitions="Auto, *, Auto">

        <!--  ===== LEFT: Playback & Volume & Time =====  -->
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <!--  Play/Pause / Rewind / FastForward / Prev / Next  -->
            <controls:PlayerPlaybackButtons />

            <!--  Volume Control  -->
            <controls:PlayerVolumeControl Margin="4,0,0,0" />

            <!--  Current / Duration Time Display  -->
            <StackPanel
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding ShowTimeDisplay}"
                Orientation="Horizontal"
                Spacing="3">
                <TextBlock
                    Classes="overlay-text"
                    FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding CurrentTimeString}" />
                <TextBlock
                    FontSize="13"
                    FontWeight="Normal"
                    Foreground="#55FFFFFF"
                    Text="/" />
                <TextBlock
                    FontFamily="Consolas,Cascadia Code,Segoe UI Variable,monospace"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#A6FFFFFF"
                    Text="{Binding DurationString}" />
            </StackPanel>
        </StackPanel>

        <!--  ===== RIGHT: Speed, Subs, Audio, Screenshot, Settings, Fullscreen =====  -->
        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="3">

            <!--  Playback Speed  -->
            <Button
                Name="SpeedButton"
                Classes="icon-btn"
                IsVisible="{Binding ShowSpeedButton}"
                ToolTip.Tip="{DynamicResource l.player.controls.speed}">
                <Button.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuItem
                            Classes="speed-item"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="0.25"
                            Header="0.25x" />
                        <MenuItem
                            Classes="speed-item"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="0.5"
                            Header="0.5x" />
                        <MenuItem
                            Classes="speed-item"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="0.75"
                            Header="0.75x" />
                        <MenuItem
                            Classes="speed-item"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="1"
                            Header="1x" />
                        <MenuItem
                            Classes="speed-item"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="1.25"
                            Header="1.25x" />
                        <MenuItem
                            Classes="speed-item"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="1.5"
                            Header="1.5x" />
                        <MenuItem
                            Classes="speed-item"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="1.75"
                            Header="1.75x" />
                        <MenuItem
                            Classes="speed-item"
                            Command="{Binding SetSpeedCommand}"
                            CommandParameter="2"
                            Header="2x" />
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="3">
                    <material:MaterialIcon
                        Width="19"
                        Height="19"
                        Foreground="White"
                        Kind="SpeedometerMedium" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding PlaybackSpeed, StringFormat='{}{0}x'}" />
                </StackPanel>
            </Button>

            <!--  Subtitles  -->
            <Button
                Name="SubtitleButton"
                Classes="icon-btn"
                IsVisible="{Binding ShowSubtitleButton}"
                ToolTip.Tip="{DynamicResource l.player.controls.subtitles_toggle}">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Border
                            Width="260"
                            MaxHeight="340"
                            Padding="8"
                            Background="#F0141414"
                            BorderBrush="#26FFFFFF"
                            BorderThickness="1"
                            BoxShadow="0 14 42 0 #90000000"
                            CornerRadius="14">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Margin="8,4,8,4"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="#CCFFFFFF"
                                        Text="{DynamicResource l.player.controls.subtitles_toggle}" />
                                    <Rectangle
                                        Height="1"
                                        Margin="0,2,0,4"
                                        Fill="#1EFFFFFF" />
                                    <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="mpv:TrackInfo">
                                                <Button Classes="track-menu-item" Click="OnTrackMenuItemClick">
                                                    <Grid ColumnDefinitions="22,*">
                                                        <material:MaterialIcon
                                                            Grid.Column="0"
                                                            Width="14"
                                                            Height="14"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource SystemAccentColor}"
                                                            IsVisible="{Binding Selected}"
                                                            Kind="Check" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding DisplayName}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <material:MaterialIcon
                    Width="21"
                    Height="21"
                    Foreground="White"
                    Kind="SubtitlesOutline" />
            </Button>

            <!--  Audio tracks  -->
            <Button
                Name="AudioButton"
                Classes="icon-btn"
                IsVisible="{Binding ShowAudioButton}"
                ToolTip.Tip="{DynamicResource l.player.controls.audio_track_toggle}">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Border
                            Width="260"
                            MaxHeight="340"
                            Padding="8"
                            Background="#F0141414"
                            BorderBrush="#26FFFFFF"
                            BorderThickness="1"
                            BoxShadow="0 14 42 0 #90000000"
                            CornerRadius="14">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Margin="8,4,8,4"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="#CCFFFFFF"
                                        Text="{DynamicResource l.player.controls.audio_track_toggle}" />
                                    <Rectangle
                                        Height="1"
                                        Margin="0,2,0,4"
                                        Fill="#1EFFFFFF" />
                                    <ItemsControl ItemsSource="{Binding AudioTracks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="mpv:TrackInfo">
                                                <Button Classes="track-menu-item" Click="OnTrackMenuItemClick">
                                                    <Grid ColumnDefinitions="22,*">
                                                        <material:MaterialIcon
                                                            Grid.Column="0"
                                                            Width="14"
                                                            Height="14"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource SystemAccentColor}"
                                                            IsVisible="{Binding Selected}"
                                                            Kind="Check" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding DisplayName}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Flyout>
                </Button.Flyout>
                <material:MaterialIcon
                    Width="21"
                    Height="21"
                    Foreground="White"
                    Kind="MusicNote" />
            </Button>

            <!--  Subtitle position  -->
            <Button
                Name="SubtitlePositionButton"
                Classes="icon-btn"
                IsVisible="{Binding ShowSubtitlePositionButton}"
                ToolTip.Tip="{DynamicResource l.player.controls.subtitles_position_tip}">
                <material:MaterialIcon
                    Width="20"
                    Height="20"
                    Foreground="White"
                    Kind="FormatLineSpacing" />
            </Button>

            <!--  Subtitle style override  -->
            <Button
                Classes="icon-btn"
                Classes.active="{Binding SubtitleStyleOverrideEnabled}"
                Command="{Binding ToggleSubtitleStyleOverrideCommand}"
                IsVisible="{Binding ShowSubtitleStyleButton}"
                ToolTip.Tip="{DynamicResource l.player.controls.subtitles_style}">
                <material:MaterialIcon
                    Width="20"
                    Height="20"
                    Foreground="White"
                    Kind="FormatPaint" />
            </Button>

            <!--  Screenshot  -->
            <Button
                Name="ScreenshotButton"
                Classes="icon-btn"
                IsVisible="{Binding ShowScreenshotButton}"
                ToolTip.Tip="{DynamicResource l.player.controls.screenshot}">
                <material:MaterialIcon
                    Width="20"
                    Height="20"
                    Foreground="White"
                    Kind="CameraOutline" />
            </Button>

            <!--  Player settings  -->
            <controls:PlayerSettingsButton x:Name="SettingsBtn" />

            <!--  Fullscreen  -->
            <Button
                Name="FullscreenButton"
                Classes="icon-btn"
                Click="OnFullscreenButtonClick"
                ToolTip.Tip="{DynamicResource l.player.controls.fullscreen}">
                <material:MaterialIcon
                    Width="22"
                    Height="22"
                    Foreground="White"
                    Kind="Fullscreen" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
