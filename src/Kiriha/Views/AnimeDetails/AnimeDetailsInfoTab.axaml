<UserControl
    x:Class="Kiriha.Views.AnimeDetails.AnimeDetailsInfoTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
    x:DataType="vmAnimeDetails:AnimeDetailsViewModel">
    <UserControl.Resources>
        <conv:LocConverter x:Key="LocConverter" />
    </UserControl.Resources>
    <!--  ══ TABBED INFO CARD (Details / Synopsis / Alt Titles) ══  -->
    <Border Padding="0" Classes="ContentCard">
        <StackPanel>
            <!--  Tabs header  -->
            <Border
                Padding="8,0,20,0"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="TabDetails"
                        Classes="Tab"
                        Content="{DynamicResource l.common.actions.details}"
                        GroupName="DetailsTab"
                        IsChecked="True" />
                    <RadioButton
                        x:Name="TabSynopsis"
                        Classes="Tab"
                        Content="{DynamicResource l.anime.labels.synopsis}"
                        GroupName="DetailsTab" />
                    <RadioButton
                        x:Name="TabAltTitles"
                        Classes="Tab"
                        Content="{DynamicResource l.anime.labels.alternative_titles}"
                        GroupName="DetailsTab" />
                </StackPanel>
            </Border>

            <Panel Margin="20,16">
                <!--  Details  -->
                <Grid
                    Classes="DetailsGrid"
                    ColumnDefinitions="Auto, *"
                    IsVisible="{Binding #TabDetails.IsChecked}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="6">
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Classes="Label"
                        Text="{DynamicResource l.anime.labels.status}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        FontWeight="Medium"
                        Text="{Binding Anime.Presentation.DisplayAiringStatus}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Classes="Label"
                        IsVisible="{Binding Anime.Presentation.IsAnime}"
                        Text="{DynamicResource l.anime.labels.episodes}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        IsVisible="{Binding Anime.Presentation.IsAnime}"
                        Text="{Binding Anime.Presentation.EpisodesDisplay}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Classes="Label"
                        IsVisible="{Binding Anime.Presentation.IsManga}"
                        Text="{DynamicResource l.anime.labels.chapters}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        IsVisible="{Binding Anime.Presentation.IsManga}"
                        Text="{Binding Anime.Presentation.ChaptersDisplay}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Classes="Label"
                        IsVisible="{Binding Anime.Presentation.IsManga}"
                        Text="{DynamicResource l.anime.labels.volumes}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        IsVisible="{Binding Anime.Presentation.IsManga}"
                        Text="{Binding Anime.Presentation.VolumesDisplay}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Classes="Label"
                        Text="{DynamicResource l.anime.labels.aired_episodes}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Settings.Current.UI.ShowAiringInfo" />
                                <Binding Path="Anime.Presentation.ShowAiredInfo" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Text="{Binding Anime, Converter={StaticResource LocConverter}, ConverterParameter='format:l.anime.labels.aired_format'}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Settings.Current.UI.ShowAiringInfo" />
                                <Binding Path="Anime.Presentation.ShowAiredInfo" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Classes="Label"
                        IsVisible="{Binding Anime.NextEpisodeAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Text="{DynamicResource l.anime.labels.next_episode}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        IsVisible="{Binding Anime.NextEpisodeAt, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Text="{Binding Anime.Presentation.NextEpisodeAtDisplay}" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Classes="Label"
                        Text="{DynamicResource l.anime.labels.genres}" />
                    <SelectableTextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Text="{Binding Anime.Genres, Converter={StaticResource LocConverter}}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Classes="Label"
                        IsVisible="{Binding Anime.Presentation.IsAnime}"
                        Text="{DynamicResource l.anime.labels.studios}" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Classes="Label"
                        IsVisible="{Binding Anime.Presentation.IsManga}"
                        Text="{DynamicResource l.anime.labels.authors}" />
                    <SelectableTextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        Text="{Binding Anime.Presentation.StudiosDisplay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Classes="Label"
                        Text="{DynamicResource l.anime.labels.score}" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="1"
                        Text="{Binding Anime.MeanScore}" />
                </Grid>

                <!--  Synopsis  -->
                <StackPanel IsVisible="{Binding #TabSynopsis.IsChecked}">
                    <SelectableTextBlock
                        FontSize="13"
                        LineHeight="22"
                        Opacity="0.85"
                        Text="{Binding Anime.Presentation.DisplaySynopsis}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="13"
                        IsVisible="{Binding Anime.Presentation.DisplaySynopsis, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                        Opacity="0.5"
                        Text="{DynamicResource l.anime.labels.no_synopsis}" />
                </StackPanel>

                <!--  Alt titles  -->
                <StackPanel IsVisible="{Binding #TabAltTitles.IsChecked}">
                    <ItemsControl ItemsSource="{Binding Metadata.AllAlternativeTitles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border
                                    Margin="0,0,8,8"
                                    Padding="10,6"
                                    Background="{DynamicResource SubtleFillColorSecondary}"
                                    CornerRadius="8">
                                    <SelectableTextBlock
                                        FontSize="12"
                                        Opacity="0.8"
                                        Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        FontSize="13"
                        IsVisible="{Binding !Metadata.HasAlternativeTitles}"
                        Opacity="0.5"
                        Text="{DynamicResource l.anime.labels.no_alternative_titles}" />
                </StackPanel>
            </Panel>
        </StackPanel>
    </Border>
</UserControl>
