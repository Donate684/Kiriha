<UserControl
    x:Class="Kiriha.Views.AnimeDetails.AnimeDetailsRelations"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:u="using:Kiriha.Utils.Graphs"
    xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
    x:DataType="vmAnimeDetails:AnimeDetailsViewModel">
    <UserControl.Resources>
        <conv:StatusNoneConverter x:Key="StatusNoneConverter" />
        <conv:StatusNotNoneConverter x:Key="StatusNotNoneConverter" />
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:StatusToIconConverter x:Key="StatusToIconConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.FranchiseTimelineCardButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.FranchiseTimelineCardButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Button.FranchiseTimelineCardButton.current">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
    </UserControl.Styles>

    <Panel IsVisible="{Binding HasAnyRelationsOrTimeline}">
        <!--  ═══════════════════════════════════════════════════════════════  -->
        <!--  OPTION A: RICH FRANCHISE CHRONOLOGY (when franchise exists)  -->
        <!--  ═══════════════════════════════════════════════════════════════  -->
        <Border Classes="ContentCard" IsVisible="{Binding HasFranchiseTimeline}">
            <StackPanel Spacing="10">
                <!--  Header  -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <material:MaterialIcon
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource SystemAccentColor}"
                            Kind="TimelineClockOutline" />
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            Classes="SectionTitle"
                            Text="{DynamicResource l.anime.labels.franchise_chronology}" />
                    </StackPanel>

                    <!--  Franchise Completion Counter Badge  -->
                    <Border
                        Grid.Column="1"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondary}"
                        BorderBrush="{DynamicResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ToolTip.Tip="{Binding FranchiseProgressTooltip}">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <material:MaterialIcon
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemAccentColor}"
                                Kind="ProgressCheck" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{Binding FranchiseProgressSummary}" />
                            <Border
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemAccentColor}"
                                CornerRadius="6">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding FranchiseCompletionPercentText}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Chronological Franchise Feed  -->
                <ItemsControl ItemsSource="{Binding FranchiseTimeline}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="u:FranchiseGraphVisualNode">
                            <Grid Margin="0,0,0,8" ColumnDefinitions="38, *">
                                <!--  Step Number & Rail Line (Column 0)  -->
                                <Panel Grid.Column="0">
                                    <Canvas
                                        Width="0"
                                        Height="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Rectangle
                                            Canvas.Left="-1"
                                            Canvas.Top="0"
                                            Width="2"
                                            Height="86"
                                            Fill="{DynamicResource DividerStrokeColorDefault}"
                                            IsVisible="{Binding !IsLastInTimeline}" />
                                    </Canvas>
                                    <Border
                                        Width="26"
                                        Height="26"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource CardBackgroundFillDefault}"
                                        BorderBrush="{DynamicResource SystemAccentColor}"
                                        BorderThickness="2"
                                        CornerRadius="13">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource SystemAccentColor}"
                                            Text="{Binding StepIndex}" />
                                    </Border>
                                </Panel>

                                <!--  Card Button (Column 1)  -->
                                <Button
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Classes="FranchiseTimelineCardButton"
                                    Command="{Binding $parent[Window].((vmAnimeDetails:AnimeDetailsViewModel)DataContext).NavigateToFranchiseNodeCommand}"
                                    CommandParameter="{Binding}">
                                    <Classes.current>
                                        <Binding Path="IsCurrent" />
                                    </Classes.current>

                                    <Grid
                                        Height="78"
                                        ClipToBounds="True"
                                        ColumnDefinitions="64, *">
                                        <!--  Poster  -->
                                        <Border
                                            Grid.Column="0"
                                            Background="{DynamicResource SubtleFillColorSecondary}"
                                            ClipToBounds="True"
                                            CornerRadius="9,0,0,9">
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding DisplayImageUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <!--  Content  -->
                                        <Grid
                                            Grid.Column="1"
                                            Margin="12,8,12,7"
                                            RowDefinitions="Auto, *, Auto">
                                            <!--  Top row: Format & Role & Year  -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                                <StackPanel
                                                    Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                                    <Border
                                                        Padding="5,1"
                                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="9.5"
                                                            FontWeight="Bold"
                                                            Text="{Binding KindBadge}" />
                                                    </Border>
                                                    <Border
                                                        Padding="5,1"
                                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="9.5"
                                                            FontWeight="SemiBold"
                                                            Opacity="0.8"
                                                            Text="{Binding RoleBadge}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    IsVisible="{Binding Node.Year, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Opacity="0.6"
                                                    Text="{Binding Node.Year}" />
                                            </Grid>

                                            <!--  Middle: Titles  -->
                                            <StackPanel
                                                Grid.Row="1"
                                                Margin="0,2,0,2"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    Text="{Binding DisplayTitle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="10"
                                                    IsVisible="{Binding SubTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    Opacity="0.5"
                                                    Text="{Binding SubTitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!--  Bottom: Status, Score & "You are here"  -->
                                            <Grid
                                                Grid.Row="2"
                                                VerticalAlignment="Bottom"
                                                ColumnDefinitions="*, Auto">
                                                <StackPanel
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                                    <!--  In list  -->
                                                    <Border
                                                        Height="17"
                                                        Padding="5,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding UserStatus, Converter={StaticResource StatusToColorConverter}}"
                                                        CornerRadius="3.5"
                                                        IsVisible="{Binding UserStatus, Converter={StaticResource StatusNotNoneConverter}}">
                                                        <StackPanel
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="3.5">
                                                            <material:MaterialIcon
                                                                Width="9.5"
                                                                Height="9.5"
                                                                VerticalAlignment="Center"
                                                                Foreground="White"
                                                                Kind="{Binding UserStatus, Converter={StaticResource StatusToIconConverter}}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="9"
                                                                FontWeight="SemiBold"
                                                                Foreground="White"
                                                                Text="{Binding ProgressBadgeText}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!--  Not in list  -->
                                                    <Border
                                                        Height="17"
                                                        Padding="5,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SubtleFillColorSecondary}"
                                                        CornerRadius="3.5"
                                                        IsVisible="{Binding UserStatus, Converter={StaticResource StatusNoneConverter}}">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            Opacity="0.7"
                                                            Text="{Binding ProgressBadgeText}" />
                                                    </Border>

                                                    <!--  User Score  -->
                                                    <Border
                                                        Height="17"
                                                        Padding="5,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource ScorePillBackground}"
                                                        BorderBrush="{DynamicResource ScorePillBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="3.5"
                                                        IsVisible="{Binding HasUserScore}">
                                                        <StackPanel
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal"
                                                            Spacing="3">
                                                            <material:MaterialIcon
                                                                Width="9"
                                                                Height="9"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource ScorePillStar}"
                                                                Kind="Star" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="9"
                                                                FontWeight="Bold"
                                                                Foreground="{DynamicResource ScorePillForeground}"
                                                                Text="{Binding Score}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!--  Current active anime badge  -->
                                                <Border
                                                    Grid.Column="1"
                                                    Height="17"
                                                    Padding="5,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemAccentColor}"
                                                    CornerRadius="3.5"
                                                    IsVisible="{Binding IsCurrent}">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="8.5"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{DynamicResource l.anime.labels.franchise_you_are_here}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  ═══════════════════════════════════════════════════════════════  -->
        <!--  OPTION B: FALLBACK STANDARD RELATIONS (when no franchise data)  -->
        <!--  ═══════════════════════════════════════════════════════════════  -->
        <Border Classes="ContentCard" IsVisible="{Binding HasStandardRelations}">
            <StackPanel>
                <Grid Margin="0,0,0,10" ColumnDefinitions="*">
                    <TextBlock
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        Classes="SectionTitle"
                        Text="{DynamicResource l.anime.labels.relations}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Relations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vmAnimeDetails:RelationItemVm">
                            <Button
                                Margin="0,0,0,6"
                                HorizontalAlignment="Stretch"
                                Classes="RelationCardButton"
                                Command="{Binding $parent[Window].((vmAnimeDetails:AnimeDetailsViewModel)DataContext).NavigateToRelationCommand}"
                                CommandParameter="{Binding Relation}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <!--  Image  -->
                                    <Border
                                        Grid.Column="0"
                                        Width="42"
                                        Height="58"
                                        Margin="0,0,12,0"
                                        ClipToBounds="True"
                                        CornerRadius="6">
                                        <Panel>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" />
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{Binding Relation.TargetName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Opacity="0.6"
                                            Text="{Binding Relation.RelationType}" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="6"
                                        IsVisible="{Binding DisplayTargetType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding DisplayTargetType}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
