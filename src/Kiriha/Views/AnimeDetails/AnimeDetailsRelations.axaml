<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
             xmlns:u="using:Kiriha.Utils.Graphs"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:conv="using:Kiriha.Views.Converters"
             x:Class="Kiriha.Views.AnimeDetails.AnimeDetailsRelations"
             x:DataType="vmAnimeDetails:AnimeDetailsViewModel">
    <UserControl.Resources>
        <conv:StatusNoneConverter x:Key="StatusNoneConverter"/>
        <conv:StatusNotNoneConverter x:Key="StatusNotNoneConverter"/>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:StatusToIconConverter x:Key="StatusToIconConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.FranchiseTimelineCardButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.FranchiseTimelineCardButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverFillColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="Button.FranchiseTimelineCardButton.current">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </UserControl.Styles>

    <Panel IsVisible="{Binding HasAnyRelationsOrTimeline}">
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- OPTION A: RICH FRANCHISE CHRONOLOGY (when franchise exists)    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Classes="ContentCard" IsVisible="{Binding HasFranchiseTimeline}">
            <StackPanel Spacing="10">
                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <material:MaterialIcon Kind="TimelineClockOutline" Width="18" Height="18" Foreground="{DynamicResource SystemAccentColor}"/>
                        <TextBlock Text="{DynamicResource l.anime.labels.franchise_chronology}" Classes="SectionTitle" Margin="0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Franchise Completion Counter Badge -->
                    <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondary}"
                            BorderBrush="{DynamicResource CardStrokeColorDefault}"
                            BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding FranchiseProgressTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <material:MaterialIcon Kind="ProgressCheck" Width="15" Height="15"
                                                   Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FranchiseProgressSummary}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FranchiseCompletionPercentText}" FontSize="10" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Chronological Franchise Feed -->
                <ItemsControl ItemsSource="{Binding FranchiseTimeline}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="u:FranchiseGraphVisualNode">
                            <Grid ColumnDefinitions="38, *" Margin="0,0,0,8">
                                <!-- Step Number & Rail Line (Column 0) -->
                                <Panel Grid.Column="0">
                                    <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle Canvas.Left="-1" Canvas.Top="0" Width="2" Height="86"
                                                   Fill="{DynamicResource DividerStrokeColorDefault}"
                                                   IsVisible="{Binding !IsLastInTimeline}"/>
                                    </Canvas>
                                    <Border Width="26" Height="26" CornerRadius="13"
                                            Background="{DynamicResource CardBackgroundFillDefault}"
                                            BorderBrush="{DynamicResource SystemAccentColor}"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StepIndex}" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemAccentColor}"/>
                                    </Border>
                                </Panel>

                                <!-- Card Button (Column 1) -->
                                <Button Grid.Column="1" Classes="FranchiseTimelineCardButton"
                                        Margin="6,0,0,0"
                                        Command="{Binding $parent[Window].((vmAnimeDetails:AnimeDetailsViewModel)DataContext).NavigateToFranchiseNodeCommand}"
                                        CommandParameter="{Binding}">
                                    <Classes.current>
                                        <Binding Path="IsCurrent"/>
                                    </Classes.current>

                                    <Grid ColumnDefinitions="64, *" ClipToBounds="True" Height="78">
                                        <!-- Poster -->
                                        <Border Grid.Column="0" CornerRadius="9,0,0,9" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondary}">
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding DisplayImageUrl}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Content -->
                                        <Grid Grid.Column="1" Margin="12,8,12,7" RowDefinitions="Auto, *, Auto">
                                            <!-- Top row: Format & Role & Year -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                                    <Border Background="{DynamicResource SubtleFillColorSecondary}" CornerRadius="4" Padding="5,1">
                                                        <TextBlock Text="{Binding KindBadge}" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondary}" CornerRadius="4" Padding="5,1">
                                                        <TextBlock Text="{Binding RoleBadge}" FontSize="9.5" FontWeight="SemiBold" Opacity="0.8"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Node.Year}" FontSize="10.5" Opacity="0.6" FontWeight="SemiBold"
                                                           IsVisible="{Binding Node.Year, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </Grid>

                                            <!-- Middle: Titles -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,2">
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12.5" 
                                                           TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SubTitle}" FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding SubTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>

                                            <!-- Bottom: Status, Score & "You are here" -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalAlignment="Bottom">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <!-- In list -->
                                                    <Border CornerRadius="3.5" Padding="5,0" Height="17" VerticalAlignment="Center"
                                                            Background="{Binding UserStatus, Converter={StaticResource StatusToColorConverter}}"
                                                            IsVisible="{Binding UserStatus, Converter={StaticResource StatusNotNoneConverter}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="3.5" VerticalAlignment="Center">
                                                            <material:MaterialIcon Kind="{Binding UserStatus, Converter={StaticResource StatusToIconConverter}}" Width="9.5" Height="9.5" Foreground="White" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ProgressBadgeText}" FontSize="9" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Not in list -->
                                                    <Border CornerRadius="3.5" Padding="5,0" Height="17" VerticalAlignment="Center"
                                                            Background="{DynamicResource SubtleFillColorSecondary}"
                                                            IsVisible="{Binding UserStatus, Converter={StaticResource StatusNoneConverter}}">
                                                        <TextBlock Text="{Binding ProgressBadgeText}" FontSize="9" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- User Score -->
                                                    <Border CornerRadius="3.5" Padding="5,0" Height="17" VerticalAlignment="Center"
                                                            Background="{DynamicResource ScorePillBackground}"
                                                            BorderBrush="{DynamicResource ScorePillBorder}"
                                                            BorderThickness="1"
                                                            IsVisible="{Binding HasUserScore}">
                                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                            <material:MaterialIcon Kind="Star" Width="9" Height="9" Foreground="{DynamicResource ScorePillStar}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Score}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ScorePillForeground}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Current active anime badge -->
                                                <Border Grid.Column="1" Background="{DynamicResource SystemAccentColor}" CornerRadius="3.5" Padding="5,0" Height="17" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsCurrent}">
                                                    <TextBlock Text="{DynamicResource l.anime.labels.franchise_you_are_here}" FontSize="8.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- OPTION B: FALLBACK STANDARD RELATIONS (when no franchise data)  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Classes="ContentCard" IsVisible="{Binding HasStandardRelations}">
            <StackPanel>
                <Grid ColumnDefinitions="*" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="{DynamicResource l.anime.labels.relations}" Classes="SectionTitle" Margin="0" VerticalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Relations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vmAnimeDetails:RelationItemVm">
                            <Button Classes="RelationCardButton" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                    Command="{Binding $parent[Window].((vmAnimeDetails:AnimeDetailsViewModel)DataContext).NavigateToRelationCommand}"
                                    CommandParameter="{Binding Relation}">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <!-- Image -->
                                    <Border Grid.Column="0" Width="42" Height="58" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
                                        <Panel>
                                            <Border Background="{DynamicResource CardBackgroundBrush}"/>
                                            <Image asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                        </Panel>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Relation.TargetName}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/>
                                        <TextBlock Text="{Binding Relation.RelationType}" FontSize="11" Opacity="0.6" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    
                                    <Border Grid.Column="2" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" IsVisible="{Binding DisplayTargetType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding DisplayTargetType}" FontSize="10" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
