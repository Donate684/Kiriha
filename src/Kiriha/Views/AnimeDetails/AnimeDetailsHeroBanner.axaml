<UserControl
    x:Class="Kiriha.Views.AnimeDetails.AnimeDetailsHeroBanner"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:conv="using:Kiriha.Views.Converters"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
    xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
    x:DataType="vmAnimeDetails:AnimeDetailsViewModel">
    <UserControl.Resources>
        <conv:LocConverter x:Key="LocConverter" />
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter" />
    </UserControl.Resources>
    <Border Padding="28,40,28,20" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="{DynamicResource SystemAccentColor}" />
                <GradientStop Offset="0.6" Color="{DynamicResource SystemAccentColorDark1}" />
                <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark2}" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid VerticalAlignment="Center" ColumnDefinitions="Auto, *">
            <Border
                Grid.Column="0"
                Width="105"
                Height="152"
                BoxShadow="0 8 24 0 #40000000"
                ClipToBounds="True"
                CornerRadius="10"
                Cursor="Hand"
                ToolTip.Tip="{DynamicResource l.anime.labels.view_poster}">
                <Panel>
                    <Image asyncImageLoader:ImageLoader.Source="{Binding Anime.MainPictureUrl}" Stretch="UniformToFill" />

                    <Button
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding OpenPosterPreviewCommand}"
                        CornerRadius="10"
                        Cursor="Hand">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                    </Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </Button.Styles>
                        <Border
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#55000000">
                            <material:MaterialIcon
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="MagnifyPlusOutline" />
                        </Border>
                    </Button>
                </Panel>
            </Border>
            <StackPanel
                Grid.Column="1"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Spacing="4">
                <SelectableTextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"
                    LineHeight="34"
                    Text="{Binding Anime.Presentation.RomajiTitle}"
                    TextWrapping="Wrap" />
                <SelectableTextBlock
                    FontSize="15"
                    Foreground="#BFFFFFFF"
                    IsVisible="{Binding Anime.Presentation.HasSecondaryTitle}"
                    Text="{Binding Anime.Presentation.SecondaryTitle}"
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <material:MaterialIcon
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            Foreground="Gold"
                            Kind="Star" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{Binding Anime.MeanScore}" />
                    </StackPanel>
                    <Border
                        Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        Background="#30FFFFFF" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <material:MaterialIcon
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="#A0FFFFFF"
                            Kind="Television" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#D0FFFFFF"
                            Text="{Binding Anime.Type, Converter={StaticResource LocConverter}}" />
                    </StackPanel>
                    <Border
                        Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        Background="#30FFFFFF" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <material:MaterialIcon
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="#A0FFFFFF"
                            Kind="Calendar" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#D0FFFFFF"
                            Text="{Binding Anime.Season, Converter={StaticResource LocConverter}}" />
                    </StackPanel>
                    <Border
                        Width="1"
                        Height="12"
                        VerticalAlignment="Center"
                        Background="#30FFFFFF" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <material:MaterialIcon
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="#A0FFFFFF"
                            Kind="TrendingUp" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#D0FFFFFF"
                            Text="{Binding Anime.Popularity, StringFormat='#{0}'}" />
                    </StackPanel>
                </StackPanel>

                <!--  Action Row Links  -->
                <StackPanel
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Border
                        Width="30"
                        Height="30"
                        Background="#25FFFFFF"
                        CornerRadius="8"
                        ToolTip.Tip="MyAnimeList">
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#40FFFFFF" />
                            </Style>
                        </Border.Styles>
                        <Button
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Command="{Binding OpenMalLinkCommand}"
                            CornerRadius="8">
                            <Image
                                Width="16"
                                Height="16"
                                Opacity="0.95"
                                Source="/Assets/myanimelist_white.png" />
                        </Button>
                    </Border>
                    <Border
                        Width="30"
                        Height="30"
                        Background="#25FFFFFF"
                        CornerRadius="8"
                        ToolTip.Tip="Shikimori">
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#40FFFFFF" />
                            </Style>
                        </Border.Styles>
                        <Button
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Command="{Binding OpenShikiLinkCommand}"
                            CornerRadius="8">
                            <Image
                                Width="16"
                                Height="16"
                                Opacity="0.95"
                                Source="/Assets/shikimori_white.png" />
                        </Button>
                    </Border>
                    <!--  User Share links  -->
                    <ItemsControl ItemsSource="{Binding CustomShareLinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmSettings:CustomShareLinkRuntime">
                                <Border
                                    Width="30"
                                    Height="30"
                                    Background="#25FFFFFF"
                                    CornerRadius="8"
                                    ToolTip.Tip="{Binding Name}">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="#40FFFFFF" />
                                        </Style>
                                    </Border.Styles>
                                    <Button
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Command="{Binding OpenCommand}"
                                        CornerRadius="8">
                                        <Panel>
                                            <material:MaterialIcon
                                                Width="16"
                                                Height="16"
                                                Foreground="White"
                                                IsVisible="{Binding UseIconKind}"
                                                Kind="{Binding IconKind}" />
                                            <Image
                                                Width="18"
                                                Height="18"
                                                IsVisible="{Binding HasIconImage}"
                                                Source="{Binding IconPath, Converter={StaticResource FilePathToBitmapConverter}}"
                                                Stretch="UniformToFill" />
                                        </Panel>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
