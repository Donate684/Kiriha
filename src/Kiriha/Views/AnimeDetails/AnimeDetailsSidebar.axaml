<UserControl
    x:Class="Kiriha.Views.AnimeDetails.AnimeDetailsSidebar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:details="using:Kiriha.Views.AnimeDetails"
    xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
    x:DataType="vmAnimeDetails:AnimeDetailsViewModel">

    <Border
        Background="{DynamicResource LayerFillColorDefault}"
        BorderBrush="{DynamicResource DividerStrokeColorDefault}"
        BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,18,14,20" Spacing="16">

                <!--  ══ IN LIST: User editing controls ══  -->
                <details:AnimeDetailsSidebarEditor IsEnabled="{Binding !Editor.IsBusy}" />

                <!--  ══ NOT IN LIST: Add to List button ══  -->
                <details:AnimeDetailsSidebarAddButton IsEnabled="{Binding !Editor.IsBusy}" />

                <TextBlock
                    Foreground="{DynamicResource OrangeredAccentBrush}"
                    IsVisible="{Binding Editor.HasSaveError}"
                    Text="{DynamicResource l.common.errors.generic}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{DynamicResource OrangeredAccentBrush}"
                    IsVisible="{Binding Editor.HasEntryConflict}"
                    Text="{DynamicResource l.anime.list_actions.entry_conflict}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{DynamicResource OrangeredAccentBrush}"
                    IsVisible="{Binding Editor.HasFieldConflict}"
                    Text="{DynamicResource l.anime.list_actions.field_conflict}"
                    TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

