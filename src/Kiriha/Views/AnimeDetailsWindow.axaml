<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmStartup="using:Kiriha.ViewModels.Startup"
        xmlns:vmDialogs="using:Kiriha.ViewModels.Dialogs"
        xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
        xmlns:vmMain="using:Kiriha.ViewModels.Main"
        xmlns:vm="using:Kiriha.ViewModels"
             xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics"
             xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
             xmlns:vmAnimeList="using:Kiriha.ViewModels.AnimeList"
             xmlns:vmHistory="using:Kiriha.ViewModels.History"
             xmlns:vmPlayer="using:Kiriha.ViewModels.Player"
             xmlns:vmSeasonal="using:Kiriha.ViewModels.Seasonal"
             xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
             xmlns:vmTorrents="using:Kiriha.ViewModels.Torrents"
             xmlns:vmSearch="using:Kiriha.ViewModels.Search"
        xmlns:models="using:Kiriha.Core.Domain.Models"
        xmlns:entities="using:Kiriha.Core.Domain.Models.Entities"
        xmlns:controls="using:Kiriha.Views.Controls"
        xmlns:details="using:Kiriha.Views.AnimeDetails"
        xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:conv="using:Kiriha.Views.Converters"
        xmlns:u="using:Kiriha.Utils.UI"
        x:Class="Kiriha.Views.AnimeDetailsWindow"
        x:DataType="vmAnimeDetails:AnimeDetailsViewModel"
        x:Name="Root"
        Title=""
        Width="920" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{x:Null}"
        TransparencyLevelHint="Mica, AcrylicBlur"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="34"
        WindowDecorations="BorderOnly">

    <Window.Resources>
        <conv:LocConverter x:Key="LocConverter"/>
        <conv:RatingConverter x:Key="RatingConverter"/>
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter"/>
        <conv:IntToBooleanConverter x:Key="IntToBoolConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Modern Card Style -->
        <Style Selector="Border.ContentCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 4 16 0 #0A000000"/>
        </Style>
        <Style Selector="Border.ContentCard:pointerover">
            <Setter Property="BoxShadow" Value="0 6 20 0 #0F000000"/>
        </Style>

        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Grid.DetailsGrid > Control">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Grid.DetailsGrid > TextBlock">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Grid.DetailsGrid > TextBlock.Label">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button.AddButton">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.AddButton:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.01)"/>
            <Setter Property="Opacity" Value="0.95"/>
        </Style>

        <!-- Underline-style tabs integrated into the card header -->
        <Style Selector="RadioButton.Tab">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="*,3">
                        <ContentPresenter Grid.Row="0"
                                          Name="PART_Content"
                                          Content="{TemplateBinding Content}"
                                          Margin="0,0,0,12"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <Rectangle Grid.Row="1" Name="PART_Indicator"
                                   Height="3" Fill="Transparent"
                                   RadiusX="1.5" RadiusY="1.5"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="RadioButton.Tab:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="RadioButton.Tab:checked">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="RadioButton.Tab:checked /template/ Rectangle#PART_Indicator">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}"/>
        </Style>

        <!-- Share Flyout -->
        <Style Selector="FlyoutPresenter.ShareFlyout">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="240"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Share Row Button -->
        <Style Selector="Button.ShareRow">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ShareRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorSecondary}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <!-- Sidebar field label -->
        <Style Selector="TextBlock.SidebarLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- ComboBox custom styling for modern look -->
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Relation/Staff Buttons -->
        <Style Selector="Button.RelationCardButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.RelationCardButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
    </Window.Styles>

    <LayoutTransformControl Name="ScaleRoot">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </LayoutTransformControl.LayoutTransform>
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Height="34" VerticalAlignment="Top" Background="Transparent" IsHitTestVisible="True" PointerPressed="OnTitleBarPressed" ZIndex="10"/>
        
        <controls:TitleBarButtons Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="999" Foreground="White"/>
        
        <!-- =================================================================== -->
        <!-- HERO BANNER                                                        -->
        <!-- =================================================================== -->
            <details:AnimeDetailsHeroBanner />

        <!-- =================================================================== -->
        <!-- CONTENT AREA: Sidebar (290px) + Main Content (*)                   -->
        <!-- =================================================================== -->
        <Grid Grid.Row="1" ColumnDefinitions="290, *">

            <!-- ======================= SIDEBAR ======================= -->
                <details:AnimeDetailsSidebar Grid.Column="0" />

            <!-- ======================= MAIN CONTENT ======================= -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" u:SmoothScroll.IsEnabled="True">
                <StackPanel Spacing="16" Margin="24,18,28,24">

                    <details:AnimeDetailsInfoTab />

                    <!-- == RELATIONS == -->
                    <details:AnimeDetailsRelations />

                    <!-- == STAFF+ == -->
                    <details:AnimeDetailsStaff />

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
    </LayoutTransformControl>
</Window>
