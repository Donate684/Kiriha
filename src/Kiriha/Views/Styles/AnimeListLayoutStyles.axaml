<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia">

        <Style Selector="FlyoutPresenter.ScoreFlyout, MenuFlyoutPresenter.ScoreFlyout">
            <Setter Property="Background" Value="{DynamicResource ScoreFlyoutBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ScoreFlyoutBorder}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MaxWidth" Value="250"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter.ScoreFlyout MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Background" Value="{DynamicResource ScoreFlyoutItemHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource ScoreFlyoutItemForeground}"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter.ScoreFlyout MenuItem:pressed /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Background" Value="{DynamicResource ScoreFlyoutItemPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource ScoreFlyoutItemForeground}"/>
        </Style>
        <Style Selector="Button.ScoreBadgeButton">
            <Setter Property="Background" Value="#88000000"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ScoreBadgeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EE000000"/>
        </Style>

        <!-- Sort list inside flyout -->
        <Style Selector="ListBox.SortList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.SortList ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.SortList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox.SortList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="ListBox.SortList ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="ListBox.SortList ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>

        <!-- ═══ MediaKind Segmented Toggle (Anime | Manga) ═══ -->
        <!-- Container track -->
        <Style Selector="StackPanel.MediaKindSegment">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiary}"/>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          x:Name="ContentPresenter"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle:checked /template/ Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
            <Setter Property="BoxShadow" Value="0 1 4 0 #18000000, 0 0 0 0.5 #14000000"/>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle:checked:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle:checked /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle material|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle:checked material|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="RadioButton.MediaKindToggle:checked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ToggleButton.MediaKindIconToggle">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource SubtleFillColorTertiary}" CornerRadius="15">
                        <Panel>
                            <Border x:Name="Thumb" 
                                    Background="{DynamicResource CardBackgroundFillDefault}" 
                                    CornerRadius="13" 
                                    Width="26" Height="26" 
                                    HorizontalAlignment="Left" 
                                    Margin="2,0,0,0" 
                                    BoxShadow="0 1 4 0 #18000000, 0 0 0 0.5 #14000000">
                                <Border.Transitions>
                                    <Transitions>
                                        <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            
                            <Grid ColumnDefinitions="*,*">
                                <material:MaterialIcon Grid.Column="0" Kind="PlayBoxOutline" Width="16" Height="16" x:Name="IconLeft" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <material:MaterialIcon.Transitions>
                                        <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                    </material:MaterialIcon.Transitions>
                                </material:MaterialIcon>
                                
                                <material:MaterialIcon Grid.Column="1" Kind="BookOpenPageVariantOutline" Width="16" Height="16" x:Name="IconRight" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <material:MaterialIcon.Transitions>
                                        <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                    </material:MaterialIcon.Transitions>
                                </material:MaterialIcon>
                            </Grid>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.MediaKindIconToggle:checked /template/ Border#Thumb">
            <Setter Property="Margin" Value="32,0,0,0"/>
        </Style>

        <Style Selector="ToggleButton.MediaKindIconToggle:checked /template/ material|MaterialIcon#IconLeft">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.MediaKindIconToggle:checked /template/ material|MaterialIcon#IconRight">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <!-- ═══ MediaKind Unified Capsule Slider Toggle (Anime | Manga) with text & icons ═══ -->
        <Style Selector="ToggleButton.MediaKindTextToggle">
            <Setter Property="Width" Value="156"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource SubtleFillColorTertiary}"
                            BorderBrush="{DynamicResource CardStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <Panel>
                            <Border x:Name="Thumb"
                                    Background="{DynamicResource CardBackgroundFillDefault}"
                                    CornerRadius="12"
                                    Width="74" Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"
                                    BoxShadow="0 1 4 0 #18000000, 0 0 0 0.5 #14000000">
                                <Border.Transitions>
                                    <Transitions>
                                        <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="PlayBoxOutline" Width="14" Height="14" x:Name="IconLeft"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center">
                                        <material:MaterialIcon.Transitions>
                                            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                        </material:MaterialIcon.Transitions>
                                    </material:MaterialIcon>
                                    <TextBlock Text="{DynamicResource l.anime.types.anime}" FontSize="12" FontWeight="SemiBold"
                                               x:Name="TextLeft" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <TextBlock.Transitions>
                                            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                        </TextBlock.Transitions>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="BookOpenPageVariantOutline" Width="14" Height="14" x:Name="IconRight"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center">
                                        <material:MaterialIcon.Transitions>
                                            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                        </material:MaterialIcon.Transitions>
                                    </material:MaterialIcon>
                                    <TextBlock Text="{DynamicResource l.anime.types.manga}" FontSize="12"
                                               x:Name="TextRight" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Transitions>
                                            <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.2"/></Transitions>
                                        </TextBlock.Transitions>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.MediaKindTextToggle:checked /template/ Border#Thumb">
            <Setter Property="Margin" Value="78,0,0,0"/>
        </Style>

        <Style Selector="ToggleButton.MediaKindTextToggle:checked /template/ material|MaterialIcon#IconLeft">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.MediaKindTextToggle:checked /template/ TextBlock#TextLeft">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style Selector="ToggleButton.MediaKindTextToggle:checked /template/ material|MaterialIcon#IconRight">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.MediaKindTextToggle:checked /template/ TextBlock#TextRight">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ToggleButton.MediaKindTextToggle:pointerover /template/ Border#Thumb">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
        </Style>

        <!-- ═══ Schedule (Release Map) Capsule Toggle Button ═══ -->
        <Style Selector="Button.ScheduleToggle">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Root"
                            Height="30"
                            Padding="10,0"
                            CornerRadius="15"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.ScheduleToggle material|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ScheduleToggle TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ScheduleToggle:not(.active):pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}"/>
        </Style>

        <Style Selector="Button.ScheduleToggle:not(.active):pointerover material|MaterialIcon">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <Style Selector="Button.ScheduleToggle:not(.active):pointerover TextBlock">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- Active state: elevated card with accent outline and glowing text/icon -->
        <Style Selector="Button.ScheduleToggle.active /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BoxShadow" Value="0 1 4 0 #18000000, 0 0 0 0.5 #14000000"/>
        </Style>

        <Style Selector="Button.ScheduleToggle.active material|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.ScheduleToggle.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.ScheduleToggle.active:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        </Style>

</Styles>
