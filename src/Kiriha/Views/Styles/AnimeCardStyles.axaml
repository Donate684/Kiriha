<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- ═══ Card shell: soft, shadowed, with smooth hover lift ═══ -->
        <Style Selector="Border.AnimeCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillDefault}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="Border.FloatingMagCard">
            <Setter Property="BoxShadow" Value="{DynamicResource CardBoxShadow}"/>
        </Style>

        <!-- ═══ Reveal-on-scroll: карточка fade+slide-up при появлении в viewport ═══ -->
        <Style Selector="Border.revealItem">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translate(0,20px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.revealItem.shown">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(0,0)"/>
        </Style>

        <!-- Glass pill badges over poster -->
        <Style Selector="Border.Badge">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #66000000"/>
        </Style>

        <!-- Progress circle buttons -->
        <Style Selector="Button.ProgressStep">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ProgressStep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ProgressStepHoverBrush}"/>
        </Style>

        <!-- ═══ Minimal card: hover overlay slide-up ═══ -->
        <Style Selector="Border.MinimalCard Border.MinimalOverlay">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translate(0,16px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.MinimalCard:pointerover Border.MinimalOverlay">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(0,0)"/>
        </Style>

</Styles>
