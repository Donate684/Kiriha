<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kiriha.Views.Controls"
        xmlns:material="using:Material.Icons.Avalonia">

    <!-- ===== Tooltip & Flyout ===== -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#E61A1A1A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ===== OSD text & icon shadows ===== -->
    <Style Selector="TextBlock.overlay-text">
        <Setter Property="Effect">
            <DropShadowEffect Color="#D0000000" BlurRadius="4" OffsetX="0" OffsetY="1.5"/>
        </Setter>
    </Style>
    <Style Selector="TextBlock.overlay-secondary-text">
        <Setter Property="Effect">
            <DropShadowEffect Color="#D0000000" BlurRadius="3.5" OffsetX="0" OffsetY="1.2"/>
        </Setter>
    </Style>
    <Style Selector="material|MaterialIcon.overlay-icon">
        <Setter Property="Effect">
            <DropShadowEffect Color="#D0000000" BlurRadius="3" OffsetX="0" OffsetY="1.2"/>
        </Setter>
    </Style>

    <!-- ===== Control pill & time pill ===== -->
    <Style Selector="Border.control-pill">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Border.time-pill">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="6,0"/>
    </Style>

    <!-- ===== OSD panel ===== -->
    <Style Selector="Border.osd-panel">
        <Setter Property="Background" Value="#D0141414"/>
        <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="22,14"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="BoxShadow" Value="0 14 44 0 #80000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- ===== Player state panel ===== -->
    <Style Selector="Border.player-state-panel">
        <Setter Property="Background" Value="#E0121212"/>
        <Setter Property="BorderBrush" Value="#26FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="BoxShadow" Value="0 16 48 0 #A0000000"/>
    </Style>
    <Style Selector="Border.player-state-panel.error">
        <Setter Property="Background" Value="#E0141414"/>
        <Setter Property="BorderBrush" Value="#44FFD166"/>
    </Style>

    <!-- ===== OSD Inline Pill (Integrated in Header) ===== -->
    <Style Selector="Border.osd-inline-pill">
        <Setter Property="Background" Value="#60000000"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="BoxShadow" Value="0 2 8 0 #40000000"/>
    </Style>

    <!-- ===== OSD HUD Pill ===== -->
    <Style Selector="Border.osd-hud-pill">
        <Setter Property="Background" Value="#E00B0E14"/>
        <Setter Property="BorderBrush" Value="#3800D4FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BoxShadow" Value="0 8 28 0 #90000000, 0 0 16 0 #1800D4FF"/>
    </Style>

    <!-- ===== Stream HUD Deck (Under episode badge) ===== -->
    <Style Selector="Border.stream-hud-deck">
        <Setter Property="Background" Value="#E00B0E14"/>
        <Setter Property="BorderBrush" Value="#2BFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="BoxShadow" Value="0 16 40 0 #A0000000, 0 0 20 0 #1800D4FF"/>
    </Style>

    <!-- ===== ProgressBar ===== -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="Background" Value="#24FFFFFF"/>
    </Style>

</Styles>
