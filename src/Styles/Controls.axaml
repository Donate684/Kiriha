<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Global Pill RadioButton (reusable across views) ═══ -->
    <Style Selector="RadioButton.Pill">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.Pill">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="RadioButton.Pill:pointerover">
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="Background" Value="#08808080"/>
    </Style>
    <Style Selector="RadioButton.Pill:checked">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ═══ Window Transparency Fix (Avalonia 12) ═══ -->
    <Style Selector="Window">
        <Setter Property="TransparencyBackgroundFallback" Value="Transparent"/>
    </Style>

    <!-- ═══ Window Controls Alignment Fix (Avalonia 12) ═══ -->
    <Style Selector="WindowDrawnDecorations Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- ═══ Hide Fullscreen Button (Avalonia 12) ═══ -->
    <Style Selector="Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
    </Style>

    <!-- ═══ Windows 11 Fluent ScrollBar — Full Template Override ═══ -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <!-- ── Vertical ScrollBar Template ── -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="14"/>
        <Setter Property="MinWidth" Value="14"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <!-- Subtle track pill -->
                    <Border x:Name="TrackBg"
                            Background="{DynamicResource ScrollBarTrackFill}"
                            CornerRadius="100"
                            Width="4"
                            HorizontalAlignment="Center"
                            Margin="0,4"/>
                    <!-- Functional track -->
                    <Track x:Name="PART_Track"
                           IsDirectionReversed="True"
                           Orientation="Vertical"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Margin="0,4">
                        <Track.Thumb>
                            <Thumb x:Name="thumb"/>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Vertical track bg expand on hover -->
    <Style Selector="ScrollBar:vertical /template/ Border#TrackBg">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical:pointerover /template/ Border#TrackBg">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackFillHover}"/>
    </Style>

    <!-- ── Horizontal ScrollBar Template ── -->
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="14"/>
        <Setter Property="MinHeight" Value="14"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <!-- Subtle track pill -->
                    <Border x:Name="TrackBg"
                            Background="{DynamicResource ScrollBarTrackFill}"
                            CornerRadius="100"
                            Height="4"
                            VerticalAlignment="Center"
                            Margin="4,0"/>
                    <!-- Functional track -->
                    <Track x:Name="PART_Track"
                           Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Margin="4,0">
                        <Track.Thumb>
                            <Thumb x:Name="thumb"/>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Horizontal track bg expand on hover -->
    <Style Selector="ScrollBar:horizontal /template/ Border#TrackBg">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Height" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:horizontal:pointerover /template/ Border#TrackBg">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackFillHover}"/>
    </Style>

    <!-- ── Thumb visual (shared via custom template) ── -->
    <Style Selector="ScrollBar Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFill}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="100"/>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Vertical thumb sizing -->
    <Style Selector="ScrollBar:vertical Thumb">
        <Setter Property="Width" Value="4"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical:pointerover Thumb">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillHover}"/>
    </Style>
    <Style Selector="ScrollBar:vertical Thumb:pressed">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}"/>
    </Style>

    <!-- Horizontal thumb sizing -->
    <Style Selector="ScrollBar:horizontal Thumb">
        <Setter Property="Height" Value="4"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Height" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:horizontal:pointerover Thumb">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillHover}"/>
    </Style>
    <Style Selector="ScrollBar:horizontal Thumb:pressed">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}"/>
    </Style>
</Styles>
