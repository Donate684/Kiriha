<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmStartup="using:Kiriha.ViewModels.Startup"
        xmlns:vmDialogs="using:Kiriha.ViewModels.Dialogs"
        xmlns:vmNowPlaying="using:Kiriha.ViewModels.NowPlaying"
        xmlns:vmMain="using:Kiriha.ViewModels.Main"
             xmlns:vmSettings="using:Kiriha.ViewModels.Settings"
             xmlns:vm="using:Kiriha.ViewModels"
             xmlns:vmAnalytics="using:Kiriha.ViewModels.Analytics"
             xmlns:vmAnimeDetails="using:Kiriha.ViewModels.AnimeDetails"
             xmlns:vmAnimeList="using:Kiriha.ViewModels.AnimeList"
             xmlns:vmHistory="using:Kiriha.ViewModels.History"
             xmlns:vmPlayer="using:Kiriha.ViewModels.Player"
             xmlns:vmSeasonal="using:Kiriha.ViewModels.Seasonal"
             xmlns:vmTorrents="using:Kiriha.ViewModels.Torrents"
             xmlns:vmSearch="using:Kiriha.ViewModels.Search"
             xmlns:models="using:Kiriha.Models"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:conv="using:Kiriha.Views.Converters"
             x:Class="Kiriha.Views.Settings.SettingsPlayerPage"
             x:DataType="vmSettings:SettingsViewModel">
    <UserControl.Resources>
        <conv:LocConverter x:Key="LocConverter"/>
        <conv:IntEqualsConverter x:Key="IntEqualsConverter"/>
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter"/>
    </UserControl.Resources>
    <StackPanel>

                    <TextBlock Classes="PageTitle" Text="Плеер"/>

                    <Grid Classes="Row" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="Title" Text="Сделать Kiriha плеером по умолчанию"/>
                            <TextBlock Classes="Sub" Text="Открывать поддерживаемые видеофайлы через это приложение"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border IsVisible="{Binding Playback.IsSystemPlayer}" Padding="10,6" Background="#152ecc71" CornerRadius="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="CheckCircle" Width="12" Height="12" Foreground="#2ecc71"/>
                                    <TextBlock Text="Интегрировано" Foreground="#2ecc71" FontSize="11" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Интегрировать" Command="{Binding Playback.RegisterSystemPlayerCommand}" IsVisible="{Binding !Playback.IsSystemPlayer}" Padding="14,6" CornerRadius="6" FontSize="12" FontWeight="SemiBold" Background="{DynamicResource SystemAccentColor}" Foreground="White"/>
                            <Button Command="{Binding Playback.UnregisterSystemPlayerCommand}" IsVisible="{Binding Playback.IsSystemPlayer}" Padding="8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondary}" BorderThickness="0" ToolTip.Tip="Удалить интеграцию">
                                <material:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="#ff5555"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Classes="Row" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="Title" Text="Держать плеер в фоне"/>
                            <TextBlock Classes="Sub" Text="Заранее запускать отдельный процесс плеера, чтобы видео открывалось быстрее"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Playback.KeepPlayerProcessAlive}" OnContent="{DynamicResource l.common.status.on}" OffContent="{DynamicResource l.common.status.off}"/>
                    </Grid>
                    <Grid Classes="Row" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="Title" Text="Одно окно плеера"/>
                            <TextBlock Classes="Sub" Text="При открытии нового видео заменять файл в уже открытом окне"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Playback.SinglePlayerWindow}" OnContent="{DynamicResource l.common.status.on}" OffContent="{DynamicResource l.common.status.off}"/>
                    </Grid>
                    <Border Classes="Divider"/>
                    <TextBlock Classes="Title" Text="mpv video pipeline" Margin="0,18,0,4"/>
                    <TextBlock Classes="Sub" Text="These values are passed to mpv before startup. Reopen the player window after changing vo, gpu-api, or gpu-context." Margin="0,0,0,8"/>
                    <Grid Classes="Row" ColumnDefinitions="*,180">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="Title" Text="hwdec"/>
                            <TextBlock Classes="Sub" Text="Hardware video decoding: auto, auto-copy, d3d11va, nvdec, vulkan, no"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Playback.MpvHwdec}" VerticalAlignment="Center" PlaceholderText="auto"/>
                    </Grid>
                    <Grid Classes="Row" ColumnDefinitions="*,180">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="Title" Text="vo"/>
                            <TextBlock Classes="Sub" Text="Video output driver: gpu-next, gpu, d3d11, vulkan, opengl"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Playback.MpvVideoOutput}" VerticalAlignment="Center" PlaceholderText="gpu-next"/>
                    </Grid>
                    <Grid Classes="Row" ColumnDefinitions="*,180">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="Title" Text="gpu-api"/>
                            <TextBlock Classes="Sub" Text="Graphics API priority: auto, d3d11, vulkan, opengl"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Playback.MpvGpuApi}" VerticalAlignment="Center" PlaceholderText="auto"/>
                    </Grid>
                    <Grid Classes="Row" ColumnDefinitions="*,180">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="Title" Text="gpu-context"/>
                            <TextBlock Classes="Sub" Text="Windowing/GPU context: auto, d3d11, win, angle, x11, wayland, cocoa"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Playback.MpvGpuContext}" VerticalAlignment="Center" PlaceholderText="auto"/>
                    </Grid>
</StackPanel>
</UserControl>

