<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmPlayer="using:Kiriha.ViewModels.Player"
             xmlns:mpv="clr-namespace:Kiriha.Core.Mpv"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:conv="using:Kiriha.Views.Converters"
             x:Class="Kiriha.Views.Player.Controls.PlayerSettingsOverlay"
             x:DataType="vmPlayer:PlayerViewModel"
             xmlns:settings="using:Kiriha.Views.Player.Controls.Settings">
        <Border Name="SettingsOverlayBackdrop"
                IsVisible="False"
                Background="#33000000"
                PointerPressed="OnSettingsBackdropPointerPressed">
            <Border Name="SettingsOverlayPanel"
                    Width="760"
                    MaxWidth="760"
                    MaxHeight="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Background="#F01A1A1A"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="True"
                    PointerPressed="OnSettingsPanelPointerPressed">
                <Grid ColumnDefinitions="196,*">
                    <Border Grid.Column="0"
                            Background="#18000000"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="0,0,1,0"
                            Padding="0,12">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="18,8,12,14">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ÃÅ¸ÃÂ»ÃÂµÃÂµÃ‘â‚¬"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="ÃÂÃÂ°Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ¹ÃÂºÃÂ¸"
                                               Foreground="#80FFFFFF"
                                               FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <ListBox Name="CenteredPlayerSettingsNav"
                                     Classes="player-settings-nav"
                                     SelectedIndex="0">
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <material:MaterialIcon Kind="PlayCircleOutline" Width="17" Height="17" Foreground="White"/>
                                        <TextBlock Text="Ãâ€™ÃÂ¾Ã‘ÂÃÂ¿Ã‘â‚¬ÃÂ¾ÃÂ¸ÃÂ·ÃÂ²ÃÂµÃÂ´ÃÂµÃÂ½ÃÂ¸ÃÂµ" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <material:MaterialIcon Kind="VolumeHigh" Width="17" Height="17" Foreground="White"/>
                                        <TextBlock Text="Ãâ€”ÃÂ²Ã‘Æ’ÃÂº" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <material:MaterialIcon Kind="ViewDashboardOutline" Width="17" Height="17" Foreground="White"/>
                                        <TextBlock Text="ÃËœÃÂ½Ã‘â€šÃÂµÃ‘â‚¬Ã‘â€žÃÂµÃÂ¹Ã‘Â" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <material:MaterialIcon Kind="SubtitlesOutline" Width="17" Height="17" Foreground="White"/>
                                        <TextBlock Text="Ãâ€ÃÂ¾Ã‘â‚¬ÃÂ¾ÃÂ¶ÃÂºÃÂ¸" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <material:MaterialIcon Kind="Tune" Width="17" Height="17" Foreground="White"/>
                                        <TextBlock Text="ÃÂ ÃÂ°Ã‘ÂÃ‘Ë†ÃÂ¸Ã‘â‚¬ÃÂµÃÂ½ÃÂ½Ã‘â€¹ÃÂµ" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  Padding="24,22"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <settings:PlayerPlaybackSettings IsVisible="{Binding ElementName=CenteredPlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                            <settings:PlayerAudioSettings IsVisible="{Binding ElementName=CenteredPlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>
                            <settings:PlayerInterfaceSettings IsVisible="{Binding ElementName=CenteredPlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"/>
                            <settings:PlayerTrackSettings IsVisible="{Binding ElementName=CenteredPlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"/>
                            <settings:PlayerAdvancedSettings IsVisible="{Binding ElementName=CenteredPlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}"/>
                        </Panel>
                    </ScrollViewer>
                    <Button Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Classes="icon-btn"
                            Padding="8"
                            Margin="0,14,18,0"
                            Click="OnSettingsCloseClick">
                        <material:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>
        </Border>
</UserControl>

