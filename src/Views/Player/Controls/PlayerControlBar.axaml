<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmPlayer="using:Kiriha.ViewModels.Player"
             xmlns:mpv="clr-namespace:Kiriha.Core.Mpv"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:conv="using:Kiriha.Views.Converters"
             x:Class="Kiriha.Views.Player.Controls.PlayerControlBar"
             x:DataType="vmPlayer:PlayerViewModel"
             xmlns:controls="using:Kiriha.Views.Player.Controls"
             xmlns:settings="using:Kiriha.Views.Player.Controls.Settings">
                <Grid Margin="14,0,14,8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">

                    <!-- Play/Pause -->
                    <Border Grid.Column="0" Classes="control-pill" Padding="2,0">
                        <controls:PlayerPlaybackButtons />
                    </Border>

                    <!-- Skip controls -->
                    <Border Grid.Column="1" Classes="control-pill" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button Classes="icon-btn"
                                Command="{Binding SkipCommand}"
                                CommandParameter="-10"
                                IsVisible="{Binding ShowSkipButtons}"
                                ToolTip.Tip="ÃÂÃÂ°ÃÂ·ÃÂ°ÃÂ´ 10 Ã‘ÂÃÂµÃÂºÃ‘Æ’ÃÂ½ÃÂ´">
                            <material:MaterialIcon Kind="Rewind10" Width="21" Height="21" Foreground="White"/>
                        </Button>
                        <Button Classes="icon-btn"
                                Command="{Binding SkipCommand}"
                                CommandParameter="10"
                                IsVisible="{Binding ShowSkipButtons}"
                                ToolTip.Tip="Ãâ€™ÃÂ¿ÃÂµÃ‘â‚¬ÃÂµÃÂ´ 10 Ã‘ÂÃÂµÃÂºÃ‘Æ’ÃÂ½ÃÂ´">
                            <material:MaterialIcon Kind="FastForward10" Width="21" Height="21" Foreground="White"/>
                        </Button>
                    </StackPanel>
                    </Border>

                    <!-- Volume -->
                    <Border Grid.Column="2" Classes="control-pill" Margin="4,0,0,0">
                        <controls:PlayerVolumeControl />
                    </Border>

                    <!-- Time display -->
                    <Border Grid.Column="3" Classes="control-pill time-pill" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding ShowTimeDisplay}">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="overlay-text"
                                       Text="{Binding CurrentTimeString}"
                                       Foreground="#F0FFFFFF" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas,Courier New,monospace"/>
                            <TextBlock Classes="overlay-secondary-text" Text="/" Foreground="#80FFFFFF" FontSize="12.5" FontWeight="Medium"/>
                            <TextBlock Classes="overlay-secondary-text"
                                       Text="{Binding DurationString}"
                                       Foreground="#B0FFFFFF" FontSize="12.5" FontWeight="SemiBold" FontFamily="Consolas,Courier New,monospace"/>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT: speed + subtitles + audio + settings -->
                    <Border Grid.Column="4" Classes="control-pill" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="0"
                                VerticalAlignment="Center">

                        <!-- Playback speed -->
                        <Button Name="SpeedButton"
                                Classes="icon-btn"
                                IsVisible="{Binding ShowSpeedButton}"
                                ToolTip.Tip="ÃÂ¡ÃÂºÃÂ¾Ã‘â‚¬ÃÂ¾Ã‘ÂÃ‘â€šÃ‘Å’">
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuItem Header="0.25Ãƒâ€”" Classes="speed-item"
                                              Command="{Binding SetSpeedCommand}" CommandParameter="0.25"/>
                                    <MenuItem Header="0.5Ãƒâ€”"  Classes="speed-item"
                                              Command="{Binding SetSpeedCommand}" CommandParameter="0.5"/>
                                    <MenuItem Header="0.75Ãƒâ€”" Classes="speed-item"
                                              Command="{Binding SetSpeedCommand}" CommandParameter="0.75"/>
                                    <MenuItem Header="1Ãƒâ€”" Classes="speed-item"
                                              Command="{Binding SetSpeedCommand}" CommandParameter="1"/>
                                    <MenuItem Header="1.25Ãƒâ€”" Classes="speed-item"
                                              Command="{Binding SetSpeedCommand}" CommandParameter="1.25"/>
                                    <MenuItem Header="1.5Ãƒâ€”"  Classes="speed-item"
                                              Command="{Binding SetSpeedCommand}" CommandParameter="1.5"/>
                                    <MenuItem Header="1.75Ãƒâ€”" Classes="speed-item"
                                              Command="{Binding SetSpeedCommand}" CommandParameter="1.75"/>
                                    <MenuItem Header="2Ãƒâ€”"    Classes="speed-item"
                                              Command="{Binding SetSpeedCommand}" CommandParameter="2"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="SpeedometerMedium" Width="18" Height="18" Foreground="White"/>
                                <TextBlock Text="{Binding PlaybackSpeed, StringFormat='{}{0}Ãƒâ€”'}"
                                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Subtitles -->
                        <Button Name="SubtitleButton"
                                Classes="icon-btn"
                                IsVisible="{Binding ShowSubtitleButton}"
                                ToolTip.Tip="ÃÂ¡Ã‘Æ’ÃÂ±Ã‘â€šÃÂ¸Ã‘â€šÃ‘â‚¬Ã‘â€¹ (V)">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Border Width="240"
                                            MaxHeight="330"
                                            CornerRadius="14"
                                            Background="#E6181818"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Padding="6">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="mpv:TrackInfo">
                                                        <Button Classes="track-menu-item"
                                                                Click="OnTrackMenuItemClick">
                                                            <Grid ColumnDefinitions="20,*">
                                                                <material:MaterialIcon Grid.Column="0"
                                                                                       Kind="Check"
                                                                                       Width="14"
                                                                                       Height="14"
                                                                                       Foreground="White"
                                                                                       VerticalAlignment="Center"
                                                                                       IsVisible="{Binding Selected}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DisplayName}"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <material:MaterialIcon Kind="SubtitlesOutline" Width="21" Height="21" Foreground="White"/>
                        </Button>

                        <!-- Audio tracks -->
                        <Button Name="AudioButton"
                                Classes="icon-btn"
                                IsVisible="{Binding ShowAudioButton}"
                                ToolTip.Tip="ÃÂÃ‘Æ’ÃÂ´ÃÂ¸ÃÂ¾ÃÂ´ÃÂ¾Ã‘â‚¬ÃÂ¾ÃÂ¶ÃÂºÃÂ° (A)">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Border Width="240"
                                            MaxHeight="330"
                                            CornerRadius="14"
                                            Background="#E6181818"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1"
                                            Padding="6">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AudioTracks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="mpv:TrackInfo">
                                                        <Button Classes="track-menu-item"
                                                                Click="OnTrackMenuItemClick">
                                                            <Grid ColumnDefinitions="20,*">
                                                                <material:MaterialIcon Grid.Column="0"
                                                                                       Kind="Check"
                                                                                       Width="14"
                                                                                       Height="14"
                                                                                       Foreground="White"
                                                                                       VerticalAlignment="Center"
                                                                                       IsVisible="{Binding Selected}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DisplayName}"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <material:MaterialIcon Kind="MusicNote" Width="21" Height="21" Foreground="White"/>
                        </Button>

                        <!-- Subtitle position -->
                        <Button Name="SubtitlePositionButton"
                                Classes="icon-btn"
                                ToolTip.Tip="Ãâ€ºÃÅ¡ÃÅ“: Ã‘ÂÃ‘Æ’ÃÂ±Ã‘â€šÃÂ¸Ã‘â€šÃ‘â‚¬Ã‘â€¹ ÃÂ²Ã‘â€¹Ã‘Ë†ÃÂµ. ÃÅ¸ÃÅ¡ÃÅ“: ÃÂ½ÃÂ¸ÃÂ¶ÃÂµ"
                                IsVisible="{Binding ShowSubtitlePositionButton}">
                            <material:MaterialIcon Kind="FormatLineSpacing" Width="21" Height="21" Foreground="White"/>
                        </Button>

                        <!-- Subtitle style override -->
                        <Button Classes="icon-btn"
                                ToolTip.Tip="ÃÂ¡Ã‘â€šÃÂ¸ÃÂ»Ã‘Å’ Ã‘ÂÃ‘Æ’ÃÂ±Ã‘â€šÃÂ¸Ã‘â€šÃ‘â‚¬ÃÂ¾ÃÂ² (U)"
                                Command="{Binding ToggleSubtitleStyleOverrideCommand}"
                                IsVisible="{Binding ShowSubtitleStyleButton}">
                            <material:MaterialIcon Kind="FormatPaint" Width="21" Height="21" Foreground="White"/>
                        </Button>

                        <!-- Screenshot -->
                            <Button Name="ScreenshotButton"
                                    Classes="icon-btn"
                                    ToolTip.Tip="ÃÂ¡ÃÂºÃ‘â‚¬ÃÂ¸ÃÂ½Ã‘Ë†ÃÂ¾Ã‘â€š"
                                    IsVisible="{Binding ShowScreenshotButton}">
                                <material:MaterialIcon Kind="CameraOutline" Width="21" Height="21" Foreground="White"/>
                            </Button>

                        <!-- Player settings -->
                        <Button Name="SettingsButton"
                                Classes="icon-btn"
                                Click="OnSettingsButtonClick"
                                ToolTip.Tip="ÃÂÃÂ°Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ¹ÃÂºÃÂ¸">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Border Width="620"
                                            MaxHeight="470"
                                            CornerRadius="14"
                                            Background="#E6181818"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="180,*">
                                            <Border Grid.Column="0"
                                                    Background="#18000000"
                                                    BorderBrush="#22FFFFFF"
                                                    BorderThickness="0,0,1,0"
                                                    Padding="0,10">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Top" Margin="16,6,16,10">
                                                        <TextBlock Text="ÃÅ¸ÃÂ»ÃÂµÃÂµÃ‘â‚¬"
                                                                   Foreground="White"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="ÃÂÃÂ°Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ¹ÃÂºÃÂ¸"
                                                                   Foreground="#80FFFFFF"
                                                                   FontSize="11"/>
                                                    </StackPanel>

                                                    <ListBox Name="PlayerSettingsNav"
                                                             Classes="player-settings-nav"
                                                             SelectedIndex="0">
                                                        <ListBoxItem>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <material:MaterialIcon Kind="PlayCircleOutline" Width="17" Height="17" Foreground="White"/>
                                                                <TextBlock Text="Ãâ€™ÃÂ¾Ã‘ÂÃÂ¿Ã‘â‚¬ÃÂ¾ÃÂ¸ÃÂ·ÃÂ²ÃÂµÃÂ´ÃÂµÃÂ½ÃÂ¸ÃÂµ" Foreground="White" FontSize="12"/>
                                                            </StackPanel>
                                                        </ListBoxItem>
                                                        <ListBoxItem>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <material:MaterialIcon Kind="VolumeHigh" Width="17" Height="17" Foreground="White"/>
                                                                <TextBlock Text="Ãâ€”ÃÂ²Ã‘Æ’ÃÂº" Foreground="White" FontSize="12"/>
                                                            </StackPanel>
                                                        </ListBoxItem>
                                                        <ListBoxItem>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <material:MaterialIcon Kind="ViewDashboardOutline" Width="17" Height="17" Foreground="White"/>
                                                                <TextBlock Text="ÃËœÃÂ½Ã‘â€šÃÂµÃ‘â‚¬Ã‘â€žÃÂµÃÂ¹Ã‘Â" Foreground="White" FontSize="12"/>
                                                            </StackPanel>
                                                        </ListBoxItem>
                                                        <ListBoxItem>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <material:MaterialIcon Kind="SubtitlesOutline" Width="17" Height="17" Foreground="White"/>
                                                                <TextBlock Text="Ãâ€ÃÂ¾Ã‘â‚¬ÃÂ¾ÃÂ¶ÃÂºÃÂ¸" Foreground="White" FontSize="12"/>
                                                            </StackPanel>
                                                        </ListBoxItem>
                                                        <ListBoxItem>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <material:MaterialIcon Kind="Tune" Width="17" Height="17" Foreground="White"/>
                                                                <TextBlock Text="ÃÂ ÃÂ°Ã‘ÂÃ‘Ë†ÃÂ¸Ã‘â‚¬ÃÂµÃÂ½ÃÂ½Ã‘â€¹ÃÂµ" Foreground="White" FontSize="12"/>
                                                            </StackPanel>
                                                        </ListBoxItem>
                                                    </ListBox>
                                                </DockPanel>
                                            </Border>

                                            <ScrollViewer Grid.Column="1" Padding="20,18" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <Panel>
                                                    <settings:PlayerPlaybackSettings IsVisible="{Binding ElementName=PlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}"/>
                                                    <settings:PlayerAudioSettings IsVisible="{Binding ElementName=PlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}"/>
                                                    <settings:PlayerInterfaceSettings IsVisible="{Binding ElementName=PlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"/>
                                                    <settings:PlayerTrackSettings IsVisible="{Binding ElementName=PlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}"/>
                                                    <settings:PlayerAdvancedSettings IsVisible="{Binding ElementName=PlayerSettingsNav, Path=SelectedIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}"/>
                                                </Panel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <material:MaterialIcon Kind="Cog" Width="22" Height="22" Foreground="White"/>
                        </Button>

                    </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
</UserControl>


